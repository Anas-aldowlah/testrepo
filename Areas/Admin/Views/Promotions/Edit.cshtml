@model YAGOT_2._0.Models.Admin.PromotionFormVM
@{
    ViewData["Title"] = "تعديل العرض الترويجي";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/products.css" asp-append-version="true" />
    <style nonce="@Context.Items["csp-nonce"]">
        .promo-card {
            background: rgba(18, 26, 38, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 24px;
        }
        .promo-card__title {
            color: #e3b65b;
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 18px;
            display: flex;
            align-items: center;
            gap: 8px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding-bottom: 10px;
        }
        .form-label {
            color: #cbd5e1;
            font-weight: 600;
            font-size: 0.9rem;
        }
        .form-control, .form-select {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #fff;
            border-radius: 8px;
            padding: 10px 14px;
        }
        .form-control:focus, .form-select:focus {
            background: rgba(255, 255, 255, 0.08);
            border-color: #e3b65b;
            color: #fff;
            box-shadow: 0 0 0 0.2rem rgba(227, 182, 91, 0.25);
        }
        .form-select option {
            background: #16202e;
            color: #fff;
        }
        .target-option-card {
            border: 2px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            padding: 14px 18px;
            cursor: pointer;
            transition: all 0.2s ease;
            background: rgba(255, 255, 255, 0.02);
        }
        .target-option-card:hover {
            border-color: rgba(227, 182, 91, 0.4);
            background: rgba(227, 182, 91, 0.05);
        }
        .target-option-card.active {
            border-color: #e3b65b;
            background: rgba(227, 182, 91, 0.12);
        }
        .picker-container {
            max-height: 320px;
            overflow-y: auto;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            background: rgba(0, 0, 0, 0.2);
            padding: 10px;
        }
        .picker-item {
            padding: 8px 12px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 6px;
            transition: background 0.2s ease;
        }
        .picker-item:hover {
            background: rgba(255, 255, 255, 0.05);
        }
        .picker-thumb {
            width: 36px;
            height: 36px;
            object-fit: cover;
            border-radius: 6px;
        }
        .banner-preview-img {
            max-height: 100px;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        .selected-chip {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            background: rgba(227, 182, 91, 0.12);
            border: 1px solid rgba(227, 182, 91, 0.35);
            border-radius: 8px;
            color: #fff;
            font-size: 0.85rem;
            transition: all 0.15s ease;
        }
        .selected-chip:hover {
            background: rgba(227, 182, 91, 0.2);
            border-color: #e3b65b;
        }
        .selected-chip .btn-remove-chip {
            background: transparent;
            border: none;
            color: #f87171;
            font-size: 1.1rem;
            line-height: 1;
            cursor: pointer;
            padding: 0 2px;
            display: flex;
            align-items: center;
        }
        .selected-chip .btn-remove-chip:hover {
            color: #ef4444;
        }
        /* ===== DEDICATED LUXURY PROMO MODAL ===== */
        .promo-modal .modal-content {
            background: #121a24 !important;
            border: 1px solid rgba(227, 182, 91, 0.4) !important;
            border-radius: 16px !important;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7) !important;
            color: #f8fafc !important;
            overflow: hidden;
        }
        .promo-modal .modal-header {
            background: #172130 !important;
            border-bottom: 1px solid rgba(227, 182, 91, 0.2) !important;
            padding: 18px 24px !important;
        }
        .promo-modal .modal-title {
            color: #e3b65b !important;
            font-size: 1.15rem !important;
            font-weight: 700 !important;
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 0 !important;
        }
        .promo-modal .modal-body {
            background: #0f1620 !important;
            padding: 20px 24px !important;
            color: #f8fafc !important;
        }
        .promo-modal .modal-footer {
            background: #172130 !important;
            border-top: 1px solid rgba(227, 182, 91, 0.2) !important;
            padding: 14px 24px !important;
        }

        /* Inputs in Modal */
        .promo-modal .modal-filter-input,
        .promo-modal .modal-filter-select {
            background: #1b2636 !important;
            border: 1px solid rgba(255, 255, 255, 0.15) !important;
            color: #ffffff !important;
            border-radius: 8px !important;
            font-size: 0.9rem !important;
            padding: 9px 14px !important;
        }
        .promo-modal .modal-filter-input:focus,
        .promo-modal .modal-filter-select:focus {
            border-color: #e3b65b !important;
            box-shadow: 0 0 0 0.2rem rgba(227, 182, 91, 0.25) !important;
            outline: none !important;
        }
        .promo-modal .modal-filter-select option {
            background: #172130 !important;
            color: #ffffff !important;
        }
        .promo-modal .modal-input-addon {
            background: #172130 !important;
            border: 1px solid rgba(255, 255, 255, 0.15) !important;
            color: #e3b65b !important;
            border-radius: 0 8px 8px 0 !important;
            padding: 0 14px !important;
        }

        /* Action Buttons */
        .promo-modal .btn-modal-action {
            background: rgba(255, 255, 255, 0.06) !important;
            border: 1px solid rgba(255, 255, 255, 0.15) !important;
            color: #cbd5e1 !important;
            font-size: 0.85rem !important;
            font-weight: 600 !important;
            padding: 6px 14px !important;
            border-radius: 6px !important;
            transition: all 0.2s ease;
        }
        .promo-modal .btn-modal-action:hover {
            background: rgba(227, 182, 91, 0.15) !important;
            border-color: #e3b65b !important;
            color: #e3b65b !important;
        }
        .promo-modal .modal-count-badge {
            background: #e3b65b !important;
            color: #0b0f14 !important;
            font-weight: 800 !important;
            font-size: 0.85rem !important;
            padding: 6px 14px !important;
            border-radius: 20px !important;
        }

        /* Modal Items Scroll Container */
        .promo-modal .modal-items-container {
            max-height: 390px;
            overflow-y: auto;
            overflow-x: hidden;
            padding-right: 4px;
        }

        /* Item Row */
        .promo-modal .modal-item-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 10px 14px;
            margin-bottom: 8px;
            background: #16202c !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            border-radius: 10px !important;
            transition: all 0.2s ease;
            cursor: pointer;
        }
        .promo-modal .modal-item-row:hover {
            background: #1c2938 !important;
            border-color: rgba(227, 182, 91, 0.4) !important;
            transform: translateY(-1px);
        }
        .promo-modal .modal-item-row.is-selected {
            background: rgba(227, 182, 91, 0.14) !important;
            border-color: #e3b65b !important;
            box-shadow: 0 0 12px rgba(227, 182, 91, 0.1) !important;
        }

        /* Strict Product Thumbnail Box (No Overflow) */
        .promo-modal .product-thumb-box {
            width: 46px !important;
            height: 46px !important;
            min-width: 46px !important;
            max-width: 46px !important;
            min-height: 46px !important;
            max-height: 46px !important;
            border-radius: 8px !important;
            overflow: hidden !important;
            flex-shrink: 0 !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            background: #0f1620 !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
        }
        .promo-modal .product-thumb-img {
            width: 100% !important;
            height: 100% !important;
            max-width: 46px !important;
            max-height: 46px !important;
            object-fit: cover !important;
            display: block !important;
        }

        /* Typography */
        .promo-modal .product-info-title {
            color: #ffffff !important;
            font-size: 0.95rem !important;
            font-weight: 700 !important;
            margin: 0 !important;
            line-height: 1.3 !important;
            cursor: pointer;
        }
        .promo-modal .product-info-category {
            color: #94a3b8 !important;
            font-size: 0.8rem !important;
            margin-top: 2px !important;
            display: block !important;
        }
        .promo-modal .product-price-badge {
            background: rgba(227, 182, 91, 0.15) !important;
            color: #e3b65b !important;
            border: 1px solid rgba(227, 182, 91, 0.3) !important;
            font-size: 0.85rem !important;
            font-weight: 700 !important;
            padding: 5px 10px !important;
            border-radius: 6px !important;
            white-space: nowrap !important;
        }

        /* Scrollbar */
        .promo-modal .modal-items-container::-webkit-scrollbar {
            width: 6px;
        }
        .promo-modal .modal-items-container::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.2);
            border-radius: 4px;
        }
        .promo-modal .modal-items-container::-webkit-scrollbar-thumb {
            background: rgba(227, 182, 91, 0.4);
            border-radius: 4px;
        }
        .promo-modal .modal-items-container::-webkit-scrollbar-thumb:hover {
            background: #e3b65b;
        }
    </style>
}

@section Breadcrumb {
    <span>/</span>
    <a asp-action="Index">العروض والخصومات</a>
    <span>/</span>
    <span>تعديل العرض</span>
}

<section class="yq-products-admin">
    <header class="yq-products-hero mb-4">
        <div class="yq-products-hero__content">
            <span class="yq-products-eyebrow">تعديل بيانات العرض</span>
            <h2>تعديل العرض: @Model.Title</h2>
            <p>قم بتحديث بيانات العرض، الشروط، النطاق المستهدف، أو فترة الصلاحية.</p>
        </div>
        <div class="yq-products-hero__actions">
            <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius: 8px;">
                <i class="bi bi-arrow-right me-1"></i> العودة للقائمة
            </a>
        </div>
    </header>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ExistingBanner" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <!-- 1. GENERAL INFORMATION -->
        <div class="promo-card">
            <h3 class="promo-card__title">
                <i class="bi bi-info-circle-fill"></i> البيانات الأساسية للعرض
            </h3>

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Title" class="form-label">عنوان العرض <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="BannerFile" class="form-label">تغيير صورة البانر (اختياري)</label>
                    <input asp-for="BannerFile" type="file" class="form-control" accept="image/*" />
                    <span asp-validation-for="BannerFile" class="text-danger small"></span>
                    @if (!string.IsNullOrEmpty(Model.ExistingBanner))
                    {
                        <div class="mt-2">
                            <small class="text-muted d-block mb-1">البانر الحالي:</small>
                            <img src="@Model.ExistingBanner" alt="Current Banner" class="banner-preview-img" />
                        </div>
                    }
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label">وصف العرض</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <!-- 2. PROMOTION TYPE & VALUES -->
        <div class="promo-card">
            <h3 class="promo-card__title">
                <svg xmlns="http://www.w3.org/2000/svg" width="1.1em" height="1.1em" fill="currentColor" viewBox="0 0 16 16" style="vertical-align: -0.15em;" aria-hidden="true">
                    <path d="M13.442 2.558a.625.625 0 0 1 0 .884l-10 10a.625.625 0 1 1-.884-.884l10-10a.625.625 0 0 1 .884 0M4.5 6a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3m0 1a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5m7 6a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3m0 1a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5"/>
                </svg> نوع العرض وقيمة الخصم
            </h3>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="PromotionType" class="form-label">نوع الخصم / العرض <span class="text-danger">*</span></label>
                    <select asp-for="PromotionType" class="form-select" id="promotionTypeSelect">
                        <option value="Percentage">خصم نسبة مئوية (%)</option>
                        <option value="FixedAmount">خصم مبلغ ثابت (@CurrencyDisplay.Symbol)</option>
                        <option value="BuyXGetY">اشتر X واحصل على Y مجاناً</option>
                        <option value="QuantityPrice">سعر خاص عند شراء كمية محددة</option>
                        <option value="SpendAmount">خصم عند الوصول لمبلغ شراء محدد</option>
                    </select>
                </div>

                <!-- Field: DiscountValue -->
                <div class="col-md-6" id="discountValueGroup">
                    <label asp-for="DiscountValue" class="form-label" id="discountValueLabel">قيمة الخصم <span class="text-danger">*</span></label>
                    <input asp-for="DiscountValue" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="DiscountValue" class="text-danger small"></span>
                </div>

                <!-- Field: MinimumAmount -->
                <div class="col-md-6 d-none" id="minimumAmountGroup">
                    <label asp-for="MinimumAmount" class="form-label">الحد الأدنى لمبلغ الشراء (@CurrencyDisplay.Symbol)</label>
                    <input asp-for="MinimumAmount" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="MinimumAmount" class="text-danger small"></span>
                </div>

                <div class="col-md-6 d-none" id="spendDiscountTypeGroup">
                    <label asp-for="SpendDiscountType" class="form-label">نوع خصم حد الشراء</label>
                    <select asp-for="SpendDiscountType" class="form-select">
                        <option value="FixedAmount">مبلغ ثابت (@CurrencyDisplay.Symbol)</option>
                        <option value="Percentage">نسبة مئوية (%)</option>
                    </select>
                </div>

                <!-- Field: BuyQuantity & FreeQuantity -->
                <div class="col-md-3 d-none" id="buyQtyGroup">
                    <label asp-for="BuyQuantity" class="form-label">الكمية المطلوبة (X)</label>
                    <input asp-for="BuyQuantity" class="form-control" type="number" />
                    <span asp-validation-for="BuyQuantity" class="text-danger small"></span>
                </div>
                <div class="col-md-3 d-none" id="freeQtyGroup">
                    <label asp-for="FreeQuantity" class="form-label">الكمية المجانية (Y)</label>
                    <input asp-for="FreeQuantity" class="form-control" type="number" />
                    <span asp-validation-for="FreeQuantity" class="text-danger small"></span>
                </div>

                <!-- Field: OfferPrice -->
                <div class="col-md-6 d-none" id="offerPriceGroup">
                    <label asp-for="OfferPrice" class="form-label">سعر العرض الإجمالي (@CurrencyDisplay.Symbol)</label>
                    <input asp-for="OfferPrice" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="OfferPrice" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <!-- 3. TARGETING SECTION -->
        <div class="promo-card">
            <h3 class="promo-card__title">
                <i class="bi bi-crosshair"></i> النطاق المستهدف للعرض
            </h3>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="target-option-card @(Model.TargetType == "All" ? "active" : "")" data-target="All">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="TargetType" value="All" id="targetAll" />
                            <label class="form-check-label fw-bold text-white cursor-pointer" for="targetAll">
                                🏪 المتجر بالكامل
                            </label>
                        </div>
                        <small class="text-muted d-block mt-1">يطبق العرض على كافة المنتجات والتصنيفات في المتجر.</small>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="target-option-card @(Model.TargetType == "Products" ? "active" : "")" data-target="Products">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="radio" asp-for="TargetType" value="Products" id="targetProducts" />
                                <label class="form-check-label fw-bold text-white cursor-pointer" for="targetProducts">
                                    📦 منتجات محدودة
                                </label>
                            </div>
                            <span class="badge fw-bold" id="targetProductsCardBadge" style="background: @(Model.SelectedProductIds?.Count > 0 ? "#e3b65b" : "rgba(255, 255, 255, 0.12)"); color: @(Model.SelectedProductIds?.Count > 0 ? "#0b0f14" : "#94a3b8");">@(Model.SelectedProductIds?.Count ?? 0) محدد</span>
                        </div>
                        <small class="text-muted d-block mt-1">حدد منتجات معينة من الكتالوج لتطبيق العرض عليها.</small>

                        <div class="mt-3 pt-2 border-top border-secondary border-opacity-25">
                            <button type="button" class="btn btn-sm btn-outline-warning w-100 d-flex align-items-center justify-content-center gap-2 py-2 fw-bold" id="btnOpenProductModal" data-bs-toggle="modal" data-bs-target="#productSelectModal">
                                <i class="bi bi-plus-circle-fill"></i>
                                <span>إضافة / اختيار المنتجات</span>
                                <span class="badge bg-warning text-dark ms-1 card-prod-count">@(Model.SelectedProductIds?.Count ?? 0)</span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="target-option-card @(Model.TargetType == "Categories" ? "active" : "")" data-target="Categories">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="radio" asp-for="TargetType" value="Categories" id="targetCategories" />
                                <label class="form-check-label fw-bold text-white cursor-pointer" for="targetCategories">
                                    🏷️ تصنيفات محدودة
                                </label>
                            </div>
                            <span class="badge fw-bold" id="targetCategoriesCardBadge" style="background: @(Model.SelectedCategoryIds?.Count > 0 ? "#e3b65b" : "rgba(255, 255, 255, 0.12)"); color: @(Model.SelectedCategoryIds?.Count > 0 ? "#0b0f14" : "#94a3b8");">@(Model.SelectedCategoryIds?.Count ?? 0) محدد</span>
                        </div>
                        <small class="text-muted d-block mt-1">يطبق العرض على جميع المنتجات التابعة لتصنيفات محددة.</small>

                        <div class="mt-3 pt-2 border-top border-secondary border-opacity-25">
                            <button type="button" class="btn btn-sm btn-outline-warning w-100 d-flex align-items-center justify-content-center gap-2 py-2 fw-bold" id="btnOpenCategoryModal" data-bs-toggle="modal" data-bs-target="#categorySelectModal">
                                <i class="bi bi-plus-circle-fill"></i>
                                <span>إضافة / اختيار التصنيفات</span>
                                <span class="badge bg-warning text-dark ms-1 card-cat-count">@(Model.SelectedCategoryIds?.Count ?? 0)</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <span asp-validation-for="SelectedProductIds" class="text-danger small d-block mb-2"></span>
            <span asp-validation-for="SelectedCategoryIds" class="text-danger small d-block mb-2"></span>

            <!-- PRODUCT TARGET SUMMARY PANEL -->
            <div id="productPickerContainer" class="d-none">
                <div class="p-3 rounded-3 mb-3" style="background: rgba(18, 26, 38, 0.95); border: 1px solid rgba(227, 182, 91, 0.35); box-shadow: 0 4px 20px rgba(0,0,0,0.25);">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pb-2 mb-3 border-bottom border-secondary border-opacity-25">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fs-5 text-warning"><i class="bi bi-box-seam-fill"></i></span>
                            <span class="fw-bold text-white">المنتجات المحددة للعرض:</span>
                            <span class="badge bg-warning text-dark fw-bold px-2 py-1" id="selectedProductCountBadge">0 محدد</span>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-warning fw-bold d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#productSelectModal" style="background:#e3b65b; color:#000;">
                                <i class="bi bi-plus-circle-fill"></i> إضافة / تعديل المنتجات
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger" id="deselectAllProductsBtn">
                                <i class="bi bi-trash"></i> مسح التحديد
                            </button>
                        </div>
                    </div>

                    <!-- Empty state when 0 products selected -->
                    <div id="productEmptyChipsState" class="text-center py-4 text-muted border border-dashed border-secondary border-opacity-25 rounded-2">
                        <i class="bi bi-inbox fs-2 d-block mb-2 opacity-50"></i>
                        <span>لم تقم بإضافة أي منتجات لهذا العرض بعد.</span>
                        <div class="mt-2">
                            <button type="button" class="btn btn-sm btn-outline-warning fw-bold px-3 py-1" data-bs-toggle="modal" data-bs-target="#productSelectModal">
                                <i class="bi bi-plus-lg me-1"></i> فتح نافذة اختيار المنتجات
                            </button>
                        </div>
                    </div>

                    <!-- Selected Products Chips Preview -->
                    <div id="selectedProductsChipsList" class="d-flex flex-wrap gap-2 d-none">
                        <!-- Populated by JS -->
                    </div>
                </div>
            </div>

            <!-- CATEGORY TARGET SUMMARY PANEL -->
            <div id="categoryPickerContainer" class="d-none">
