@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Currency Symbol
            const currencySymbol = "@CurrencyDisplay.Symbol";

            // 1. Dynamic Promotion Type Fields
            const typeSelect = document.getElementById("promotionTypeSelect");
            const discountGroup = document.getElementById("discountValueGroup");
            const discountLabel = document.getElementById("discountValueLabel");
            const minAmountGroup = document.getElementById("minimumAmountGroup");
            const buyQtyGroup = document.getElementById("buyQtyGroup");
            const freeQtyGroup = document.getElementById("freeQtyGroup");
            const offerPriceGroup = document.getElementById("offerPriceGroup");
            const offerPriceLabel = document.getElementById("offerPriceLabel");
            const spendDiscountTypeGroup = document.getElementById("spendDiscountTypeGroup");

            function updateTypeFields() {
                if (!typeSelect) return;
                const val = typeSelect.value;
                if (discountGroup) discountGroup.classList.add("d-none");
                if (minAmountGroup) minAmountGroup.classList.add("d-none");
                if (buyQtyGroup) buyQtyGroup.classList.add("d-none");
                if (freeQtyGroup) freeQtyGroup.classList.add("d-none");
                if (offerPriceGroup) offerPriceGroup.classList.add("d-none");
                if (spendDiscountTypeGroup) spendDiscountTypeGroup.classList.add("d-none");

                if (val === "Percentage") {
                    if (discountGroup) discountGroup.classList.remove("d-none");
                    if (discountLabel) discountLabel.innerHTML = 'نسبة الخصم (%) <span class="text-danger">*</span>';
                } else if (val === "FixedAmount") {
                    if (discountGroup) discountGroup.classList.remove("d-none");
                    if (discountLabel) discountLabel.innerHTML = `مبلغ الخصم (${currencySymbol}) <span class="text-danger">*</span>`;
                } else if (val === "BuyXGetY") {
                    if (buyQtyGroup) buyQtyGroup.classList.remove("d-none");
                    if (freeQtyGroup) freeQtyGroup.classList.remove("d-none");
                } else if (val === "QuantityPrice") {
                    if (buyQtyGroup) buyQtyGroup.classList.remove("d-none");
                    if (offerPriceGroup) offerPriceGroup.classList.remove("d-none");
                    if (offerPriceLabel) {
                        offerPriceLabel.innerHTML = `إجمالي سعر الباقة للكمية المحددة (${currencySymbol}) <span class="text-danger">*</span>`;
                    }
                } else if (val === "SpendAmount") {
                    if (minAmountGroup) minAmountGroup.classList.remove("d-none");
                    if (discountGroup) discountGroup.classList.remove("d-none");
                    if (spendDiscountTypeGroup) spendDiscountTypeGroup.classList.remove("d-none");
                    if (discountLabel) discountLabel.innerHTML = 'قيمة خصم حد الشراء <span class="text-danger">*</span>';
                }
            }

            if (typeSelect) {
                typeSelect.addEventListener("change", updateTypeFields);
                updateTypeFields();
            }

            // 2. Dynamic Target Scope Selection
            const targetRadioButtons = document.querySelectorAll('input[name="TargetType"]');
            const productPicker = document.getElementById("productPickerContainer");
            const categoryPicker = document.getElementById("categoryPickerContainer");
            const targetCards = document.querySelectorAll(".target-option-card");

            function updateTargetVisibility() {
                const checkedRadio = document.querySelector('input[name="TargetType"]:checked');
                const selectedVal = checkedRadio ? checkedRadio.value : "All";
                
                if (productPicker) productPicker.classList.add("d-none");
                if (categoryPicker) categoryPicker.classList.add("d-none");

                targetCards.forEach(card => {
                    if (card.dataset.target === selectedVal) {
                        card.classList.add("active");
                    } else {
                        card.classList.remove("active");
                    }
                });

                if (selectedVal === "Products" && productPicker) {
                    productPicker.classList.remove("d-none");
                } else if (selectedVal === "Categories" && categoryPicker) {
                    categoryPicker.classList.remove("d-none");
                }
            }

            function openModalIfZero(targetType) {
                if (targetType === "Products") {
                    const checked = document.querySelectorAll(".product-checkbox:checked").length;
                    if (checked === 0) {
                        const modalEl = document.getElementById("productSelectModal");
                        if (modalEl && typeof bootstrap !== "undefined") {
                            bootstrap.Modal.getOrCreateInstance(modalEl).show();
                        }
                    }
                } else if (targetType === "Categories") {
                    const checked = document.querySelectorAll(".category-checkbox:checked").length;
                    if (checked === 0) {
                        const modalEl = document.getElementById("categorySelectModal");
                        if (modalEl && typeof bootstrap !== "undefined") {
                            bootstrap.Modal.getOrCreateInstance(modalEl).show();
                        }
                    }
                }
            }

            targetRadioButtons.forEach(radio => radio.addEventListener("change", function () {
                updateTargetVisibility();
                if (this.checked) openModalIfZero(this.value);
            }));

            targetCards.forEach(card => {
                card.addEventListener("click", function (e) {
                    if (e.target.closest("button") || e.target.closest("input")) return;
                    const radio = this.querySelector('input[type="radio"]');
                    if (radio) {
                        radio.checked = true;
                        updateTargetVisibility();
                        openModalIfZero(radio.value);
                    }
                });
            });

            // Card button triggers
            const btnOpenProd = document.getElementById("btnOpenProductModal");
            if (btnOpenProd) {
                btnOpenProd.addEventListener("click", function () {
                    const r = document.getElementById("targetProducts");
                    if (r) { r.checked = true; updateTargetVisibility(); }
                });
            }
            const btnOpenCat = document.getElementById("btnOpenCategoryModal");
            if (btnOpenCat) {
                btnOpenCat.addEventListener("click", function () {
                    const r = document.getElementById("targetCategories");
                    if (r) { r.checked = true; updateTargetVisibility(); }
                });
            }

            // 3. Counter Badges, Checkboxes Sync & Chips Rendering
            const productCheckboxes = document.querySelectorAll(".product-checkbox");
            const categoryCheckboxes = document.querySelectorAll(".category-checkbox");
            
            const prodCountBadge = document.getElementById("selectedProductCountBadge");
            const catCountBadge = document.getElementById("selectedCategoryCountBadge");
            const targetProdCardBadge = document.getElementById("targetProductsCardBadge");
            const targetCatCardBadge = document.getElementById("targetCategoriesCardBadge");
            const cardProdCountText = document.querySelectorAll(".card-prod-count");
            const cardCatCountText = document.querySelectorAll(".card-cat-count");
            const modalProdBadge = document.getElementById("modalProductCountBadge");
            const modalCatBadge = document.getElementById("modalCategoryCountBadge");
            const modalSelectedProdSummary = document.getElementById("modalSelectedCountSummary");
            const modalSelectedCatSummary = document.getElementById("modalSelectedCategoryCountSummary");

            const prodChipsContainer = document.getElementById("selectedProductsChipsList");
            const catChipsContainer = document.getElementById("selectedCategoriesChipsList");
            const prodEmptyChipsState = document.getElementById("productEmptyChipsState");
            const catEmptyChipsState = document.getElementById("categoryEmptyChipsState");

            function updateProductUI() {
                const checkedBoxes = Array.from(document.querySelectorAll(".product-checkbox:checked"));
                const count = checkedBoxes.length;

                if (prodCountBadge) prodCountBadge.textContent = `${count} محدد`;
                if (targetProdCardBadge) {
                    targetProdCardBadge.textContent = `${count} محدد`;
                    if (count > 0) {
                        targetProdCardBadge.style.background = "#e3b65b";
                        targetProdCardBadge.style.color = "#0b0f14";
                    } else {
                        targetProdCardBadge.style.background = "rgba(255, 255, 255, 0.12)";
                        targetProdCardBadge.style.color = "#94a3b8";
                    }
                }
                if (modalProdBadge) modalProdBadge.textContent = `${count} محدد`;
                if (modalSelectedProdSummary) modalSelectedProdSummary.textContent = count;
                cardProdCountText.forEach(el => el.textContent = count);

                // Row highlighting
                document.querySelectorAll(".product-item-row").forEach(row => {
                    const cb = row.querySelector(".product-checkbox");
                    row.classList.toggle("is-selected", cb && cb.checked);
                });

                // Render Chips
                if (prodChipsContainer) {
                    prodChipsContainer.innerHTML = "";
                    if (count === 0) {
                        if (prodEmptyChipsState) prodEmptyChipsState.classList.remove("d-none");
                        prodChipsContainer.classList.add("d-none");
                    } else {
                        if (prodEmptyChipsState) prodEmptyChipsState.classList.add("d-none");
                        prodChipsContainer.classList.remove("d-none");

                        checkedBoxes.forEach(cb => {
                            const row = cb.closest(".product-item-row");
                            if (!row) return;
                            const id = row.dataset.id;
                            const name = row.dataset.displayName || "";
                            const price = row.dataset.price || "";
                            const img = row.dataset.img || "";

                            const chip = document.createElement("div");
                            chip.className = "selected-chip";
                            chip.innerHTML = `
                                ${img ? `<div class="product-thumb-box" style="width:26px !important; height:26px !important; min-width:26px !important; max-width:26px !important; min-height:26px !important; max-height:26px !important; border-radius:4px !important; overflow:hidden !important; flex-shrink:0 !important;"><img src="${img}" class="product-thumb-img" alt="${name}" /></div>` : `<i class="bi bi-box text-warning"></i>`}
                                <span class="fw-bold">${name}</span>
                                <span class="text-warning small">(${price} ${currencySymbol})</span>
                                <button type="button" class="btn-remove-chip" data-remove-id="${id}" title="إلغاء هذا المنتج">
                                    <i class="bi bi-x-circle-fill"></i>
                                </button>
                            `;
                            prodChipsContainer.appendChild(chip);
                        });
                    }
                }
            }

            function updateCategoryUI() {
                const checkedBoxes = Array.from(document.querySelectorAll(".category-checkbox:checked"));
                const count = checkedBoxes.length;

                if (catCountBadge) catCountBadge.textContent = `${count} محدد`;
                if (targetCatCardBadge) {
                    targetCatCardBadge.textContent = `${count} محدد`;
                    if (count > 0) {
                        targetCatCardBadge.style.background = "#e3b65b";
                        targetCatCardBadge.style.color = "#0b0f14";
                    } else {
                        targetCatCardBadge.style.background = "rgba(255, 255, 255, 0.12)";
                        targetCatCardBadge.style.color = "#94a3b8";
                    }
                }
                if (modalCatBadge) modalCatBadge.textContent = `${count} محدد`;
                if (modalSelectedCatSummary) modalSelectedCatSummary.textContent = count;
                cardCatCountText.forEach(el => el.textContent = count);

                // Row highlighting
                document.querySelectorAll(".category-item-row").forEach(row => {
                    const cb = row.querySelector(".category-checkbox");
                    row.classList.toggle("is-selected", cb && cb.checked);
                });

                // Render Chips
                if (catChipsContainer) {
                    catChipsContainer.innerHTML = "";
                    if (count === 0) {
                        if (catEmptyChipsState) catEmptyChipsState.classList.remove("d-none");
                        catChipsContainer.classList.add("d-none");
                    } else {
                        if (catEmptyChipsState) catEmptyChipsState.classList.add("d-none");
                        catChipsContainer.classList.remove("d-none");

                        checkedBoxes.forEach(cb => {
                            const row = cb.closest(".category-item-row");
                            if (!row) return;
                            const id = row.dataset.id;
                            const name = row.dataset.displayName || "";
                            const img = row.dataset.img || "";

                            const chip = document.createElement("div");
                            chip.className = "selected-chip";
                            const tagSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#e3b65b" viewBox="0 0 16 16"><path d="M2 2a1 1 0 0 1 1-1h4.586a1 1 0 0 1 .707.293l7 7a1 1 0 0 1 0 1.414l-4.586 4.586a1 1 0 0 1-1.414 0l-7-7A1 1 0 0 1 2 6.586V2zm3.5 4a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"/><path d="M1.293 7.707A1 1 0 0 1 1 7V2.5A1.5 1.5 0 0 1 2.5 1H7a1 1 0 0 1 .707.293l7 7a1 1 0 0 1 0 1.414l-4.586 4.586a1 1 0 0 1-1.414 0l-7-7z"/></svg>`;
                            const thumbHtml = img 
                                ? `<div class="product-thumb-box" style="width:26px !important; height:26px !important; min-width:26px !important; max-width:26px !important; min-height:26px !important; max-height:26px !important; border-radius:4px !important; overflow:hidden !important; flex-shrink:0 !important;"><img src="${img}" class="product-thumb-img" alt="${name}" /></div>`
                                : tagSvg;

                            chip.innerHTML = `
                                ${thumbHtml}
                                <span class="fw-bold">${name}</span>
                                <button type="button" class="btn-remove-chip" data-remove-cat-id="${id}" title="إلغاء هذا التصنيف">
                                    <i class="bi bi-x-circle-fill"></i>
                                </button>
                            `;
                            catChipsContainer.appendChild(chip);
                        });
                    }
                }
            }

            // Direct and delegated change listeners
            productCheckboxes.forEach(cb => cb.addEventListener("change", updateProductUI));
            categoryCheckboxes.forEach(cb => cb.addEventListener("change", updateCategoryUI));

            document.addEventListener("change", function (e) {
                if (e.target && e.target.classList.contains("product-checkbox")) {
                    updateProductUI();
                } else if (e.target && e.target.classList.contains("category-checkbox")) {
                    updateCategoryUI();
                }
            });

            // Modal hide synchronization
            const prodModalEl = document.getElementById("productSelectModal");
            if (prodModalEl) {
                prodModalEl.addEventListener("hidden.bs.modal", updateProductUI);
            }
            const catModalEl = document.getElementById("categorySelectModal");
            if (catModalEl) {
                catModalEl.addEventListener("hidden.bs.modal", updateCategoryUI);
            }

            // Chips remove clicks (delegated)
            if (prodChipsContainer) {
                prodChipsContainer.addEventListener("click", function (e) {
                    const btn = e.target.closest("[data-remove-id]");
                    if (btn) {
                        const id = btn.dataset.removeId;
                        const cb = document.getElementById(`prod_${id}`);
                        if (cb) {
                            cb.checked = false;
                            updateProductUI();
                        }
                    }
                });
            }

            if (catChipsContainer) {
                catChipsContainer.addEventListener("click", function (e) {
                    const btn = e.target.closest("[data-remove-cat-id]");
                    if (btn) {
                        const id = btn.dataset.removeCatId;
                        const cb = document.getElementById(`cat_${id}`);
                        if (cb) {
                            cb.checked = false;
                            updateCategoryUI();
                        }
                    }
                });
            }

            // Universal modal item click delegation (handles checkbox, label, thumb, badge, row)
            document.addEventListener("click", function (e) {
                const row = e.target.closest(".modal-item-row");
                if (!row) return;

                const cb = row.querySelector(".product-checkbox, .category-checkbox");
                if (!cb) return;

                // Native toggle on checkbox or label
                if (e.target === cb || e.target.tagName.toLowerCase() === "label" || e.target.closest("label")) {
                    setTimeout(() => {
                        if (cb.classList.contains("product-checkbox")) updateProductUI();
                        if (cb.classList.contains("category-checkbox")) updateCategoryUI();
                    }, 0);
                    return;
                }

                // Clicked anywhere else on the row (image, text, badge, padding)
                e.preventDefault();
                cb.checked = !cb.checked;
                cb.dispatchEvent(new Event("change", { bubbles: true }));
                if (cb.classList.contains("product-checkbox")) updateProductUI();
                if (cb.classList.contains("category-checkbox")) updateCategoryUI();
            });

            // Deselect All / Clear Buttons
            const deselectAllProdBtn = document.getElementById("deselectAllProductsBtn");
            const modalDeselectAllProdBtn = document.getElementById("modalDeselectAllProducts");
            function clearAllProducts() {
                productCheckboxes.forEach(cb => cb.checked = false);
                updateProductUI();
            }
            if (deselectAllProdBtn) deselectAllProdBtn.addEventListener("click", clearAllProducts);
            if (modalDeselectAllProdBtn) modalDeselectAllProdBtn.addEventListener("click", clearAllProducts);

            const deselectAllCatBtn = document.getElementById("deselectAllCategoriesBtn");
            const modalDeselectAllCatBtn = document.getElementById("modalDeselectAllCategories");
            function clearAllCategories() {
                categoryCheckboxes.forEach(cb => cb.checked = false);
                updateCategoryUI();
            }
            if (deselectAllCatBtn) deselectAllCatBtn.addEventListener("click", clearAllCategories);
            if (modalDeselectAllCatBtn) modalDeselectAllCatBtn.addEventListener("click", clearAllCategories);

            // Select All Visible Products in Modal
            const modalSelectAllProd = document.getElementById("modalSelectAllProducts");
            if (modalSelectAllProd) {
                modalSelectAllProd.addEventListener("click", function () {
                    document.querySelectorAll(".product-item-row").forEach(row => {
                        if (row.style.display !== "none") {
                            const cb = row.querySelector(".product-checkbox");
                            if (cb) cb.checked = true;
                        }
                    });
                    updateProductUI();
                });
            }

            // Select All Visible Categories in Modal
            const modalSelectAllCat = document.getElementById("modalSelectAllCategories");
            if (modalSelectAllCat) {
                modalSelectAllCat.addEventListener("click", function () {
                    document.querySelectorAll(".category-item-row").forEach(row => {
                        if (row.style.display !== "none") {
                            const cb = row.querySelector(".category-checkbox");
                            if (cb) cb.checked = true;
                        }
                    });
                    updateCategoryUI();
                });
            }

            // Live Search & Category Filter for Products
            const modalProdSearch = document.getElementById("modalProductSearch");
            const modalCatFilter = document.getElementById("modalCategoryFilter");
            const modalProdEmptyState = document.getElementById("modalProductEmptyState");

            function filterModalProducts() {
                const query = (modalProdSearch ? modalProdSearch.value : "").toLowerCase().trim();
                const cat = (modalCatFilter ? modalCatFilter.value : "").toLowerCase().trim();
                let visibleCount = 0;

                document.querySelectorAll(".product-item-row").forEach(row => {
                    const name = row.dataset.name || "";
                    const rowCat = row.dataset.cat || "";
                    const matchesName = name.includes(query);
                    const matchesCat = !cat || rowCat.includes(cat);
                    const visible = matchesName && matchesCat;
                    row.style.display = visible ? "flex" : "none";
                    if (visible) visibleCount++;
                });

                if (modalProdEmptyState) {
                    modalProdEmptyState.classList.toggle("d-none", visibleCount > 0);
                }
            }

            if (modalProdSearch) {
                modalProdSearch.addEventListener("input", filterModalProducts);
                modalProdSearch.addEventListener("keydown", function (e) {
                    if (e.key === "Enter") e.preventDefault();
                });
            }
            if (modalCatFilter) modalCatFilter.addEventListener("change", filterModalProducts);

            // Live Search for Categories
            const modalCatSearch = document.getElementById("modalCategorySearch");
            const modalCatEmptyState = document.getElementById("modalCategoryEmptyState");

            function filterModalCategories() {
                const query = (modalCatSearch ? modalCatSearch.value : "").toLowerCase().trim();
                let visibleCount = 0;

                document.querySelectorAll(".category-item-row").forEach(row => {
                    const name = row.dataset.name || "";
                    const visible = name.includes(query);
                    row.style.display = visible ? "flex" : "none";
                    if (visible) visibleCount++;
                });

                if (modalCatEmptyState) {
                    modalCatEmptyState.classList.toggle("d-none", visibleCount > 0);
                }
            }

            if (modalCatSearch) {
                modalCatSearch.addEventListener("input", filterModalCategories);
                modalCatSearch.addEventListener("keydown", function (e) {
                    if (e.key === "Enter") e.preventDefault();
                });
            }

            // Initial Execution
            updateTargetVisibility();
            updateProductUI();
            updateCategoryUI();
        });
    </script>
}
