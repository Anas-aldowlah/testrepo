@model YAGOT_2._0.Models.Admin.PromotionListViewModel
@{
    ViewData["Title"] = "العروض والخصومات";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/products.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/promotions.css" asp-append-version="true" />
}

@section Breadcrumb {
    <span>/</span>
    <span>العروض والخصومات</span>
}

<section class="yq-products-admin" aria-labelledby="promotionsIndexTitle">
    <!-- HERO HEADER -->
    <header class="yq-products-hero">
        <div class="yq-products-hero__content">
            <span class="yq-products-eyebrow">إدارة التسويق</span>
            <h2 id="promotionsIndexTitle">العروض والخصومات</h2>
            <p>أنشئ وادر العروض الترويجية والخصومات، وحدد المنتجات والتصنيفات المستهدفة وفترات الصلاحية.</p>
        </div>

        <div class="yq-products-hero__actions">
            <a asp-action="Create" class="btn-yaqut-gold">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                <span>إضافة عرض جديد</span>
            </a>
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #34d399; border-radius: 10px;">
            <i class="bi bi-check-circle-fill me-2 text-success"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- DASHBOARD SUMMARY CARDS -->
    <section class="yq-products-summary mb-4" aria-label="ملخص العروض">
        <article class="yq-products-stat">
            <span class="yq-products-stat__icon" style="background: rgba(227, 182, 91, 0.15); color: #d97706;">
                <i class="bi bi-tags-fill"></i>
            </span>
            <div>
                <p>إجمالي العروض</p>
                <strong>@Model.TotalPromotions</strong>
            </div>
        </article>

        <article class="yq-products-stat">
            <span class="yq-products-stat__icon" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">
                <i class="bi bi-check-circle-fill"></i>
            </span>
            <div>
                <p>العروض النشطة</p>
                <strong>@Model.ActivePromotions</strong>
            </div>
        </article>

        <article class="yq-products-stat">
            <span class="yq-products-stat__icon" style="background: rgba(14, 165, 233, 0.15); color: #0ea5e9;">
                <i class="bi bi-clock-history"></i>
            </span>
            <div>
                <p>العروض القادمة</p>
                <strong>@Model.UpcomingPromotions</strong>
            </div>
        </article>

        <article class="yq-products-stat">
            <span class="yq-products-stat__icon" style="background: rgba(239, 68, 68, 0.15); color: #ef4444;">
                <i class="bi bi-x-circle-fill"></i>
            </span>
            <div>
                <p>العروض المنتهية</p>
                <strong>@Model.ExpiredPromotions</strong>
            </div>
        </article>

        <article class="yq-products-stat">
            <span class="yq-products-stat__icon" style="background: rgba(148, 163, 184, 0.15); color: #64748b;">
                <i class="bi bi-pause-circle-fill"></i>
            </span>
            <div>
                <p>العروض المتوقفة</p>
                <strong>@Model.DisabledPromotions</strong>
            </div>
        </article>
    </section>

    <!-- SEARCH & FILTER TOOLBAR -->
    <form method="get" asp-action="Index" class="promo-filter-panel">
        <div class="row g-3 align-items-center">
            <div class="col-lg-4 col-md-12">
                <div class="promo-search-wrapper">
                    <span class="promo-search-icon">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </span>
                    <input type="text" name="search" value="@Model.Search" class="form-control promo-search-input" placeholder="ابحث باسم العرض..." />
                </div>
            </div>

            <div class="col-lg-3 col-md-5">
                <select name="type" class="form-select promo-select">
                    <option value="">كل أنواع العروض</option>
                    <option value="Percentage" selected="@(Model.TypeFilter == "Percentage")">خصم نسبة مئوية (%)</option>
                    <option value="FixedAmount" selected="@(Model.TypeFilter == "FixedAmount")">خصم مبلغ ثابت (@CurrencyDisplay.Symbol)</option>
                    <option value="BuyXGetY" selected="@(Model.TypeFilter == "BuyXGetY")">اشتر X واحصل على Y مجاناً</option>
                    <option value="QuantityPrice" selected="@(Model.TypeFilter == "QuantityPrice")">سعر عرض على الكمية</option>
                    <option value="SpendAmount" selected="@(Model.TypeFilter == "SpendAmount")">خصم عند الوصول لمبلغ محدد</option>
                </select>
            </div>

            <div class="col-lg-3 col-md-5">
                <select name="status" class="form-select promo-select">
                    <option value="">جميع الحالات</option>
                    <option value="active" selected="@(Model.StatusFilter == "active")">نشط حالياً</option>
                    <option value="upcoming" selected="@(Model.StatusFilter == "upcoming")">قادم قريباً</option>
                    <option value="expired" selected="@(Model.StatusFilter == "expired")">منتهي</option>
                    <option value="disabled" selected="@(Model.StatusFilter == "disabled")">غير مفعل</option>
                </select>
            </div>

            <div class="col-lg-2 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-promo-apply w-100" title="تطبيق الفلترة">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>تطبيق</span>
                </button>
                <a asp-action="Index" class="btn btn-promo-reset" title="إعادة ضبط الفلاتر">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="23 4 23 10 17 10"></polyline>
                        <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                    </svg>
                </a>
            </div>
        </div>
    </form>

    <!-- PROMOTIONS TABLE -->
    <div class="promo-table-panel">
        <div class="promo-table-wrap">
            <table class="table promo-table">
                <thead>
                    <tr>
                        <th style="min-width: 250px;">العرض</th>
                        <th style="min-width: 140px;">نوع العرض</th>
                        <th style="min-width: 160px;">النطاق المستهدف</th>
                        <th style="min-width: 140px;">تفاصيل الخصم</th>
                        <th style="min-width: 170px;">فترة الصلاحية</th>
                        <th style="min-width: 80px;" class="text-center">الأولوية</th>
                        <th style="min-width: 120px;" class="text-center">الحالة</th>
                        <th style="min-width: 180px;" class="text-end">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Promotions != null && Model.Promotions.Any())
                    {
                        @foreach (var promo in Model.Promotions)
                        {
                            var targetClass = "promo-target--store";
                            if (promo.TargetSummary.Contains("منتجات"))
                            {
                                targetClass = "promo-target--products";
                            }
                            else if (promo.TargetSummary.Contains("تصنيفات"))
                            {
                                targetClass = "promo-target--categories";
                            }

                            <tr>
                                <!-- 1. العرض -->
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(promo.BannerImage))
                                        {
                                            <img src="@promo.BannerImage" alt="@promo.Title" class="promo-banner-thumb" />
                                        }
                                        else
                                        {
                                            <div class="promo-thumb-placeholder" title="عرض ترويجي">
                                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                                                    <line x1="7" y1="7" x2="7.01" y2="7"></line>
                                                </svg>
                                            </div>
                                        }
                                        <div>
                                            <strong class="d-block promo-title-text fw-bold" style="font-size: 0.95rem;">@promo.Title</strong>
                                            <small class="promo-date-muted">تم الإنشاء: @promo.CreatedAt.ToString("yyyy/MM/dd")</small>
                                        </div>
                                    </div>
                                </td>

                                <!-- 2. نوع العرض - شارة ملونة ومميزة لكل نوع -->
                                <td>
                                    <span class="promo-type-badge promo-type--@promo.PromotionType">
                                        @switch (promo.PromotionType)
                                        {
                                            case "Percentage":
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="5" x2="5" y2="19"></line><circle cx="6.5" cy="6.5" r="2.5"></circle><circle cx="17.5" cy="17.5" r="2.5"></circle></svg>
                                                <span>نسبة مئوية</span>
                                                break;
                                            case "FixedAmount":
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><line x1="6" y1="12" x2="18" y2="12"></line></svg>
                                                <span>مبلغ ثابت</span>
                                                break;
                                            case "BuyXGetY":
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"></polyline><rect x="2" y="7" width="20" height="5"></rect><line x1="12" y1="22" x2="12" y2="7"></line></svg>
                                                <span>اشتر X واحصل Y</span>
                                                break;
                                            case "QuantityPrice":
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
                                                <span>سعر خاص للكمية</span>
                                                break;
                                            case "SpendAmount":
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 5H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2z"></path><path d="M16 12h.01"></path></svg>
                                                <span>خصم سقف الشراء</span>
                                                break;
                                            default:
                                                <span>@promo.PromotionType</span>
                                                break;
                                        }
                                    </span>
                                </td>

                                <!-- 3. النطاق المستهدف - كبسولة بألوان متناسقة -->
                                <td>
                                    <span class="promo-target-chip @targetClass">
                                        @if (promo.TargetSummary.Contains("منتجات"))
                                        {
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
                                        }
                                        else if (promo.TargetSummary.Contains("تصنيفات"))
                                        {
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                                        }
                                        else
                                        {
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                                        }
                                        <span>@promo.TargetSummary</span>
                                    </span>
                                </td>

                                <!-- 4. تفاصيل الخصم - بطاقة ملونة بارزة -->
                                <td>
                                    @if (promo.PromotionType == "Percentage")
                                    {
                                        <span class="discount-pill discount-pill--percent">%@promo.DiscountValue.ToString("0.##")</span>
                                    }
                                    else if (promo.PromotionType == "FixedAmount")
                                    {
                                        <span class="discount-pill discount-pill--fixed">@promo.DiscountValue.ToString("N2") <small style="font-size: 0.72rem; opacity: 0.85;">@(CurrencyDisplay.Symbol)</small></span>
                                    }
                                    else if (promo.PromotionType == "BuyXGetY")
                                    {
                                        <span class="discount-pill discount-pill--bogo">اشتر @(promo.BuyQuantity ?? 1) احصل @(promo.FreeQuantity ?? 1)</span>
                                    }
                                    else if (promo.PromotionType == "QuantityPrice")
                                    {
                                        <span class="discount-pill discount-pill--qty">@((promo.OfferPrice ?? promo.DiscountValue).ToString("N2")) <small style="font-size: 0.72rem; opacity: 0.85;">@(CurrencyDisplay.Symbol)</small></span>
                                    }
                                    else
                                    {
                                        <span class="discount-pill discount-pill--percent">@promo.DiscountValue.ToString("N2")</span>
                                    }
                                </td>

                                <!-- 5. فترة الصلاحية -->
                                <td>
                                    <div class="small" style="line-height: 1.6;">
                                        <div class="d-flex align-items-center gap-1 promo-period-text">
                                            <span class="promo-period-label">من:</span>
                                            <span>@promo.StartDate.ToString("yyyy/MM/dd HH:mm")</span>
                                        </div>
                                        <div class="d-flex align-items-center gap-1 promo-period-text">
                                            <span class="promo-period-label">إلى:</span>
                                            <span>@promo.EndDate.ToString("yyyy/MM/dd HH:mm")</span>
                                        </div>
                                    </div>
                                </td>

                                <!-- 6. الأولوية -->
                                <td class="text-center">
                                    <span class="promo-priority-badge" title="أولوية التطبيق">@promo.Priority</span>
                                </td>

                                <!-- 7. الحالة - شارة مضيئة بنبض حيوي -->
                                <td class="text-center">
                                    <span class="yq-status-badge yq-status-badge--@promo.StatusKey">
                                        <span class="yq-status-dot"></span>
                                        <span>@promo.StatusBadgeText</span>
                                    </span>
                                </td>

                                <!-- 8. الإجراءات - أزرار ملونة متفاعلة ومناسبة لوظيفتها -->
                                <td class="text-end">
                                    <div class="promo-actions-group">
                                        <!-- 1. زر تبديل الحالة المباشر (تفعيل / إيقاف) -->
                                        <form asp-action="ToggleStatus" asp-route-id="@promo.Id" method="post" class="d-inline toggle-status-form">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="promo-btn-action @(promo.IsActive ? "promo-btn-action--toggle-active" : "promo-btn-action--toggle-inactive")"
                                                    title="@(promo.IsActive ? "العرض مفعل - اضغط للتعطيل" : "العرض متوقف - اضغط للتفعيل")">
                                                @if (promo.IsActive)
                                                {
                                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                        <rect x="1" y="5" width="22" height="14" rx="7" ry="7"></rect>
                                                        <circle cx="16" cy="12" r="3" fill="currentColor"></circle>
                                                    </svg>
                                                }
                                                else
                                                {
                                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                        <rect x="1" y="5" width="22" height="14" rx="7" ry="7"></rect>
                                                        <circle cx="8" cy="12" r="3" fill="currentColor"></circle>
                                                    </svg>
                                                }
                                            </button>
                                        </form>

                                        <!-- 2. زر عرض التفاصيل الكاملة (Cyan) -->
                                        <a asp-action="Details" asp-route-id="@promo.Id" class="promo-btn-action promo-btn-action--view" title="عرض التفاصيل">
                                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                                <circle cx="12" cy="12" r="3"></circle>
                                            </svg>
                                        </a>

                                        <!-- 3. زر التعديل (Amber / Gold) -->
                                        <a asp-action="Edit" asp-route-id="@promo.Id" class="promo-btn-action promo-btn-action--edit" title="تعديل العرض">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                            </svg>
                                        </a>

                                        <!-- 4. زر الحذف (Crimson Red) -->
                                        <a asp-action="Delete" asp-route-id="@promo.Id" class="promo-btn-action promo-btn-action--delete" title="حذف العرض">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6"></polyline>
                                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                                <line x1="10" y1="11" x2="10" y2="17"></line>
                                                <line x1="14" y1="11" x2="14" y2="17"></line>
                                            </svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-tags d-block fs-1 mb-2 opacity-50"></i>
                                لا توجد عروض ترويجية مطابقة للبحث حالياً.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- PAGINATION -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4 d-flex justify-content-center">
            <ul class="pagination promo-pagination">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.Search" asp-route-type="@Model.TypeFilter" asp-route-status="@Model.StatusFilter">السابق</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@Model.Search" asp-route-type="@Model.TypeFilter" asp-route-status="@Model.StatusFilter">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.Search" asp-route-type="@Model.TypeFilter" asp-route-status="@Model.StatusFilter">التالي</a>
                </li>
            </ul>
        </nav>
    }
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".toggle-status-form").forEach(function (form) {
                form.addEventListener("submit", function (e) {
                    e.preventDefault();
                    var btn = form.querySelector("button");
                    if (btn) btn.disabled = true;

                    var formData = new FormData(form);
                    fetch(form.action, {
                        method: "POST",
                        body: formData,
                        headers: {
                            "X-Requested-With": "XMLHttpRequest"
                        }
                    })
                    .then(function (res) { return res.json(); })
                    .then(function (data) {
                        if (data && data.success) {
                            window.location.reload();
                        } else {
                            alert(data.message || "حدث خطأ أثناء تغيير الحالة");
                            if (btn) btn.disabled = false;
                        }
                    })
                    .catch(function () {
                        form.submit();
                    });
                });
            });
        });
    </script>
}
