@model IEnumerable<User>
@{
    ViewData["Title"] = "إدارة المستخدمين";
    var id =1;
}

<div class="yaqut-admin-header">
    <h1><i class="bi bi-people"></i> إدارة المستخدمين</h1>
</div>

<table class="yaqut-admin-table">
    <thead>
        <tr>
            <th>#</th>
            <th>الاسم</th>
            <th>رقم الجوال</th>
            <th>الدور</th>
            <th>تاريخ التسجيل</th>
        </tr>
    </thead>
    <tbody>
        
        @foreach (var user in Model.OrderBy(s=> s.Id))
        {
           
            <tr>
                <td>@id</td>
                <td>@user.Name</td>
                <td>
                    @if (user.Role == "Developer")
                    {
                    <span >775458250</span>
                    }
                    else
                    {
                        @user.Phone
                    }
                </td>
                <td>
                    @if (user.Role == "Admin")
                    {
                        <span class="badge badge-shipped">مدير</span>
                    }
                    else if (user.Role == "Developer")
                    {
                        <span class="badge badge-pending">مطور</span>
                    }
                    else
                    {
                        <span class="badge badge-pending">زبون</span>
                    }
                </td>
                <td>@(user.Createdat.HasValue ? user.Createdat.Value.ToString("dd/MM/yyyy") : "-")</td>
            </tr>
            id += 1;
        }
    </tbody>
</table>
