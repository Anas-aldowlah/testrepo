@using YAGOT_2._0.Models.Admin
@model AdminProductCreateViewModel
@inject YAGOT_2._0.Core.Capabilities.ICapabilityEvaluator CapabilityEvaluator
@{
    ViewData["Title"] = "إضافة منتج";
    var rows = Model.RetailPrices;
    var canManageBrands = CapabilityEvaluator.IsFeatureEnabled(YAGOT_2._0.Core.Capabilities.CapabilityFeatureCodes.ProductBrands);
    var canSellRetail = CapabilityEvaluator.IsFeatureEnabled(YAGOT_2._0.Core.Capabilities.CapabilityFeatureCodes.RetailSelling);
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/products.css" asp-append-version="true" />
}

<section class="yq-products-create yq-product-editor" aria-labelledby="productCreateTitle">
    <header class="yq-products-hero yq-products-create__hero">
        <div class="yq-products-hero__content">
            <span class="yq-products-eyebrow">إدارة الكتالوج</span>
            <h2 id="productCreateTitle">إضافة منتج</h2>
            <p>أدخل بيانات المنتج، السعر، الصورة، وطريقة حساب المخزون من مكان واحد.</p>
        </div>
        <div class="yq-products-hero__actions">
            <a asp-action="Index" class="btn-yaqut-outline"><i class="bi bi-arrow-right"></i><span>العودة</span></a>
        </div>
    </header>

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="yq-product-form"
          data-product-retail-form data-retail-prefix="">
        <div asp-validation-summary="ModelOnly" class="yaqut-alert yaqut-alert--danger yq-product-form__summary" role="alert"></div>

        <section class="yq-product-form__section">
            <div class="yq-product-form__section-head">
                <span class="yq-product-form__section-icon"><i class="bi bi-card-text"></i></span>
                <div>
                    <h3>بيانات المنتج</h3>
                    <p>المعلومات التي تظهر للعميل داخل المتجر.</p>
                </div>
            </div>
            <div class="yq-product-form__grid">
                <div class="yaqut-form-group yq-product-field">
                    <label asp-for="Name" class="yaqut-form-label">اسم المنتج</label>
                    <input asp-for="Name" class="yaqut-form-input" autocomplete="off" />
                    <span asp-validation-for="Name" class="yq-product-validation"></span>
                </div>
                @if (canManageBrands)
                {
                <div class="yaqut-form-group yq-product-field">
                    <label asp-for="Brand" class="yaqut-form-label">الماركة</label>
                    <input asp-for="Brand" list="brandsList" class="yaqut-form-input" autocomplete="off" />
                    @if (ViewBag.Brands != null)
                    {
                        <datalist id="brandsList">
                            @foreach (var brand in (List<string>)ViewBag.Brands)
                            {
                                <option value="@brand"></option>
                            }
                        </datalist>
                    }
                </div>
                }
                <div class="yaqut-form-group yq-product-field yq-product-field--wide">
                    <label asp-for="Categoryid" class="yaqut-form-label">التصنيف</label>
                    <select asp-for="Categoryid" asp-items="@ViewBag.Categoryid" class="yaqut-form-input">
                        <option value="">-- اختر التصنيف --</option>
                    </select>
                    <span asp-validation-for="Categoryid" class="yq-product-validation"></span>
                </div>
                <div class="yaqut-form-group yq-product-field yq-product-field--wide">
                    <label asp-for="Description" class="yaqut-form-label">الوصف</label>
                    <textarea asp-for="Description" rows="4" class="yaqut-form-input"></textarea>
                </div>
                <div class="yaqut-form-group yq-product-field">
                    <label asp-for="Price" class="yaqut-form-label">سعر البيع</label>
                    <input asp-for="Price" type="number" step="0.01" min="0" class="yaqut-form-input" />
                    <span asp-validation-for="Price" class="yq-product-validation"></span>
                </div>
                <div class="yaqut-form-group yq-product-field">
                    <label asp-for="Imagefile" class="yaqut-form-label">الصورة</label>
                    <input asp-for="Imagefile" type="file" accept="image/*" class="yaqut-form-input" />
                    <span asp-validation-for="Imagefile" class="yq-product-validation"></span>
                </div>
            </div>
        </section>

        <section class="yq-product-form__section">
            <div class="yq-product-form__section-head">
                <span class="yq-product-form__section-icon"><i class="bi bi-boxes"></i></span>
                <div>
                    <h3>تفاصيل الكمية والتعبئة</h3>
                    <p>حدد وحدة المنتج والكمية المتوفرة. إذا اخترت مل، اكتب حجم العبوة والكمية كعدد عبوات.</p>
                </div>
            </div>
            <div class="yq-product-form__grid">
                <div class="yaqut-form-group yq-product-field">
                    <label asp-for="StockUnit" class="yaqut-form-label">الوحدة</label>
                    <select asp-for="StockUnit" class="yaqut-form-input" data-stock-unit>
                        <option value="Piece">قطعة</option>
                        <option value="Ml">مل</option>
                    </select>
                    <span asp-validation-for="StockUnit" class="yq-product-validation"></span>
                </div>
                <div class="yaqut-form-group yq-product-field" data-volume-field>
                    <label asp-for="VolumeMl" class="yaqut-form-label">الحجم</label>
                    <input asp-for="VolumeMl" type="number" min="1" class="yaqut-form-input" placeholder="مثال: 200" data-base-volume />
                    <span asp-validation-for="VolumeMl" class="yq-product-validation"></span>
                </div>
                <div class="yaqut-form-group yq-product-field">
                    <label asp-for="Stockquantity" class="yaqut-form-label">الكمية</label>
                    <input asp-for="Stockquantity" type="number" min="0" class="yaqut-form-input" />
                    <span asp-validation-for="Stockquantity" class="yq-product-validation"></span>
                    <span class="yq-product-help">قطعة = عدد القطع. مل = عدد العبوات.</span>
                </div>
                @if (canSellRetail)
                {
                <label class="yaqut-form-group yq-product-field yq-product-field--wide yq-retail-toggle">
                    <input asp-for="IsRetailEnabled" type="checkbox" data-retail-toggle />
                    <span>تفعيل أسعار التجزئة</span>
                </label>
                <span asp-validation-for="IsRetailEnabled" class="yq-product-validation yq-product-field--wide" data-retail-toggle-validation></span>
                }
            </div>

            @if (canSellRetail)
            {
            <div class="yq-retail-prices" data-retail-prices hidden>
                <div class="yq-retail-prices__head">
                    <div class="yq-retail-prices__intro">
                        <strong>أسعار التجزئة</strong>
                        <span>يجب أن يكون كل حجم موجباً وأصغر من حجم العبوة الأساسي، وسعره أكبر من صفر.</span>
                    </div>
                    <button type="button" class="btn-yaqut-outline yq-retail-add-btn" data-add-retail-price>
                        <i class="bi bi-plus-lg"></i>
                        <span>إضافة سعر تجزئة</span>
                    </button>
                </div>
                <div class="yq-product-form__grid yq-retail-prices__grid" data-retail-price-list>
                    @for (var i = 0; i < rows.Count; i++)
                    {
                        <div class="yq-retail-price-row">
                            <input type="hidden" asp-for="RetailPrices[i].Id" />
                            <div class="yq-retail-controls">
                                <div class="yaqut-form-group yq-product-field">
                                    <label asp-for="RetailPrices[i].SizeMl" class="yaqut-form-label">الحجم ml</label>
                                    <input asp-for="RetailPrices[i].SizeMl" type="number" min="1" required class="yaqut-form-input" />
                                    <span asp-validation-for="RetailPrices[i].SizeMl" class="yq-product-validation"></span>
                                </div>
                                <div class="yaqut-form-group yq-product-field">
                                    <label asp-for="RetailPrices[i].Price" class="yaqut-form-label">السعر</label>
                                    <input asp-for="RetailPrices[i].Price" type="number" step="0.01" min="0.01" required class="yaqut-form-input" />
                                    <span asp-validation-for="RetailPrices[i].Price" class="yq-product-validation"></span>
                                </div>
                                <div class="yq-retail-active-field">
                                    <span class="yaqut-form-label">الحالة</span>
                                    <label class="yq-retail-active" for="RetailPrices_@(i)__IsActive">
                                        <input id="RetailPrices_@(i)__IsActive" name="RetailPrices[@i].IsActive" type="checkbox" value="true" checked="@rows[i].IsActive" />
                                        <span data-retail-active-label>نشط</span>
                                    </label>
                                    <input type="hidden" name="RetailPrices[@i].IsActive" value="false" />
                                </div>
                                <div class="yq-retail-action-field">
                                    <span class="yaqut-form-label">الإجراء</span>
                                    <button type="button" class="yq-retail-remove" data-remove-retail-price aria-label="حذف سعر التجزئة"><i class="bi bi-trash"></i></button>
                                </div>
                            </div>
                            <span asp-validation-for="RetailPrices[i]" class="yq-product-validation yq-retail-row-validation"></span>
                        </div>
                    }
                </div>
                <span asp-validation-for="RetailPrices" class="yq-product-validation yq-retail-group-validation" data-retail-group-validation tabindex="-1"></span>
            </div>
            }
        </section>

        <div class="yq-product-form__actions">
            <a asp-action="Index" class="btn-yaqut-outline"><i class="bi bi-x-lg"></i><span>إلغاء</span></a>
            <button type="submit" class="btn-yaqut-gold" data-retail-save disabled="@canSellRetail"><i class="bi bi-check2-circle"></i><span>حفظ المنتج</span></button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/admin/products/edit.js" asp-append-version="true"></script>
}
