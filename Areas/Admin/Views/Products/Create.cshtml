@model ProductVW
@{
    ViewData["Title"] = "إضافة منتج";
    var rows = Model?.RetailPrices ?? new List<ProductRetailPriceInput>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/products.css" asp-append-version="true" />
}

<section class="yq-products-create yq-product-editor" aria-labelledby="productCreateTitle">
    <header class="yq-products-hero yq-products-create__hero">
        <div class="yq-products-hero__content">
            <span class="yq-products-eyebrow">إدارة الكتالوج</span>
            <h2 id="productCreateTitle">إضافة منتج</h2>
            <p>أدخل بيانات المنتج، السعر، الصورة، وطريقة حساب المخزون من مكان واحد.</p>
        </div>
        <div class="yq-products-hero__actions">
            <a asp-action="Index" class="btn-yaqut-outline"><i class="bi bi-arrow-right"></i><span>العودة</span></a>
        </div>
    </header>

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="yq-product-form">
        <div asp-validation-summary="All" class="yaqut-alert yaqut-alert--danger yq-product-form__summary" role="alert"></div>

        <section class="yq-product-form__section">
            <div class="yq-product-form__section-head">
                <span class="yq-product-form__section-icon"><i class="bi bi-card-text"></i></span>
                <div>
                    <h3>بيانات المنتج</h3>
                    <p>المعلومات التي تظهر للعميل داخل المتجر.</p>
                </div>
            </div>
            <div class="yq-product-form__grid">
                <div class="yaqut-form-group yq-product-field">
                    <label asp-for="Name" class="yaqut-form-label">اسم المنتج</label>
                    <input asp-for="Name" class="yaqut-form-input" autocomplete="off" />
                </div>
                <div class="yaqut-form-group yq-product-field">
                    <label asp-for="Brand" class="yaqut-form-label">الشركة</label>
                    <input asp-for="Brand" class="yaqut-form-input" autocomplete="off" />
                </div>
                <div class="yaqut-form-group yq-product-field yq-product-field--wide">
                    <label asp-for="Categoryid" class="yaqut-form-label">التصنيف</label>
                    <select asp-for="Categoryid" asp-items="@ViewBag.Categoryid" class="yaqut-form-input">
                        <option value="">-- اختر التصنيف --</option>
                    </select>
                </div>
                <div class="yaqut-form-group yq-product-field yq-product-field--wide">
                    <label asp-for="Description" class="yaqut-form-label">الوصف</label>
                    <textarea asp-for="Description" rows="4" class="yaqut-form-input"></textarea>
                </div>
                <div class="yaqut-form-group yq-product-field">
                    <label asp-for="Price" class="yaqut-form-label">سعر البيع الكامل</label>
                    <input asp-for="Price" type="number" step="0.01" min="0" class="yaqut-form-input" />
                </div>
                <div class="yaqut-form-group yq-product-field">
                    <label asp-for="Imagefile" class="yaqut-form-label">الصورة</label>
                    <input asp-for="Imagefile" type="file" accept="image/*" class="yaqut-form-input" />
                </div>
            </div>
        </section>

        <section class="yq-product-form__section">
            <div class="yq-product-form__section-head">
                <span class="yq-product-form__section-icon"><i class="bi bi-boxes"></i></span>
                <div>
                    <h3>تكوين المخزون</h3>
                    <p>حدد وحدة المنتج والكمية المتوفرة. إذا اخترت مل، اكتب حجم العبوة والكمية كعدد عبوات.</p>
                </div>
            </div>
            <div class="yq-product-form__grid">
                <div class="yaqut-form-group yq-product-field">
                    <label asp-for="StockUnit" class="yaqut-form-label">الوحدة</label>
                    <select asp-for="StockUnit" class="yaqut-form-input" data-stock-unit>
                        <option value="Piece">قطعة</option>
                        <option value="Ml">مل</option>
                    </select>
                </div>
                <div class="yaqut-form-group yq-product-field" data-volume-field>
                    <label asp-for="VolumeMl" class="yaqut-form-label">الحجم</label>
                    <input asp-for="VolumeMl" type="number" min="1" class="yaqut-form-input" placeholder="مثال: 200" />
                </div>
                <div class="yaqut-form-group yq-product-field">
                    <label asp-for="Stockquantity" class="yaqut-form-label">الكمية</label>
                    <input asp-for="Stockquantity" type="number" min="0" class="yaqut-form-input" />
                    <span class="yq-product-help">قطعة = عدد القطع. مل = عدد العبوات.</span>
                </div>
                <label class="yaqut-form-group yq-product-field yq-product-field--wide yq-retail-toggle">
                    <input asp-for="IsRetailEnabled" type="checkbox" />
                    <span>تفعيل أسعار التجزئة</span>
                </label>
            </div>

            <div class="yq-retail-prices" data-retail-prices hidden>
                <div class="yq-retail-prices__head">
                    <strong>أسعار التجزئة</strong>
                    <span>اكتب الحجم بالمل وسعر البيع لهذا الحجم.</span>
                </div>
                <div class="yq-product-form__grid yq-retail-prices__grid" data-retail-price-list>
                    @for (var i = 0; i < rows.Count; i++)
                    {
                        <div class="yq-retail-price-row">
                            <input type="hidden" name="RetailPrices[@i].Id" value="@rows[i].Id" />
                            <div class="yaqut-form-group yq-product-field">
                                <label class="yaqut-form-label">الحجم ml</label>
                                <input name="RetailPrices[@i].SizeMl" value="@rows[i].SizeMl" type="number" min="0" class="yaqut-form-input" />
                            </div>
                            <div class="yaqut-form-group yq-product-field">
                                <label class="yaqut-form-label">السعر</label>
                                <input name="RetailPrices[@i].Price" value="@rows[i].Price" type="number" step="0.01" min="0" class="yaqut-form-input" />
                                <input type="hidden" name="RetailPrices[@i].IsActive" value="true" />
                            </div>
                            <button type="button" class="yq-retail-remove" data-remove-retail-price aria-label="حذف سعر التجزئة">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    }
                </div>
                <button type="button" class="btn-yaqut-outline yq-retail-add-btn" data-add-retail-price>
                    <i class="bi bi-plus-lg"></i>
                    <span>إضافة سعر تجزئة</span>
                </button>
            </div>
        </section>

        <div class="yq-product-form__actions">
            <a asp-action="Index" class="btn-yaqut-outline"><i class="bi bi-x-lg"></i><span>إلغاء</span></a>
            <button type="submit" class="btn-yaqut-gold"><i class="bi bi-check2-circle"></i><span>حفظ المنتج</span></button>
        </div>
    </form>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const stockUnit = document.querySelector('[data-stock-unit]');
            const retailToggle = document.getElementById('IsRetailEnabled');
            const retailPrices = document.querySelector('[data-retail-prices]');
            const retailList = document.querySelector('[data-retail-price-list]');
            const addRetailButton = document.querySelector('[data-add-retail-price]');
            const volumeField = document.querySelector('[data-volume-field]');
            const volumeInput = document.getElementById('VolumeMl');
            let retailIndex = @rows.Count;

            function addRetailRow() {
                if (!retailList) return;
                const row = document.createElement('div');
                row.className = 'yq-retail-price-row';
                row.innerHTML = `
                    <input type="hidden" name="RetailPrices[${retailIndex}].IsActive" value="true" />
                    <div class="yaqut-form-group yq-product-field">
                        <label class="yaqut-form-label">الحجم ml</label>
                        <input name="RetailPrices[${retailIndex}].SizeMl" type="number" min="0" class="yaqut-form-input" />
                    </div>
                    <div class="yaqut-form-group yq-product-field">
                        <label class="yaqut-form-label">السعر</label>
                        <input name="RetailPrices[${retailIndex}].Price" type="number" step="0.01" min="0" class="yaqut-form-input" />
                    </div>
                    <button type="button" class="yq-retail-remove" data-remove-retail-price aria-label="حذف سعر التجزئة">
                        <i class="bi bi-trash"></i>
                    </button>`;
                retailList.appendChild(row);
                retailIndex++;
            }

            function syncForm() {
                const isMl = stockUnit?.value === 'Ml';
                if (volumeField) volumeField.hidden = !isMl;
                if (!isMl && volumeInput) volumeInput.value = '';
                if (retailToggle) {
                    retailToggle.closest('.yq-retail-toggle').hidden = !isMl;
                    if (!isMl) retailToggle.checked = false;
                }
                if (retailPrices) retailPrices.hidden = !(isMl && retailToggle?.checked);
            }

            stockUnit?.addEventListener('change', syncForm);
            retailToggle?.addEventListener('change', syncForm);
            addRetailButton?.addEventListener('click', addRetailRow);
            retailList?.addEventListener('click', function (event) {
                const removeButton = event.target.closest('[data-remove-retail-price]');
                if (removeButton) removeButton.closest('.yq-retail-price-row')?.remove();
            });
            syncForm();
        });
    </script>
}
