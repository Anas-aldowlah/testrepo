@model YAGOT_2._0.Services.ViewModels
@{
    ViewData["Title"] = "سلة المحذوفات";
}

<div class="yaqut-admin-header">
    <h1><i class="bi bi-trash"></i> سلة المحذوفات</h1>
    <a asp-action="Index" class="btn-yaqut-gold btn-sm"><i class="bi bi-arrow-right"></i> العودة للمنتجات</a>
</div>

@if (TempData["Error"] != null)
{
    <div class="yaqut-alert yaqut-alert--danger">@TempData["Error"]</div>
}

<div class="yaqut-admin-grid">
    @foreach (var p in Model.Products)
    {
        if (p.Stockquantity == 0 && p.Imageurl == "/images/products/6389130_camera_interface_movie_picture_zoom_icon.png")
        {
            var cat = Model.Categories.FirstOrDefault(c => c.Id == p.Categoryid);

            <article class="yaqut-admin-card glass-effect">
                <img src="@p.Imageurl" alt="@p.Name" class="yaqut-admin-card__img" />
                <div class="yaqut-admin-card__body">
                    <h3 class="yaqut-admin-card__title">@p.Name</h3>
                    <p class="text-muted small">@(cat?.Name ?? "-")</p>
                    <div class="yaqut-product-card__price mb-2">@p.Price.ToString("N0") <small>ر.س</small></div>
                    <div class="d-flex gap-2 mt-3">
                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn-yaqut-outline btn-sm flex-fill text-center">استعادة / تعديل</a>
                        <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="flex-fill"
                              data-yaqut-confirm="هل أنت متأكد من الحذف النهائي لـ @p.Name؟">
                            <button type="submit" class="btn-yaqut-danger btn-sm w-100">حذف نهائي</button>
                        </form>
                    </div>
                </div>
            </article>
        }
    }
</div>
