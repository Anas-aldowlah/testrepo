@model YAGOT_2._0.Models.Admin.AdminOrdersIndexViewModel
@using YAGOT_2._0.Services
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@using System.Security.Claims
@inject DealingAPI DealingApiService
@{
    ViewData["Title"] = "إدارة الطلبات";

    var orders = Model.Orders.Items;
    var selectedStatus = Model.SelectedStatus;
    var search = Model.Search;
    var hasActiveFilters = Model.HasActiveFilters;
    var pagerRouteValues = new Dictionary<string, object?>
    {
        ["search"] = search,
        ["status"] = selectedStatus
    };
    var pagerViewData = new ViewDataDictionary(ViewData)
    {
        ["RouteValues"] = pagerRouteValues,
        ["Action"] = "Index"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/orders.css" asp-append-version="true" />
}

@section Breadcrumb {
    <span>/</span>
    <span>الطلبات</span>
}

<section class="yq-orders-admin"
         aria-labelledby="ordersIndexTitle"
         data-yq-orders-page
         data-yq-update-status-url="@Url.Action("UpdateStatus", "Orders", new { area = "Admin" })">
    <header class="yq-orders-hero">
        <div class="yq-orders-hero__content">
            <span class="yq-orders-eyebrow">إدارة المبيعات</span>
            <h2 id="ordersIndexTitle">الطلبات</h2>
            <p>تابع طلبات العملاء، راجع الإجماليات وحالات التنفيذ، وحدّث حالة الطلب من واجهة واضحة مهيأة للعمل اليومي.</p>
        </div>

        <div class="yq-orders-hero__meta" aria-label="ملخص الطلبات المعروضة">
            <span>@Model.Orders.TotalItems طلب</span>
            <strong>@Model.TotalRevenue.ToString("N0") ر.س</strong>
        </div>
    </header>

    <div id="yqOrdersAlertArea">
        @if (TempData["Error"] != null)
        {
            <div class="yaqut-alert yq-admin-operation-feedback yaqut-alert--danger" role="alert">
                <i class="bi bi-exclamation-octagon-fill" aria-hidden="true"></i>
                <span>@TempData["Error"]</span>
            </div>
        }
        else if (TempData["Success"] != null)
        {
            <div class="yaqut-alert yq-admin-operation-feedback yaqut-alert--success" role="status">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                <span>@TempData["Success"]</span>
            </div>
        }
    </div>

    <section class="yq-orders-summary" aria-label="ملخص حالات الطلبات">
        <article class="yq-orders-stat">
            <span class="yq-orders-stat__icon"><i class="bi bi-receipt" aria-hidden="true"></i></span>
            <div>
                <p>الطلبات المعروضة</p>
                <strong>@Model.Orders.TotalItems</strong>
            </div>
        </article>
        <article class="yq-orders-stat">
            <span class="yq-orders-stat__icon"><i class="bi bi-hourglass-split" aria-hidden="true"></i></span>
            <div>
                <p>قيد الانتظار</p>
                <strong>@Model.PendingCount</strong>
            </div>
        </article>
        <article class="yq-orders-stat">
            <span class="yq-orders-stat__icon"><i class="bi bi-truck" aria-hidden="true"></i></span>
            <div>
                <p>قيد التنفيذ</p>
                <strong>@Model.ActiveCount</strong>
            </div>
        </article>
        <article class="yq-orders-stat">
            <span class="yq-orders-stat__icon"><i class="bi bi-check2-circle" aria-hidden="true"></i></span>
            <div>
                <p>تم التوصيل</p>
                <strong>@Model.DeliveredCount</strong>
            </div>
        </article>
    </section>

    <section class="yq-orders-filter-panel" aria-labelledby="ordersFilterTitle">
        <div class="yq-orders-filter-panel__header">
            <div>
                <span class="yq-orders-eyebrow">البحث والتصفية</span>
                <h3 id="ordersFilterTitle">تصفية الطلبات</h3>
            </div>
            @if (hasActiveFilters)
            {
                <a asp-action="Index" class="yq-orders-clear-filter">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                    <span>مسح الفلاتر</span>
                </a>
            }
        </div>

        <form method="get" class="yq-orders-filter-form">
            <input type="hidden" name="pageSize" value="@Model.Orders.PageSize" />
            <div class="yq-orders-search">
                <label for="ordersSearch">البحث</label>
                <div class="yq-orders-search__control">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input id="ordersSearch"
                           type="search"
                           name="search"
                           value="@search"
                           placeholder="اسم العميل أو رقم التتبع" />
                </div>
            </div>

            <fieldset class="yq-orders-status-filter">
                <legend>حالة الطلب</legend>
                <label>
                    <input type="checkbox" name="status" value="Pending" checked="@selectedStatus.Contains("Pending")" />
                    <span>قيد الانتظار</span>
                </label>
                <label>
                    <input type="checkbox" name="status" value="Processed" checked="@selectedStatus.Contains("Processed")" />
                    <span>تم الدفع</span>
                </label>
                <label>
                    <input type="checkbox" name="status" value="Shipped" checked="@selectedStatus.Contains("Shipped")" />
                    <span>تم الشحن</span>
                </label>
                <label>
                    <input type="checkbox" name="status" value="Delivered" checked="@selectedStatus.Contains("Delivered")" />
                    <span>تم التوصيل</span>
                </label>
                <label>
                    <input type="checkbox" name="status" value="Cancelled" checked="@selectedStatus.Contains("Cancelled")" />
                    <span>ملغي</span>
                </label>
                <label>
                    <input type="checkbox" name="status" value="Refunded" checked="@selectedStatus.Contains("Refunded")" />
                    <span>مرتجع</span>
                </label>
            </fieldset>

            <div class="yq-orders-filter-actions">
                <button type="submit" class="btn-yaqut-gold">
                    <i class="bi bi-funnel" aria-hidden="true"></i>
                    <span>تطبيق</span>
                </button>
                <a asp-action="Index" class="btn-yaqut-outline">
                    <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                    <span>إعادة ضبط</span>
                </a>
            </div>
        </form>
    </section>

    <section class="yq-orders-panel" aria-labelledby="ordersTableTitle">
        <div class="yq-orders-panel__header">
            <div>
                <span class="yq-orders-eyebrow">قائمة الإدارة</span>
                <h3 id="ordersTableTitle">جميع الطلبات</h3>
            </div>
        </div>

        @if (orders.Any())
        {
            <div class="yq-orders-table-wrap">
                <table class="yq-orders-table">
                    <thead>
                        <tr>
                            <th scope="col">رقم الطلب</th>
                            <th scope="col">العميل</th>
                            <th scope="col">الإجمالي</th>
                            <th scope="col">حالة الطلب</th>
                            <th scope="col">تاريخ الطلب</th>
                            <th scope="col">المعلومات السريعة</th>
                            <th scope="col">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in orders)
                        {
                            var statusLabel = order.Status switch
                            {
                                "Pending" => "قيد الانتظار",
                                "Processed" => "تم الدفع",
                                "Shipped" => "تم الشحن",
                                "Delivered" => "تم التوصيل",
                                "Cancelled" => "ملغي",
                                "Refunded" => "مرتجع",
                                _ => order.Status
                            };

                            var statusClass = order.Status switch
                            {
                                "Pending" => "yq-orders-badge--pending",
                                "Processed" => "yq-orders-badge--processed",
                                "Shipped" => "yq-orders-badge--shipped",
                                "Delivered" => "yq-orders-badge--delivered",
                                "Cancelled" => "yq-orders-badge--cancelled",
                                "Refunded" => "yq-orders-badge--cancelled",
                                _ => "yq-orders-badge--neutral"
                            };

                            var delivery = order.Deliveryorder;
                            var customerName = order.User?.Name ?? "عميل غير معروف";
                            var customerPhone = DealingApiService.DecryptPhone(order.User?.Phone);
                            var customerEmail = order.User?.Email;
                            var itemCount = order.Orderitems?.Sum(i => i.Quantity) ?? 0;

                            var recipientName = !string.IsNullOrWhiteSpace(delivery?.Fullname)
                                ? delivery.Fullname
                                : customerName;
                            var deliveryPhones = new[] { delivery?.Phonenumber, delivery?.Secondphonenumber }
                                .Where(phone => !string.IsNullOrWhiteSpace(phone))
                                .Distinct()
                                .ToArray();
                            var recipientPhone = deliveryPhones.Length > 0
                                ? string.Join(" / ", deliveryPhones)
                                : !string.IsNullOrWhiteSpace(customerPhone) ? customerPhone : "-";
                            var governorate = !string.IsNullOrWhiteSpace(delivery?.Governorate)
                                ? delivery.Governorate
                                : "-";
                            var region = !string.IsNullOrWhiteSpace(delivery?.City)
                                ? delivery.City
                                : "-";
                            var district = !string.IsNullOrWhiteSpace(delivery?.District)
                                ? delivery.District
                                : "-";
                            var addressParts = new[] { governorate, region, district }
                                .Where(part => !string.IsNullOrWhiteSpace(part) && part != "-")
                                .ToArray();
                            var fullAddress = addressParts.Length > 0 ? string.Join("، ", addressParts) : "-";

                            var paymentMethod = !string.IsNullOrWhiteSpace(order.Paymentmethod)
                                ? order.Paymentmethod
                                : "غير محدد";
                            var receiptImage = !string.IsNullOrWhiteSpace(order.Receipturl)
                                ? Url.Action("Receipt", "Orders", new { area = "Admin", id = order.Id })
                                : null;

                            <tr data-order-id="@order.Id">
                                <td data-label="رقم الطلب">
                                    <div class="yq-orders-number">
                                        <strong>#@order.Id</strong>
                                        @if (!string.IsNullOrWhiteSpace(order.Trackingnumber))
                                        {
                                            <span>@order.Trackingnumber</span>
                                        }
                                        else
                                        {
                                            <span>لا يوجد رقم تتبع</span>
                                        }
                                    </div>
                                </td>
                                <td data-label="العميل">
                                    <div class="yq-orders-customer">
                                        <span class="yq-orders-customer__avatar" aria-hidden="true">
                                            <i class="bi bi-person"></i>
                                        </span>
                                        <div>
                                            <strong>@customerName</strong>
                                            @if (!string.IsNullOrWhiteSpace(customerPhone))
                                            {
                                                <span>@customerPhone</span>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(customerEmail))
                                            {
                                                <span>@customerEmail</span>
                                            }
                                            else
                                            {
                                                <span>لا توجد بيانات تواصل</span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td data-label="الإجمالي">
                                    <div class="yq-orders-total">
                                        <strong>@order.Totalamount.ToString("N0")</strong>
                                        <span>ر.س</span>
                                        <small>@itemCount قطعة</small>
                                    </div>
                                </td>
                                <td data-label="حالة الطلب">
                                    <span class="yq-orders-badge @statusClass" data-order-badge="@order.Id">@statusLabel</span>
                                    @if (order.TimeState.HasValue)
                                    {
                                        <small class="yq-orders-status-date">@order.TimeState.Value.ToString("dd/MM/yyyy")</small>
                                    }
                                </td>
                                <td data-label="تاريخ الطلب">
                                    <time class="yq-orders-date" datetime="@(order.Orderdate?.ToString("yyyy-MM-dd") ?? "")">
                                        @(order.Orderdate.HasValue ? order.Orderdate.Value.ToString("dd/MM/yyyy") : "-")
                                    </time>
                                </td>
                                <td data-label="المعلومات السريعة">
                                    <div class="yq-orders-quick-info">
                                        @* Location Popover *@
                                        <button type="button"
                                                class="yq-quick-btn yq-quick-btn--location"
                                                data-bs-toggle="popover"
                                                data-bs-trigger="click"
                                                data-bs-placement="top"
                                                data-bs-custom-class="yq-quick-popover yq-quick-popover--location"
                                                data-yq-popover-type="location"
                                                data-yq-customer-name="@customerName"
                                                data-yq-recipient-name="@district"
                                                data-yq-recipient-phone="@recipientPhone"
                                                data-yq-governorate="@governorate"
                                                data-yq-region="@region"
                                                data-yq-details-url="@Url.Action("Details", "Orders", new { area = "Admin", id = order.Id })"
                                                aria-label="معلومات التوصيل">
                                            <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
                                        </button>

                                        @* Payment Popover *@
                                        <button type="button"
                                                class="yq-quick-btn yq-quick-btn--payment"
                                                data-bs-toggle="popover"
                                                data-bs-trigger="click"
                                                data-bs-placement="top"
                                                data-bs-custom-class="yq-quick-popover yq-quick-popover--payment"
                                                data-yq-popover-type="payment"
                                                data-yq-payment-method="@paymentMethod"
                                                data-yq-status-label="@statusLabel"
                                                data-yq-details-url="@Url.Action("Details", "Orders", new { area = "Admin", id = order.Id })"
                                                aria-label="معلومات الدفع">
                                            <i class="bi bi-credit-card-fill" aria-hidden="true"></i>
                                        </button>

                                        @* Receipt Popover *@
                                        <button type="button"
                                                class="yq-quick-btn yq-quick-btn--receipt"
                                                data-bs-toggle="popover"
                                                data-bs-trigger="click"
                                                data-bs-placement="top"
                                                data-bs-custom-class="yq-quick-popover yq-quick-popover--receipt"
                                                data-yq-popover-type="receipt"
                                                data-yq-order-id="@order.Id"
                                                data-yq-receipt-image="@receiptImage"
                                                aria-label="إيصال الدفع">
                                            <i class="bi bi-receipt-cutoff" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </td>
                                <td data-label="الإجراءات">
                                    <div class="yq-orders-action-stack">
                                        <a asp-action="Details" asp-route-id="@order.Id" class="yq-orders-detail-link">
                                            <i class="bi bi-eye" aria-hidden="true"></i>
                                            <span>التفاصيل</span>
                                        </a>
                                        <form class="yq-orders-actions yq-ajax-status-form" data-order-id="@order.Id" aria-label="تحديث حالة الطلب رقم @order.Id">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="Id" value="@order.Id" />
                                            <input type="hidden" name="search" value="@search" />
                                            <input type="hidden" name="page" value="@Model.Orders.CurrentPage" />
                                            <input type="hidden" name="pageSize" value="@Model.Orders.PageSize" />
                                            @foreach (var filterStatus in selectedStatus)
                                            {
                                                <input type="hidden" name="filterStatus" value="@filterStatus" />
                                            }
                                            <label class="visually-hidden" for="orderStatus-@order.Id">تحديث حالة الطلب رقم @order.Id</label>
                                            <select id="orderStatus-@order.Id" name="Status" class="yq-orders-status-select" data-original-status="@order.Status">
                                                <option value="Pending" selected="@(order.Status == "Pending")">قيد الانتظار</option>
                                                <option value="Processed" selected="@(order.Status == "Processed")">تم الدفع</option>
                                                <option value="Shipped" selected="@(order.Status == "Shipped")">تم الشحن</option>
                                                <option value="Delivered" selected="@(order.Status == "Delivered")">تم التوصيل</option>
                                                <option value="Cancelled" selected="@(order.Status == "Cancelled")">ملغي</option>
                                                <option value="Refunded" selected="@(order.Status == "Refunded")">مرتجع</option>
                                            </select>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @await Html.PartialAsync("_AdminPager", Model.Orders, pagerViewData)
        }
        else
        {
            <div class="yq-orders-empty" role="status">
                <i class="bi bi-receipt" aria-hidden="true"></i>
                <h3>لا توجد طلبات</h3>
                @if (hasActiveFilters)
                {
                    <p>لا توجد نتائج مطابقة للبحث أو الفلاتر الحالية. جرّب تعديل معايير التصفية أو مسحها.</p>
                    <a asp-action="Index" class="btn-yaqut-gold">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                        <span>مسح الفلاتر</span>
                    </a>
                }
                else
                {
                    <p>ستظهر طلبات العملاء هنا بمجرد توفرها من النظام.</p>
                }
            </div>
        }
    </section>
</section>

<!-- Receipt Modal -->
<div class="modal fade" id="receiptModal" tabindex="-1" aria-labelledby="receiptModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content yq-receipt-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="receiptModalTitle">
                    <i class="bi bi-receipt-cutoff"></i> معاينة إيصال الدفع - طلب رقم #<span id="modalOrderId"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body text-center p-3">
                <img id="modalReceiptImg" src="" alt="إيصال الدفع" class="img-fluid rounded" style="max-height: 75vh; object-fit: contain;" />
            </div>
            <div class="modal-footer">
                <a id="modalReceiptDownload" href="" target="_blank" class="btn-yaqut-gold">
                    <i class="bi bi-box-arrow-up-right"></i> فتح الصورة بالحجم الكامل
                </a>
                <button type="button" class="btn-yaqut-outline" data-bs-dismiss="modal">إغلاق</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/orders/index.js" asp-append-version="true" defer></script>
}
