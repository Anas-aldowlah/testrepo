@model IEnumerable<YAGOT_2._0.Models.Order>
@{
    ViewData["Title"] = "إدارة الطلبات";
}

<div class="yaqut-admin-header">
    <h1><i class="bi bi-receipt"></i> إدارة الطلبات</h1>
</div>

@{
    var selectedStatus = ViewBag.SelectedStatus as string[] ?? Array.Empty<string>();
}

<form method="get" class="glass-effect p-4 mb-4">

    <div class="row">

        <!-- البحث -->
        <div class="col-lg-4">

            <label class="fw-bold mb-2">
                البحث
            </label>

            <div class="input-group">

                <input type="text"
                       class="form-control"
                       name="search"
                       value="@ViewBag.Search"
                       placeholder="اسم العميل أو رقم التتبع..." />

                <button class="btn-yaqut-gold" type="submit">
                    <i class="bi bi-search"></i>
                    بحث
                </button>

            </div>

        </div>

        <!-- فلترة الحالة -->

        <div class="col-lg-8">

            <label class="fw-bold mb-2">
                فلترة حسب حالة الطلب
            </label>

            <div class="d-flex flex-wrap gap-4">

                <div class="form-check">
                    <input class="form-check-input"
                           type="checkbox"
                           name="status"
                           value="Pending"
                           @(selectedStatus.Contains("Pending") ? "checked" : "") />

                    <label class="form-check-label">
                        قيد الانتظار
                    </label>
                </div>

                <div class="form-check">

                    <input class="form-check-input"
                           type="checkbox"
                           name="status"
                           value="Processed"
                           @(selectedStatus.Contains("Processed") ? "checked" : "") />

                    <label class="form-check-label">
                        قيد المعالجة
                    </label>

                </div>

                <div class="form-check">

                    <input class="form-check-input"
                           type="checkbox"
                           name="status"
                           value="Shipped"
                           @(selectedStatus.Contains("Shipped") ? "checked" : "") />

                    <label class="form-check-label">
                        تم الشحن
                    </label>

                </div>

                <div class="form-check">

                    <input class="form-check-input"
                           type="checkbox"
                           name="status"
                           value="Delivered"
                           @(selectedStatus.Contains("Delivered") ? "checked" : "") />

                    <label class="form-check-label">
                        تم التوصيل
                    </label>

                </div>

                <div class="form-check">

                    <input class="form-check-input"
                           type="checkbox"
                           name="status"
                           value="Cancelled"
                           @(selectedStatus.Contains("Cancelled") ? "checked" : "") />

                    <label class="form-check-label">
                        ملغي
                    </label>

                </div>

            </div>

            <div class="mt-3">

                <button class="btn-yaqut-gold">
                    تطبيق الفلتر
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    إلغاء
                </a>

            </div>

        </div>

    </div>

</form>
@if (Model.Any())
{
    <div class="yaqut-order-admin-grid">
        @foreach (var order in Model)
        {
            string stateAr = order.Status switch
            {
                "Pending" => "قيد الانتظار",
                "Processed" => "قيد المعالجة",
                "Shipped" => "تم الشحن",
                "Delivered" => "تم التوصيل",
                _ => "ملغي"
            };

            <article class="yaqut-order-admin-card glass-effect">
                <div class="yaqut-data-row">
                    <span class="yaqut-data-label"># المعرف</span>
                    <span class="yaqut-data-value">@order.Id</span>
                </div>
                <div class="yaqut-data-row">
                    <span class="yaqut-data-label">رقم التتبع</span>
                    <span class="yaqut-data-value text-warning">@order.Trackingnumber</span>
                </div>
                <div class="yaqut-data-row">
                    <span class="yaqut-data-label">العميل</span>
                    <span class="yaqut-data-value">@(order.User?.Name ?? "غير معروف")</span>
                </div>
                <div class="yaqut-data-row">
                    <span class="yaqut-data-label">الإجمالي</span>
                    <span class="yaqut-data-value">@order.Totalamount.ToString("N0") ر.س</span>
                </div>
                <div class="yaqut-data-row">
                    <span class="yaqut-data-label">الحالة</span>
                    <span class="yaqut-data-value"><span class="badge badge-@order.Status.ToLower()">@stateAr</span></span>
                </div>
                <div class="yaqut-data-row">
                    <span class="yaqut-data-label">التاريخ</span>
                    <span class="yaqut-data-value">@(order.Orderdate.HasValue? order.Orderdate.Value.ToString("dd/MM/yyyy") : "-")</span>
                </div>
                <div class="yaqut-data-row">
                    <span class="yaqut-data-label">تاريخ الحالة</span>
                    <span class="yaqut-data-value">@(order.TimeState.HasValue? order.TimeState.Value.ToString("dd/MM/yyyy") : "-")</span>
                </div>

                <div class="mt-2">
                    <span class="yaqut-data-label d-block mb-1">المنتجات المطلوبة</span>
                    <table class="yaqut-admin-items-table">
                        <thead>
                            <tr>
                                <th>اسم المنتج</th>
                                <th>الكمية</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var orderItem in order.Orderitems)
                            {
                                <tr>
                                    <td>@orderItem.Product.Name</td>
                                    <td>@orderItem.Quantity</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <form asp-action="UpdateStatus" method="post" class="yaqut-status-form">
                    <input type="hidden" name="Id" value="@order.Id" />
                    <label class="yaqut-data-label">تحديث الحالة</label>
                    <div class="d-flex gap-2 mt-1">
                        <select name="Status" class="yaqut-status-select">
                            <option value="Pending" selected="@(order.Status == "Pending")">قيد الانتظار</option>
                            <option value="Processed" selected="@(order.Status == "Processed")">قيد المعالجة</option>
                            <option value="Shipped" selected="@(order.Status == "Shipped")">تم الشحن</option>
                            <option value="Delivered" selected="@(order.Status == "Delivered")">تم التوصيل</option>
                            <option value="Cancelled" selected="@(order.Status == "Cancelled")">ملغي</option>
                        </select>
                        <button type="submit" class="btn-yaqut-gold btn-sm">تحديث</button>
                    </div>
                </form>
            </article>
        }
    </div>
}
else
{
    <p class="text-muted">لا توجد طلبات بعد.</p>
}
