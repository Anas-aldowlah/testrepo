@model YAGOT_2._0.Models.Order
@using YAGOT_2._0.Services
@inject DealingAPI DealingApiService
@inject YAGOT_2._0.Core.Capabilities.ICapabilityEvaluator CapabilityEvaluator
@{
    ViewData["Title"] = $"تفاصيل الطلب #{Model.Id}";

    var items = Model.Orderitems?.ToList() ?? new List<YAGOT_2._0.Models.Orderitem>();
    var itemCount = items.Sum(item => item.Quantity);
    var subtotal = items.Sum(item => item.Quantity * item.Unitprice);
    var totalAdjustment = Model.Totalamount - subtotal;
    var customerName = Model.User?.Name ?? "عميل غير معروف";
    var customerPhone = DealingApiService.DecryptPhone(Model.User?.Phone ?? string.Empty);
    var customerEmail = Model.User?.Email;
    var delivery = Model.Deliveryorder;
    var recipientName = !string.IsNullOrWhiteSpace(delivery?.Fullname)
        ? delivery.Fullname
        : customerName;
    var deliveryPhones = new[] { delivery?.Phonenumber, delivery?.Secondphonenumber }
        .Where(phone => !string.IsNullOrWhiteSpace(phone))
        .Distinct()
        .ToArray();
    var recipientPhone = deliveryPhones.Length > 0
        ? string.Join(" / ", deliveryPhones)
        : !string.IsNullOrWhiteSpace(customerPhone) ? customerPhone : "غير متوفر";
    var whatsAppUrl = OrderWhatsAppLinkBuilder.Build(Model, customerPhone);
    var governorate = !string.IsNullOrWhiteSpace(delivery?.Governorate)
        ? delivery.Governorate
        : "غير متوفر";
    var region = !string.IsNullOrWhiteSpace(delivery?.City)
        ? delivery.City
        : "غير متوفر";
    var district = !string.IsNullOrWhiteSpace(delivery?.District)
        ? delivery.District
        : "غير متوفر";
    var paymentPresentations = ViewData["PaymentMethodPresentations"] as IReadOnlyDictionary<string, PaymentMethodPresentation>;
    var paymentPresentation = !string.IsNullOrWhiteSpace(Model.Paymentmethod) &&
        paymentPresentations?.TryGetValue(Model.Paymentmethod, out var configuredPayment) == true
            ? configuredPayment
            : new PaymentMethodPresentation(
                Model.Paymentmethod ?? string.Empty,
                string.IsNullOrWhiteSpace(Model.Paymentmethod) ? "طريقة دفع غير محددة" : "طريقة دفع مسجلة سابقاً",
                string.Empty,
                string.Empty,
                null,
                false);
    var paymentProofEnabled = CapabilityEvaluator.IsFeatureEnabled(YAGOT_2._0.Core.Capabilities.CapabilityFeatureCodes.OrderPaymentProof);
    var receiptUrl = paymentProofEnabled && !string.IsNullOrWhiteSpace(Model.Receipturl)
        ? Url.Action("Receipt", "Orders", new { area = "Admin", id = Model.Id })
        : null;
    var statusLabel = Model.Status switch
    {
        "Pending" => "قيد الانتظار",
        "Paid" => "تم الدفع",
        "Processed" => "قيد التجهيز",
        "Shipped" => "تم الشحن",
        "Delivered" => "تم التوصيل",
        "Cancelled" => "ملغي",
        "Refunded" => "مرتجع",
        _ => Model.Status
    };
    var statusClass = Model.Status switch
    {
        "Pending" => "yq-orders-badge--pending",
        "Paid" => "yq-orders-badge--paid",
        "Processed" => "yq-orders-badge--processed",
        "Shipped" => "yq-orders-badge--shipped",
        "Delivered" => "yq-orders-badge--delivered",
        "Cancelled" => "yq-orders-badge--cancelled",
        "Refunded" => "yq-orders-badge--cancelled",
        _ => "yq-orders-badge--neutral"
    };
    var statusSteps = new[] { "Pending", "Paid", "Processed", "Shipped", "Delivered" };
    var isConflictAwaitingDecision = Model.Workflowstate == OrderWorkflowStates.ConflictAwaitingDecision;
    var hasPaymentReview = Model.Paymentreviewedat.HasValue && Model.Paymentreviewedbyuserid.HasValue;
    var isLegacyConflictAwaitingReview = isConflictAwaitingDecision &&
        !Model.Paymentreviewedat.HasValue &&
        !Model.Paymentreviewedbyuserid.HasValue;
    var isTerminal = Model.Status is OrderStatuses.Cancelled or OrderStatuses.Delivered or OrderStatuses.Refunded;
    var canVerifyPayment = paymentProofEnabled && Model.Status == "Pending" &&
        !Model.Stockdeducted &&
        !Model.Paymentverifiedat.HasValue &&
        !Model.Paymentverifiedbyuserid.HasValue &&
        ((!Model.Paymentreviewedat.HasValue &&
          !Model.Paymentreviewedbyuserid.HasValue &&
          string.IsNullOrWhiteSpace(Model.Workflowstate)) ||
         isLegacyConflictAwaitingReview) &&
        Model.Paymentstatus is "Unpaid" or "Pending";
    var paymentStatusLabel = isConflictAwaitingDecision
        ? hasPaymentReview
            ? "تمت مراجعة الدفع — بانتظار قرار العميل"
            : "يلزم إعادة مراجعة الدفع"
        : Model.Paymentstatus switch
    {
        "Paid" => "تم التحقق من الدفع",
        "Pending" => "بانتظار مراجعة الدفع",
        "Refunded" => "تم تسجيل الاسترداد",
        _ => "غير مدفوع"
    };
    var currentStepIndex = Array.IndexOf(statusSteps, Model.Status);
    var isCancelled = Model.Status == OrderStatuses.Cancelled;
    if (currentStepIndex < 0)
    {
        currentStepIndex = 0;
    }

    var stepLabels = new Dictionary<string, string>
    {
        ["Pending"] = "استلام الطلب",
        ["Paid"] = "تم الدفع",
        ["Processed"] = "المعالجة",
        ["Shipped"] = "الشحن",
        ["Delivered"] = "التوصيل"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/orders.css" asp-append-version="true" />
}

@section Breadcrumb {
    <span>/</span>
    <a asp-action="Index">الطلبات</a>
    <span>/</span>
    <span>#@Model.Id</span>
}

<section class="yq-order-details-admin"
         aria-labelledby="orderDetailsTitle"
         data-yq-order-details
         data-yq-update-status-url="@Url.Action("UpdateStatus")"
         data-yq-update-admin-note-url="@Url.Action("UpdateAdminNote")">
    <header class="yq-order-details-hero">
        <div class="yq-order-details-hero__content">
            <a asp-action="Index" class="yq-order-details-back">
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
                <span>العودة إلى الطلبات</span>
            </a>
            <span class="yq-orders-eyebrow">إدارة الطلب</span>
            <h2 id="orderDetailsTitle">تفاصيل الطلب #@Model.Id</h2>
            <p>واجهة موحدة لمراجعة بيانات العميل، حالة التنفيذ، المنتجات المطلوبة، وإجراءات تحديث الطلب باستخدام البيانات المتوفرة من النظام.</p>
        </div>

        <div class="yq-order-details-hero__status">
            <span class="yq-orders-badge @statusClass">@statusLabel</span>
            <strong>@(Model.Totalamount.ToYaqutPrice())</strong>

        </div>
    </header>

    @if (isConflictAwaitingDecision)
    {
        <div class="yq-orders-conflict-badge" role="status">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            <span>@(hasPaymentReview ? "الطلب بانتظار قرار العميل بشأن الكمية المتوفرة. لا يلزم التحقق من الدفع مرة أخرى." : "لم تكتمل مراجعة الدفع لهذا الطلب. راجع الدفع لإرسال الخيارات إلى العميل.")</span>
        </div>
    }

    <section class="yq-order-details-summary" aria-label="ملخص الطلب">
        <article class="yq-order-detail-card yq-order-detail-card--summary">
            <span class="yq-order-detail-card__icon"><i class="bi bi-receipt" aria-hidden="true"></i></span>
            <div>
                <p>رقم التتبع</p>
                <strong>@(!string.IsNullOrWhiteSpace(Model.Trackingnumber) ? Model.Trackingnumber : "غير متوفر")</strong>
            </div>
        </article>
        <article class="yq-order-detail-card yq-order-detail-card--summary">
            <span class="yq-order-detail-card__icon"><i class="bi bi-calendar2-check" aria-hidden="true"></i></span>
            <div>
                <p>تاريخ الطلب</p>
                <strong>@(Model.Orderdate.HasValue ? Model.Orderdate.Value.ToString("dd/MM/yyyy HH:mm") : "غير متوفر")</strong>
            </div>
        </article>
        <article class="yq-order-detail-card yq-order-detail-card--summary">
            <span class="yq-order-detail-card__icon"><i class="bi bi-clock-history" aria-hidden="true"></i></span>
            <div>
                <p>آخر تحديث للحالة</p>
                <strong>@(Model.TimeState.HasValue ? Model.TimeState.Value.ToString("dd/MM/yyyy HH:mm") : "غير متوفر")</strong>
            </div>
        </article>
    </section>

    <div class="yq-order-details-layout">
        <div class="yq-order-details-main">
            <section class="yq-order-detail-card" aria-labelledby="orderStatusTitle">
                <div class="yq-order-detail-card__header">
                    <div>
                        <span class="yq-orders-eyebrow">حالة الطلب</span>
                        <h3 id="orderStatusTitle">مسار التنفيذ</h3>
                    </div>
                    <span class="yq-orders-badge @statusClass">@statusLabel</span>
                </div>

                @if (isCancelled)
                {
                    <div class="yq-order-details-state-note yq-order-details-state-note--danger" role="status">
                        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                        <span>تم إلغاء الطلب نهائياً.</span>
                    </div>
                }
                else
                {
                    <ol class="yq-order-details-timeline" aria-label="خطوات حالة الطلب">
                        @for (var i = 0; i < statusSteps.Length; i++)
                        {
                            var isDone = i < currentStepIndex;
                            var isActive = i == currentStepIndex;
                            <li class="@(isDone ? "is-done" : "") @(isActive ? "is-active" : "")">
                                <span class="yq-order-details-timeline__dot" aria-hidden="true">
                                    @if (isDone)
                                    {
                                        <i class="bi bi-check-lg"></i>
                                    }
                                    else
                                    {
                                        @(i + 1)
                                    }
                                </span>
                                <span>@stepLabels[statusSteps[i]]</span>
                            </li>
                        }
                    </ol>
                }
            </section>

            <section class="yq-order-detail-card" aria-labelledby="orderProductsTitle">
                <div class="yq-order-detail-card__header">
                    <div>
                        <span class="yq-orders-eyebrow">المنتجات</span>
                        <h3 id="orderProductsTitle">المنتجات المطلوبة</h3>
                    </div>
                    <span class="yq-order-detail-card__meta">@items.Count منتج</span>
                </div>

                @if (items.Any())
                {
                    <div class="yq-order-products-wrap">
                        <table class="yq-order-products-table">
                            <thead>
                                <tr>
                                    <th scope="col">المنتج</th>
                                    <th scope="col">سعر الوحدة</th>
                                    <th scope="col">المطلوب</th>
                                    <th scope="col">المتاح عند الفحص</th>
                                    <th scope="col">غير المتوفر</th>
                                    <th scope="col">المنفذ</th>
                                    <th scope="col">الإجمالي</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in items)
                                {
                                    var lineTotal = item.Quantity * item.Unitprice;
                                    var unavailable = item.UnavailableQuantity ?? 0;
                                    var availableAtCheck = Math.Max(0, item.Quantity - unavailable);
                                    <tr>
                                        <td data-label="المنتج">
                                            <div class="yq-order-product">
                                                @if (!string.IsNullOrWhiteSpace(item.Product?.Imageurl))
                                                {
                                                    <img src="@item.Product.Imageurl" alt="@item.Product.Name" loading="lazy" />
                                                }
                                                else
                                                {
                                                    <span class="yq-order-product__placeholder" aria-hidden="true">
                                                        <i class="bi bi-box-seam"></i>
                                                    </span>
                                                }
                                                <div>
                                                    <strong>@(item.Product?.Name ?? "منتج غير متوفر")</strong>
                                                    <span>رقم المنتج: @item.Productid</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td data-label="سعر الوحدة">@(item.Unitprice.ToYaqutPrice())</td>
                                        <td data-label="المطلوب">@item.Quantity</td>
                                        <td data-label="المتاح عند الفحص">@(item.UnavailableQuantity.HasValue ? availableAtCheck.ToString() : "-")</td>
                                        <td data-label="غير المتوفر">@(item.UnavailableQuantity?.ToString() ?? "-")</td>
                                        <td data-label="المنفذ">@(item.FulfilledQuantity?.ToString() ?? "-")</td>
                                        <td data-label="الإجمالي"><strong>@(lineTotal.ToYaqutPrice())</strong></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="yq-order-details-empty" role="status">
                        <i class="bi bi-bag-x" aria-hidden="true"></i>
                        <p>لا توجد منتجات مرتبطة بهذا الطلب في البيانات الحالية.</p>
                    </div>
                }
            </section>

            <section class="yq-order-detail-card" aria-labelledby="customerNotesTitle">
                <div class="yq-order-detail-card__header">
                    <div>
                        <span class="yq-orders-eyebrow">ملاحظات العميل</span>
                        <h3 id="customerNotesTitle">ملاحظات التوصيل (العميل)</h3>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="yq-order-details-state-note">
                        <i class="bi bi-chat-left-text" aria-hidden="true"></i>
                        <span>@Model.Notes</span>
                    </div>
                }
                else
                {
                    <div class="yq-order-details-state-note">
                        <i class="bi bi-chat-left-text" aria-hidden="true"></i>
                        <span>لا توجد ملاحظات توصيل من العميل.</span>
                    </div>
                }
            </section>

            <section class="yq-order-detail-card" aria-labelledby="adminNotesTitle" data-yq-admin-note-section>
                <div class="yq-order-detail-card__header">
                    <div>
                        <span class="yq-orders-eyebrow">ملاحظات الإدارة</span>
                        <h3 id="adminNotesTitle">ملاحظة الإدارة</h3>
                    </div>
                    <button type="button" class="btn-yaqut-outline yq-edit-note-btn" data-yq-edit-admin-note data-order-id="@Model.Id" data-current-note="@Model.AdminNote">
                        <i class="bi @(string.IsNullOrWhiteSpace(Model.AdminNote) ? "bi-plus-lg" : "bi-pencil-square")" aria-hidden="true"></i>
                        <span>@(string.IsNullOrWhiteSpace(Model.AdminNote) ? "إضافة ملاحظة" : "تعديل الملاحظة")</span>
                    </button>
                </div>
                <div data-yq-admin-note-display>
                    @if (!string.IsNullOrWhiteSpace(Model.AdminNote))
                    {
                        <div class="yq-order-details-state-note">
                            <i class="bi bi-shield-check" aria-hidden="true"></i>
                            <span data-yq-admin-note-text>@Model.AdminNote</span>
                        </div>
                    }
                    else
                    {
                        <div class="yq-order-details-state-note">
                            <i class="bi bi-shield" aria-hidden="true"></i>
                            <span data-yq-admin-note-text>لا توجد ملاحظة مسجلة من الإدارة.</span>
                        </div>
                    }
                </div>
            </section>
        </div>

        <aside class="yq-order-details-side" aria-label="تفاصيل مرتبطة بالطلب">
            <section class="yq-order-detail-card" aria-labelledby="orderActionsTitle">
                <div class="yq-order-detail-card__header">
                    <div>
                        <span class="yq-orders-eyebrow">الإجراءات</span>
                        <h3 id="orderActionsTitle">تحديث الحالة</h3>
                    </div>
                </div>

                <form asp-action="UpdateStatus" method="post" class="yq-order-status-form" data-yq-status-form data-yq-terminal="@isTerminal.ToString().ToLowerInvariant()" data-yq-customer-resolved-conflict="@(Model.Workflowstate == OrderWorkflowStates.ConflictResolvedContinue ? "true" : "false")">
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <input type="hidden" name="returnToDetails" value="true" />
                    <label for="orderStatus">حالة الطلب الحالية</label>
                    <select id="orderStatus" name="Status" class="yq-orders-status-select" data-original-status="@Model.Status" disabled="@(isTerminal || isConflictAwaitingDecision)">
                        <option value="@Model.Status" selected>@statusLabel</option>
                        @foreach (var targetStatus in OrderStatusPolicy.GetAllowedTargets(Model.Status))
                        {
                            var targetLabel = targetStatus switch
                            {
                                "Processed" => "قيد التجهيز",
                                "Shipped" => "تم الشحن",
                                "Delivered" => "تم التوصيل",
                                "Cancelled" => "ملغي",
                                _ => targetStatus
                            };
                            <option value="@targetStatus">@targetLabel</option>
                        }
                    </select>
                    <button type="submit" class="btn-yaqut-gold" data-yq-save-status disabled>
                        <i class="bi bi-check2-circle" aria-hidden="true"></i>
                        <span>حفظ الحالة</span>
                    </button>
                </form>

                <hr />
                <dl class="yq-order-info-list">
                    <div>
                        <dt>حالة التحقق من الدفع</dt>
                        <dd>@paymentStatusLabel</dd>
                    </div>
                    @if (Model.Paymentverifiedat.HasValue)
                    {
                        <div>
                            <dt>وقت التحقق</dt>
                            <dd>@Model.Paymentverifiedat.Value.ToString("dd/MM/yyyy HH:mm")</dd>
                        </div>
                        <div><dt>المراجعة</dt><dd>تمت بواسطة مسؤول.</dd></div>
                    }
                </dl>
                @if (paymentProofEnabled)
                {
                <form asp-action="VerifyPayment" method="post" class="yq-order-status-form" data-yq-verify-payment>
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn-yaqut-gold yq-orders-verify-btn" disabled="@(!canVerifyPayment)">
                        <i class="bi bi-shield-check" aria-hidden="true"></i>
                        <span>تحقق من الدفع</span>
                    </button>
                </form>
                }
                @if (isConflictAwaitingDecision)
                {
                    var conflictLines = string.Join("||", items
                        .Where(item => (item.UnavailableQuantity ?? 0) > 0)
                        .OrderBy(item => item.Id)
                        .Select(item => $"{item.Product?.Name}: المتاح {Math.Max(0, item.Quantity - (item.UnavailableQuantity ?? 0))} من {item.Quantity}"));
                    <button type="button"
                            class="yq-orders-conflict-badge yq-workflow-fill"
                            data-yq-conflict-info
                            data-yq-conflict-title="@(hasPaymentReview ? "مراجعة العميل مطلوبة" : "مراجعة الدفع مطلوبة")"
                            data-yq-conflict-message="@(hasPaymentReview ? "يمكن للعميل اختيار الكمية المتوفرة أو إزالة المنتج أو إلغاء الطلب." : "لم تكتمل مراجعة الدفع لهذا الطلب. راجع الدفع لإرسال الخيارات إلى العميل.")"
                            data-yq-conflict-lines="@conflictLines"
                            data-yq-whatsapp-url="@whatsAppUrl">مراجعة العميل مطلوبة</button>
                }
            </section>

            <section class="yq-order-detail-card" aria-labelledby="customerInfoTitle">
                <div class="yq-order-detail-card__header">
                    <div>
                        <span class="yq-orders-eyebrow">العميل</span>
                        <h3 id="customerInfoTitle">معلومات العميل</h3>
                    </div>
                </div>
                <dl class="yq-order-info-list">
                    <div>
                        <dt>الاسم</dt>
                        <dd>@customerName</dd>
                    </div>
                    <div>
                        <dt>رقم الهاتف</dt>
                        <dd>@(!string.IsNullOrWhiteSpace(customerPhone) ? customerPhone : "غير متوفر")</dd>
                    </div>
                    <div>
                        <dt>البريد الإلكتروني</dt>
                        <dd>@(!string.IsNullOrWhiteSpace(customerEmail) ? customerEmail : "غير متوفر")</dd>
                    </div>
                </dl>
            </section>

            <section class="yq-order-detail-card" aria-labelledby="shippingInfoTitle">
                <div class="yq-order-detail-card__header">
                    <div>
                        <h3 id="shippingInfoTitle">معلومات التوصيل والمستلم</h3>
                    </div>
                </div>
                <dl class="yq-order-info-list">
                    <div>
                        <dt>اسم المستلم</dt>
                        <dd>@district</dd>
                    </div>
                    <div>
                        <dt>رقم الجوال</dt>
                        <dd dir="ltr">@recipientPhone</dd>
                    </div>
                    <div>
                        <dt>المحافظة</dt>
                        <dd>@governorate</dd>
                    </div>
                    <div>
                        <dt>المنطقة</dt>
                        <dd>@region</dd>
                    </div>
                </dl>
            </section>

            <section class="yq-order-detail-card" aria-labelledby="paymentInfoTitle">
                <div class="yq-order-detail-card__header">
                    <div>
                        <h3 id="paymentInfoTitle">معلومات الدفع</h3>
                    </div>
                </div>
                <dl class="yq-order-info-list">
                    <div>
                        <dt>طريقة الدفع</dt>
                        <dd>@paymentPresentation.Name</dd>
                    </div>
                    <div>
                        <dt>تفاصيل الدفع</dt>
                        <dd>@paymentPresentation.Description</dd>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(paymentPresentation.AccountHolderName))
                    {
                        <div>
                            <dt>اسم الحساب</dt>
                            <dd>@paymentPresentation.AccountHolderName</dd>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(paymentPresentation.AccountNumber))
                    {
                        <div>
                            <dt>رقم الحساب</dt>
                            <dd dir="ltr">@paymentPresentation.AccountNumber</dd>
                        </div>
                    }
                </dl>
                <div class="yq-receipt-wrapper">
                    @if (!string.IsNullOrWhiteSpace(receiptUrl))
                    {
                        <a href="@receiptUrl" target="_blank" class="yq-order-receipt-link yq-receipt-link">
                            <img src="@receiptUrl" alt="إيصال الدفع" class="img-fluid rounded yq-receipt-img" />
                        </a>
                    }
                    else
                    {
                        <div class="yq-receipt-empty" role="status">
                            <i class="bi bi-image yq-receipt-empty-icon" aria-hidden="true" ></i>
                            <p class="yq-receipt-empty-text">لم يتم رفع صورة اشعار الدفع</p>
                        </div>
                    }
                </div>
            </section>

            <section class="yq-order-detail-card" aria-labelledby="orderTotalsTitle">
                <div class="yq-order-detail-card__header">
                    <div>
                        <span class="yq-orders-eyebrow">الإجماليات</span>
                        <h3 id="orderTotalsTitle">ملخص المبالغ</h3>
                    </div>
                </div>
                <dl class="yq-order-totals">
                    <div>
                        <dt>إجمالي المنتجات</dt>
                        <dd>@(subtotal.ToYaqutPrice())</dd>
                    </div>
                    <div>
                        <dt>الشحن</dt>
                        <dd>شحن مجاني</dd>
                    </div>
                    @if (totalAdjustment != 0)
                    {
                        <div>
                            <dt>فروقات مسجلة</dt>
                            <dd>@(totalAdjustment.ToYaqutPrice())</dd>
                        </div>
                    }
                    <div class="yq-order-totals__total">
                        <dt>المبلغ الأصلي المدفوع</dt>
                        <dd>@(Model.Totalamount.ToYaqutPrice())</dd>
                    </div>
                    <div>
                        <dt>قيمة الطلب المنفذ</dt>
                        <dd>@(Model.Finalfulfilledamount.HasValue ? $"{Model.Finalfulfilledamount.Value.ToYaqutPrice()}" : "لم تتحدد بعد")</dd>
                    </div>
                </dl>
            </section>
        </aside>
    </div>
</section>

@await Html.PartialAsync("_YaqutOperationDialog")

@section Scripts {
    <script src="~/js/admin/orders/details.js" asp-append-version="true" defer></script>
}
