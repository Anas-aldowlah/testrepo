@model YAGOT_2._0.Models.Admin.OpenSalesDayViewModel
@{
    ViewData["Title"] = "فتح يوم بيع جديد";
}

@section Breadcrumb {
    <span>/</span>
    <a asp-action="Index">البيع السريع</a>
    <span>/</span>
    <span>فتح يوم بيع</span>
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        @if (TempData["WarningMessage"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show mb-4 rounded-3 shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["WarningMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-dark text-white p-4" style="background: linear-gradient(135deg, #111622 0%, #1e293b 100%) !important;">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle p-2 bg-warning bg-opacity-25 text-warning">
                        <i class="bi bi-calendar-plus-fill fs-3"></i>
                    </div>
                    <div>
                        <h4 class="h5 fw-bold mb-1 text-white">فتح يوم بيع جديد (Sales Day)</h4>
                        <p class="text-white-50 small mb-0">إعداد دفتر مبيعات المحل لليوم وتحديد العهدة الافتتاحية</p>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="OpenDay" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label asp-for="Date" class="form-label fw-bold">تاريخ اليوم <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-calendar3"></i></span>
                            <input asp-for="Date" type="date" id="openDayDateInput" class="form-control form-control-lg" max="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required />
                        </div>
                        <span asp-validation-for="Date" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="OpeningBalance" class="form-label fw-bold">الرصيد/العهدة الافتتاحية (اختياري)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">ر.س</span>
                            <input asp-for="OpeningBalance" type="number" step="0.01" min="0" class="form-control form-control-lg" placeholder="0.00" />
                        </div>
                        <div class="form-text small">المبلغ النقدي المتوفر في صندوق المحل عند بداية اليوم لتسهيل عملية إرجاع الفكة.</div>
                        <span asp-validation-for="OpeningBalance" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-bold">ملاحظات الإفتاح (اختياري)</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="أدخل أي ملاحظات خاصة ببداية هذا اليوم..."></textarea>
                    </div>

                    <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 fw-bold">إلغاء</a>
                        <button type="submit" class="btn btn-yaqut-gold px-5 py-2 fw-bold shadow-sm">
                            <i class="bi bi-check-circle-fill me-1"></i> تأكيد وفتح اليوم
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var dateInput = document.getElementById('openDayDateInput');
            if (dateInput) {
                var tomorrow = new Date();
                tomorrow.setDate(tomorrow.getDate() + 1);
                var maxStr = tomorrow.toISOString().split('T')[0];
                dateInput.setAttribute('max', maxStr);
            }
        });
    </script>
}
