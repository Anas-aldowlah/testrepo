@model YAGOT_2._0.Models.Admin.SalesDayLedgerViewModel
@{
    ViewData["Title"] = $"دفتر اليوم - {Model.SalesDay.Date:yyyy/MM/dd}";
    var isOpen = Model.SalesDay.Status == "Open";
}

@functions {
    public static string FormatMethodCode(string? code)
    {
        if (string.IsNullOrWhiteSpace(code)) return "cash";
        if (code.StartsWith("custom-", StringComparison.OrdinalIgnoreCase) || code.Length > 20 || Guid.TryParse(code, out _))
        {
            return "custom";
        }
        return code;
    }
}

@section Breadcrumb {
    <span>/</span>
    <a asp-action="Index">البيع السريع</a>
    <span>/</span>
    <span>دفتر اليوم</span>
}

@Html.AntiForgeryToken()
<div class="container-fluid px-0">
    <!-- HEADER STATUS BAR -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-journal-check text-warning me-2"></i>
                دفتر المبيعات اليومي (Daily Ledger)
            </h2>
            <p class="text-muted small mb-0">
                تاريخ دفتر البيع: <strong class="text-dark">@Model.SalesDay.Date.ToString("yyyy/MM/dd")</strong> |
                الحالة:
                @if (isOpen)
                {
                    <span class="badge bg-success text-white px-3 py-1 fw-bold">مفتوح</span>
                }
                else
                {
                    <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary border-opacity-50 px-3 py-1">مغلق (للقراءة فقط)</span>
                }
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (isOpen)
            {
                <a asp-action="NewSale" class="btn btn-yaqut-gold fw-bold px-3 py-2 shadow-sm">
                    <i class="bi bi-cart-plus-fill me-1"></i> بيع جديد
                </a>
                <button type="button" class="btn btn-danger fw-bold px-3 py-2 shadow-sm" id="btnOpenCloseModal">
                    <i class="bi bi-lock-fill me-1"></i> إغلاق يوم البيع
                </button>
            }
            <a asp-action="History" class="btn btn-outline-secondary px-3 py-2 fw-bold">
                <i class="bi bi-clock-history me-1"></i> سجل الأيام السابقة
            </a>
            <a asp-action="Index" class="btn btn-outline-dark px-3 py-2 fw-bold">الرئيسية</a>
        </div>
    </div>

    <!-- FINANCIAL SUMMARY CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-warning">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block mb-1">عدد العمليات المكتملة</span>
                        <h3 class="fw-bold mb-0 text-dark">@Model.CompletedSalesCount <small class="fs-6 text-muted">عملية</small></h3>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-3">
                        <i class="bi bi-receipt fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-success">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block mb-1">إجمالي مبيعات اليوم</span>
                        <h3 class="fw-bold mb-0 text-success">@(Model.TotalSalesAmount.ToYaqutPrice())</h3>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-3">
                        <i class="bi bi-currency-dollar fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-info">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block mb-1">العهدة الافتتاحية</span>
                        <h3 class="fw-bold mb-0 text-dark">@(Model.SalesDay.OpeningBalance.ToYaqutPrice())</h3>
                    </div>
                    <div class="rounded-circle bg-info bg-opacity-10 text-info p-3">
                        <i class="bi bi-wallet2 fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-primary">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block mb-1">الصافي الإجمالي</span>
                        <h3 class="fw-bold mb-0 text-primary">@(Model.NetTotalAmount.ToYaqutPrice())</h3>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3">
                        <i class="bi bi-graph-up-arrow fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- DYNAMIC PAYMENT METHOD BREAKDOWN -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
        <div class="card-header bg-white py-3 px-4 border-bottom">
            <h5 class="card-title fw-bold mb-0 text-dark">
                <i class="bi bi-pie-chart-fill text-warning me-2"></i> توزيع التحصيل حسب وسيلة الدفع (Dynamic Payments)
            </h5>
        </div>
        <div class="card-body p-4">
            @if (!Model.PaymentTotals.Any())
            {
                <div class="text-center text-muted py-3">
                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                    لا توجد عمليات بيع مسددة في هذا اليوم بعد.
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var pm in Model.PaymentTotals)
                    {
                        <div class="col-12 col-sm-6 col-md-4 col-xl-3">
                            <div class="card h-100 border-0 shadow-sm rounded-3 bg-light p-3 position-relative">
                                <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                                    <div class="overflow-hidden yq-min-w-0">
                                        <span class="fw-bold text-dark d-block text-truncate mb-1" title="@pm.PaymentMethodName">
                                            <i class="bi bi-wallet2 text-warning me-1"></i>@pm.PaymentMethodName
                                        </span>
                                        
                                    </div>
                                </div>
                                <div class="mt-auto pt-2 border-top border-secondary border-opacity-10 d-flex align-items-baseline justify-content-between flex-wrap gap-1">
                                    <span class="text-muted small">إجمالي التحصيل:</span>
                                    <strong class="fs-5 text-warning fw-bold text-nowrap">
                                        @(pm.TotalAmount.ToYaqutPrice())
                                    </strong>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- COMPLETED SALES TABLE -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white py-3 px-4 d-flex align-items-center justify-content-between border-bottom">
            <h5 class="card-title fw-bold mb-0 text-dark">
                <i class="bi bi-list-check text-warning me-2"></i> سجل العمليات المكتملة في هذا اليوم (@Model.CompletedSales.Count)
            </h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 w-100 yq-table-auto">
                <thead class="bg-light">
                    <tr>
                        <th class="yq-th-w18">رقم الفاتورة</th>
                        <th class="yq-th-w15">وقت الاعتماد</th>
                        <th class="yq-th-w14">العميل</th>
                        <th class="yq-th-w25">وسيلة الدفع</th>
                        <th class="yq-th-w10">خصم الفاتورة</th>
                        <th class="yq-th-w10">المبلغ الإجمالي</th>
                        <th class="yq-th-w8 text-end">التفاصيل</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.CompletedSales.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                لا توجد عمليات بيع مكتملة مسجلة في هذا اليوم.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var sale in Model.CompletedSales)
                        {
                            <tr>
                                <td>
                                    <strong class="text-warning text-nowrap">@sale.InvoiceNumber</strong>
                                </td>
                                <td class="pos-text-muted small text-nowrap">
                                    <i class="bi bi-clock me-1"></i>@((sale.CompletedAt ?? sale.CreatedAt).ToString("yyyy/MM/dd HH:mm"))
                                </td>
                                <td>
                                    <span class="text-nowrap">@(string.IsNullOrWhiteSpace(sale.CustomerName) ? "عميل عادي" : sale.CustomerName)</span>
                                </td>
                                <td>
                                    @if (sale.SalePayments != null && sale.SalePayments.Any())
                                    {
                                        <div class="d-flex flex-column gap-1">
                                            @foreach (var sp in sale.SalePayments)
                                            {
                                                <div>
                                                    <span class="badge bg-dark text-warning border border-secondary px-2 py-1 text-wrap text-start">
                                                        <i class="bi bi-wallet2 me-1"></i>@(sp.PaymentMethod?.Name ?? "طريقة دفع") (@FormatMethodCode(sp.PaymentMethod?.Type)): @(sp.Amount.ToYaqutPrice())
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="pos-text-muted">-</span>
                                    }
                                </td>
                                <td class="text-nowrap">@(sale.DiscountTotal > 0 ? sale.DiscountTotal.ToYaqutPrice() : "-")</td>
                                <td class="text-nowrap">
                                    <strong class="fs-6 fw-bold">@(sale.FinalAmount.ToYaqutPrice())</strong>
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-primary fw-bold px-3 text-nowrap yq-btn-view-sale" data-sale-id="@sale.Id">
                                        <i class="bi bi-eye me-1"></i> التفاصيل
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- SALE DETAILS MODAL -->
<div class="modal fade" id="saleDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white p-4 yq-bg-gradient">
                <h5 class="modal-title fw-bold text-white mb-0" id="detailsModalTitle">تفاصيل عملية البيع</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="detailsModalBody">
                <div class="text-center py-4">
                    <span class="spinner-border text-warning"></span>
                    <p class="text-muted small mt-2">جاري تحميل التفاصيل التاريخية للفاتورة...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CLOSE DAY MODAL -->
@if (isOpen)
{
    <div class="modal fade" id="closeDayModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-danger text-white p-4">
                    <h5 class="modal-title fw-bold text-white mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> تأكيد إغلاق يوم البيع
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 text-dark">
                    <p class="mb-3 fw-bold">هل أنت تأكد من رغبتك في إغلاق دفتر المبيعات لهذا اليوم؟</p>

                    <div class="bg-light p-3 rounded-3 mb-4 border">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">تاريخ اليوم:</span>
                            <strong class="text-dark">@Model.SalesDay.Date.ToString("yyyy/MM/dd")</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">عدد العمليات المكتملة:</span>
                            <strong class="text-dark">@Model.CompletedSalesCount عملية</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">إجمالي المبيعات:</span>
                            <strong class="text-success fw-bold">@(Model.TotalSalesAmount.ToYaqutPrice())</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">عدد المسودات المتبقية:</span>
                            <strong class="@(Model.DraftsCount > 0 ? "text-danger" : "text-dark")">@Model.DraftsCount مسودة</strong>
                        </div>
                    </div>

                    @if (Model.DraftsCount > 0)
                    {
                        <div class="alert alert-danger rounded-3 mb-3">
                            <i class="bi bi-x-circle-fill me-2"></i>
                            <strong>لا يمكن إغلاق اليوم!</strong> يوجد (@Model.DraftsCount) مسودة بيع غير مكتملة. يجب اعتمادها أو حذفها أولاً.
                        </div>
                    }

                    <div class="mb-3">
                        <label for="closeNotesInput" class="form-label fw-bold">ملاحظات الإغلاق (اختياري)</label>
                        <textarea id="closeNotesInput" class="form-control" rows="2" placeholder="أي ملاحظات نهائية عند تقفيل الصندوق..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light p-3">
                    <button type="button" class="btn btn-outline-secondary px-4 fw-bold" data-bs-dismiss="modal">إلغاء</button>
                    <button type="button" class="btn btn-danger px-4 fw-bold shadow-sm" id="btnConfirmCloseDay" @(Model.DraftsCount > 0 ? "disabled" : "")>
                        <i class="bi bi-lock-fill me-1"></i> تأكيد وإغلاق اليوم نهائياً
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script nonce="@Context.Items["csp-nonce"]">
    document.querySelectorAll('.yq-btn-view-sale').forEach(function(btn) {
        btn.addEventListener('click', function() {
            viewSaleDetails(this.getAttribute('data-sale-id'));
        });
    });
        function ledgerAjaxHeaders(includeBody) {
            var headers = {
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            };
            if (includeBody) headers['Content-Type'] = 'application/json';
            return headers;
        }

        function ledgerRequestError(value) {
            return window.YaqutAdminAjax.normalizeError(value);
        }

        document.addEventListener('DOMContentLoaded', function() {
            var btnOpenCloseModal = document.getElementById('btnOpenCloseModal');
            if (btnOpenCloseModal) {
                btnOpenCloseModal.addEventListener('click', function() {
                    var modalElem = document.getElementById('closeDayModal');
                    if (modalElem) {
                        var modal = new bootstrap.Modal(modalElem);
                        modal.show();
                    }
                });
            }

            var btnConfirmCloseDay = document.getElementById('btnConfirmCloseDay');
            if (btnConfirmCloseDay) {
                btnConfirmCloseDay.addEventListener('click', confirmCloseDay);
            }
        });

        function escapeHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function viewSaleDetails(saleId) {
            var modalElem = document.getElementById('saleDetailsModal');
            var modalBody = document.getElementById('detailsModalBody');
            var modal = new bootstrap.Modal(modalElem);
            modal.show();

            modalBody.innerHTML = '<div class="text-center py-4"><span class="spinner-border text-warning"></span><p class="text-muted small mt-2">جاري التحميل...</p></div>';

            fetch(`/Admin/QuickSales/SaleDetails?id=${saleId}`, { headers: ledgerAjaxHeaders(false) })
                .then(window.YaqutAdminAjax.readJson)
                .then(data => {
                    if (!data.success) {
                        modalBody.innerHTML = `<div class="alert alert-danger">${escapeHtml(data.message)}</div>`;
                        return;
                    }

                    var itemsHtml = '';
                    data.items.forEach(function(item) {
                        var modeLabel = item.retailSizeMl ? ` — تجزئة (${item.retailSizeMl} ml)` : (item.stockUnit === 'Ml' ? ' — بالعبوة الكاملة' : '');
                        itemsHtml += `
                            <tr>
                                <td><strong class="text-dark">${escapeHtml(item.productName)}${modeLabel}</strong></td>
                                <td class="text-center">${item.quantity}</td>
                                <td class="text-end">${window.Yaqut.formatPrice(item.unitPrice)}</td>
                                <td class="text-end">${item.discount > 0 ? window.Yaqut.formatPrice(item.discount) : '-'}</td>
                                <td class="text-end text-dark"><strong >${window.Yaqut.formatPrice(item.total)}</strong></td>
                            </tr>
                        `;
                    });

                    var paymentsHtml = '';
                    data.payments.forEach(function(pm) {
                        paymentsHtml += `
                            <div class="d-flex justify-content-between align-items-center p-2 rounded bg-light mb-1 border">
                                <span><i class="bi bi-wallet2 me-1"></i> ${escapeHtml(pm.methodName)} (${escapeHtml(pm.methodCode)})</span>
                                <strong class="text-warning">${window.Yaqut.formatPrice(pm.amount)}</strong>
                            </div>
                        `;
                    });

                    modalBody.innerHTML = `
                        <div class="bg-light p-3 rounded-3 mb-4 border">
                            <div class="row g-2">
                                <div class="col-6"><strong>رقم الفاتورة:</strong> <span class="text-warning fw-bold">${escapeHtml(data.invoiceNumber)}</span></div>
                                <div class="col-6"><strong>تاريخ الاعتماد:</strong> <span class="text-muted small">${escapeHtml(data.time)}</span></div>
                                <div class="col-6"><strong>العميل:</strong> ${escapeHtml(data.customerName)}</div>
                                <div class="col-6"><strong>الجوال:</strong> ${escapeHtml(data.customerPhone)}</div>
                            </div>
                        </div>

                        <h6 class="fw-bold mb-2 text-dark"><i class="bi bi-box-seam me-1"></i> المنتجات المباعة</h6>
                        <div class="table-responsive mb-4">
                            <table class="table table-bordered align-middle mb-0 text-nowrap">
                                <thead class="bg-light">
                                    <tr>
                                        <th>المنتج</th>
                                        <th class="text-center">الكمية</th>
                                        <th class="text-end">سعر الوحدة التاريخي</th>
                                        <th class="text-end">الخصم</th>
                                        <th class="text-end">الإجمالي</th>
                                    </tr>
                                </thead>
                                <tbody>${itemsHtml}</tbody>
                            </table>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <h6 class="fw-bold mb-2 text-dark"><i class="bi bi-wallet2 me-1"></i> وسيلة/وسائل التحصيل</h6>
                                ${paymentsHtml}
                            </div>
                            <div class="col-md-6 text-end">
                                <div class="bg-dark text-white p-3 rounded-3">
                                    <div class="d-flex justify-content-between mb-1 text-white-50">
                                        <span>المجموع الفرعي:</span>
                                        <span>${window.Yaqut.formatPrice(data.totalAmount)}</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2 text-white-50">
                                        <span>خصم الفاتورة:</span>
                                        <span>${window.Yaqut.formatPrice(data.discountTotal)}</span>
                                    </div>
                                    <div class="d-flex justify-content-between border-top border-secondary pt-2">
                                        <span class="fw-bold fs-6">الإجمالي النهائي:</span>
                                        <strong class="text-warning fs-5">${window.Yaqut.formatPrice(data.finalAmount)}</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                })
                .catch(value => {
                    var requestError = ledgerRequestError(value);
                    modalBody.innerHTML = `<div class="alert alert-danger">${escapeHtml(requestError.message)}</div>`;
                });
        }

        function confirmCloseDay() {
            var salesDayId = @Model.SalesDay.Id;
            var notes = document.getElementById('closeNotesInput')?.value || '';
            var btnConfirm = document.getElementById('btnConfirmCloseDay');

            btnConfirm.disabled = true;
            btnConfirm.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> جاري إغلاق اليوم...';

            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            fetch('/Admin/QuickSales/CloseDay', {
                method: 'POST',
                headers: Object.assign(ledgerAjaxHeaders(true), { 'RequestVerificationToken': token }),
                body: JSON.stringify({ salesDayId: salesDayId, notes: notes })
            })
            .then(window.YaqutAdminAjax.readJson)
            .then(data => {
                if (data.success) {
                    window.location.reload();
                } else {
                    btnConfirm.disabled = false;
                    btnConfirm.innerHTML = '<i class="bi bi-lock-fill me-1"></i> تأكيد وإغلاق اليوم نهائياً';
                    alert(data.message || 'تعذر إغلاق يوم البيع.');
                }
            })
            .catch(value => {
                var err = ledgerRequestError(value);
                btnConfirm.disabled = false;
                btnConfirm.innerHTML = '<i class="bi bi-lock-fill me-1"></i> تأكيد وإغلاق اليوم نهائياً';
                alert(err.message || 'تعذر الاتصال بالسيرفر لإغلاق اليوم.');
            });
        }
    </script>
}
