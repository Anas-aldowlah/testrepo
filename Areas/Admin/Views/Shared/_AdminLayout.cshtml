<!DOCTYPE html>
<html lang="ar" dir="rtl" class="dark-mode yaqut-admin-root">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - لوحة إدارة ياقوت</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/yaqut-theme.css" asp-append-version="true" />
    <script src="~/js/yaqut-main.js" asp-append-version="true"></script>
</head>
<body class="dark-mode yaqut-admin-body">
    <header class="yaqut-admin-mobile-header">
        <button type="button" class="yaqut-admin-menu-toggle" aria-label="فتح القائمة" onclick="toggleAdminNav()">
            <i class="bi bi-list"></i>
        </button>
        <a class="yaqut-admin-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">ياقوت — الإدارة</a>
    </header>

    <div class="yaqut-admin-wrapper">
        <aside class="yaqut-admin-sidebar" id="adminSidebar">
            <a class="yaqut-admin-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-gem"></i> ياقوت — الإدارة
            </a>
            <ul class="yaqut-sidebar-nav">
                <li><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> لوحة التحكم</a></li>
                <li><a asp-area="Admin" asp-controller="Products" asp-action="Index"><i class="bi bi-box-seam"></i> المنتجات</a></li>
                <li><a asp-area="Admin" asp-controller="Categories" asp-action="Index"><i class="bi bi-tags"></i> التصنيفات</a></li>
                <li><a asp-area="Admin" asp-controller="Orders" asp-action="Index"><i class="bi bi-receipt"></i> الطلبات</a></li>
                <li><a asp-area="Admin" asp-controller="Users" asp-action="Index"><i class="bi bi-people"></i> المستخدمين</a></li>
                <li><a asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-shop"></i> العودة للمتجر</a></li>
            </ul>
        </aside>
        <main class="yaqut-admin-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
