@model YAGOT_2._0.Services.ViewModels
@{
    ViewData["Title"] = "إدارة التصنيفات";
}

<div class="yaqut-admin-header">
    <h1><i class="bi bi-tags"></i> إدارة التصنيفات</h1>
    <a asp-action="Create" class="btn-yaqut-gold btn-sm"><i class="bi bi-plus-lg"></i> إضافة تصنيف</a>
</div>

@if (TempData["Error"] != null)
{
    <div class="yaqut-alert yaqut-alert--danger">@TempData["Error"]</div>
}

<div class="yaqut-admin-grid">
    @foreach (var cat in Model.Categories)
    {
        var productCount = Model.Products.Count(p => p.Categoryid == cat.Id);
        <article class="yaqut-admin-card glass-effect">
            @if (!string.IsNullOrEmpty(cat.Imageurl))
            {
                <img src="@Url.Content("~/" + cat.Imageurl)" alt="@cat.Name" class="yaqut-admin-card__img" />
            }
            else
            {
                <div class="yaqut-category-card__placeholder">
                    <i class="bi bi-tag"></i>
                </div>
            }
            <div class="yaqut-admin-card__body">
                <h3 class="yaqut-admin-card__title">@cat.Name</h3>
                <p class="text-muted small">@cat.Description</p>
                <span class="text-warning small">@productCount منتج</span>
                <div class="d-flex gap-2 mt-3">
                    <a asp-action="Edit" asp-route-id="@cat.Id" class="btn-yaqut-outline btn-sm">تعديل</a>
                    <form asp-action="Delete" asp-route-id="@cat.Id" method="post"
                          data-yaqut-confirm="هل أنت متأكد من حذف التصنيف @cat.Name؟">
                        <button type="submit" class="btn-yaqut-danger btn-sm">حذف</button>
                    </form>
                </div>
            </div>
        </article>
    }
</div>
