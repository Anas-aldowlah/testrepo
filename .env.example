# ==============================================================================
#                 متجر الياقوت - ملف متغيرات البيئة (.env)
#                     TemplateSite (Yaqoot) Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. إعدادات بيئة التشغيل والخادم (Runtime & Server Configuration)
# ------------------------------------------------------------------------------
# وضع التشغيل: Development للتطوير المحلي، أو Production للإنتاج على Render
ASPNETCORE_ENVIRONMENT=Development

# المنفذ الافتراضي للتشغيل (10000 على Render، أو 7279 محلياً)
PORT=7279


# ------------------------------------------------------------------------------
# 2. قاعدة بيانات المتجر الرئيسية (Neon PostgreSQL Database - Store DB)
# ------------------------------------------------------------------------------
# تشمل المنتجات، الطلبات، الأقسام، لقطات الحالة والـ Snapshots
ConnectionStrings__MYDB=Host=ep-spring-bonus-b1d8g280-pooler.c-5.eu-central-1.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=npg_RQ1wg6UtCkJz;SSL Mode=Require;Trust Server Certificate=true;KeepAlive=30;TcpKeepAlive=true;Timeout=30;CommandTimeout=60


# ------------------------------------------------------------------------------
# 3. قاعدة بيانات المستخدمين والهوية (Neon PostgreSQL Database - Users DB)
# ------------------------------------------------------------------------------
# قاعدة بيانات حسابات العملاء وإدارة الصلاحيات
ConnectionStrings__User=Host=ep-misty-frost-afopimuh-pooler.c-2.us-west-2.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=npg_1GQVFO3lXnUS;SSL Mode=Require;Trust Server Certificate=true;KeepAlive=30;TcpKeepAlive=true;Timeout=30;CommandTimeout=60
ConnectionStrings__UsersConnection=Host=ep-misty-frost-afopimuh-pooler.c-2.us-west-2.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=npg_1GQVFO3lXnUS;SSL Mode=Require;Trust Server Certificate=true;KeepAlive=30;TcpKeepAlive=true;Timeout=30;CommandTimeout=60


# ------------------------------------------------------------------------------
# 4. إعدادات التكامل والربط مع لوحة التحكم المركزية (MultiSite Integration)
# ------------------------------------------------------------------------------
# رقم تعريف متجر الياقوت في لوحة التحكم المركزية
YagotIntegration__SiteId=1

# رابط لوحة التحكم المركزية:
# محلياً: https://localhost:7091/
# إنتاجياً (Render): https://controlpanelsite-d7ta.onrender.com/
YagotIntegration__ControlPanelBaseUrl=https://localhost:7091/

# مفتاح مصادقة جلب اللقطات من لوحة التحكم (يجب أن يتطابق مع SnapshotApiKey في لوحة التحكم)
YagotIntegration__SnapshotApiKey=yagot-prod-snapshot-key-safe-val-12345

# معرف مفتاح الويب هوك
YagotIntegration__WebhookKeyId=wh-key-prod-1

# السر المشفر لتوقيع رسائل الويب هوك الواردة من لوحة التحكم (32 حرفاً على الأقل)
YagotIntegration__WebhookSecret=prod-webhook-secret-must-be-32-chars-long!

# الفارق الزمني المسموح به لطلبات الويب هوك بالثواني
YagotIntegration__TimestampToleranceSeconds=300

# الفاصل الزمني للمزامنة الاحتياطية الدورية بالدقائق
YagotIntegration__ReconciliationIntervalMinutes=30

# مهلة طلب جلب اللقطة بالثواني
YagotIntegration__SnapshotHttpTimeoutSeconds=10


# ------------------------------------------------------------------------------
# 5. رابط المتجر العام (Public URL)
# ------------------------------------------------------------------------------
# رابط المتجر العام لإنشاء روابط الدفع وتأكيد الحسابات
# محلياً: https://localhost:7279/
# إنتاجياً (Render): https://yagot-wppl.onrender.com/
PublicUrl__BaseUrl=https://localhost:7279/


