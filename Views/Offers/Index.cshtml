@model YAGOT_2._0.Models.OffersViewModel
@using YAGOT_2._0.Services
@using YAGOT_2._0.Extensions
@{
    ViewData["Title"] = "العروض والخصومات | ياقوت";
    var categories = Model.Categories?.ToList() ?? new List<YAGOT_2._0.Models.Category>();
    var products = Model.Products?.ToList() ?? new List<YAGOT_2._0.Models.Product>();
    var currencySymbol = CurrencyHelper.GetSymbol();
}

@section Styles {
    <style nonce="@Context.Items["csp-nonce"]">
        .yq-offers-page {
            max-width: 1320px;
            margin: 0 auto;
            padding: 2rem 1rem 4rem;
        }

        .yq-offers-banner {
            background: linear-gradient(135deg, rgba(227, 182, 91, 0.15), rgba(184, 134, 11, 0.05));
            border: 1px solid rgba(227, 182, 91, 0.3);
            border-radius: 1rem;
            padding: 2.5rem 2rem;
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
        }

        .yq-offers-banner__glow {
            position: absolute;
            top: -50%;
            right: -10%;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(239, 68, 68, 0.2), transparent 70%);
            pointer-events: none;
        }

        .yq-offers-filter-bar {
            background: rgba(20, 20, 20, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 0.75rem;
            padding: 1.25rem;
            margin-bottom: 2rem;
        }

        .yq-offers-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 1.5rem;
        }
    </style>
}

<div class="yq-offers-page">

    <!-- HEADER BANNER -->
    <div class="yq-offers-banner shadow-sm">
        <div class="yq-offers-banner__glow"></div>
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <span class="badge bg-danger text-white px-3 py-1 mb-2 rounded-pill fs-6 shadow-sm">
                    <i class="bi bi-fire text-warning me-1"></i> صفقات ترويجية حصرية
                </span>
                <h1 class="fw-bold mb-2 text-warning display-6">🔥 جميع العروض والخصومات</h1>
                <p class="text-light mb-0">اكتشف أفضل الخصومات والتخفيضات المميزة المتاحة الآن مع جودة عالية وأسعار منافسة.</p>
            </div>
            <div class="text-end">
                <span class="badge bg-dark border border-secondary text-gold px-3 py-2 fs-5">
                    إجمالي العروض: <strong>@Model.TotalItems</strong> عرض
                </span>
            </div>
        </div>
    </div>

    <!-- FILTER & SEARCH BAR -->
    <div class="yq-offers-filter-bar shadow-sm">
        <form method="get" asp-controller="Offers" asp-action="Index" class="row g-2 align-items-center">
            <!-- Search input -->
            <div class="col-12 col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-warning"><i class="bi bi-search"></i></span>
                    <input type="text" name="q" value="@Model.SearchQuery" class="form-control bg-dark border-secondary text-white" placeholder="ابحث في العروض..." />
                </div>
            </div>

            <!-- Category filter -->
            <div class="col-6 col-md-2">
                <select name="categoryId" class="form-select bg-dark border-secondary text-white">
                    <option value="">جميع الأقسام</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id ? "selected" : null)">@cat.Name</option>
                    }
                </select>
            </div>

            <!-- Promo Type filter -->
            <div class="col-6 col-md-2">
                <select name="promoType" class="form-select bg-dark border-secondary text-white">
                    <option value="">نوع العرض</option>
                    <option value="Percentage" selected="@(Model.PromoType == "Percentage" ? "selected" : null)">نسبة خصم %</option>
                    <option value="FixedAmount" selected="@(Model.PromoType == "FixedAmount" ? "selected" : null)">خصم ثابت (@currencySymbol)</option>
                    <option value="BuyXGetY" selected="@(Model.PromoType == "BuyXGetY" ? "selected" : null)">اشترِ واحصل مجاناً</option>
                    <option value="QuantityPrice" selected="@(Model.PromoType == "QuantityPrice" ? "selected" : null)">سعر كمية خاص</option>
                </select>
            </div>

            <!-- Sort dropdown -->
            <div class="col-6 col-md-2">
                <select name="sort" class="form-select bg-dark border-secondary text-white">
                    <option value="priority" selected="@(Model.Sort == "priority" ? "selected" : null)">أهم العروض (الأولوية)</option>
                    <option value="newest" selected="@(Model.Sort == "newest" ? "selected" : null)">الأحدث</option>
                    <option value="discount_desc" selected="@(Model.Sort == "discount_desc" ? "selected" : null)">الأعلى خصماً</option>
                    <option value="price_asc" selected="@(Model.Sort == "price_asc" ? "selected" : null)">الأقل سعراً</option>
                    <option value="price_desc" selected="@(Model.Sort == "price_desc" ? "selected" : null)">الأعلى سعراً</option>
                </select>
            </div>

            <!-- Action buttons -->
            <div class="col-6 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-warning w-100 fw-bold" style="background: #e3b65b; border: none; color: #111;">
                    فلترة
                </button>
                <a asp-controller="Offers" asp-action="Index" class="btn btn-outline-secondary px-3" title="إعادة ضبط">
                    <i class="bi bi-x-circle"></i>
                </a>
            </div>
        </form>
    </div>

    @{
        var activeSpendPromos = ViewBag.ActiveSpendPromotions as List<YAGOT_2._0.Models.Promotion>;
    }

    <!-- PRODUCT GRID -->
    @if (products.Any() || (activeSpendPromos != null && activeSpendPromos.Any()))
    {
        <div class="yq-offers-grid">
            @if (activeSpendPromos != null && activeSpendPromos.Any())
            {
                @foreach (var spendPromo in activeSpendPromos)
                {
                    <article class="yq-pcard yq-pcard--banner-ad h-100 d-flex flex-column justify-content-between p-3 rounded-4 shadow-lg border border-warning" style="background: linear-gradient(135deg, rgba(30,34,53,0.95), rgba(15,18,30,0.98)); position: relative; overflow: hidden; min-height: 380px;">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="badge bg-warning text-dark px-3 py-2 fs-6 rounded-pill shadow-sm fw-bold">
                                <i class="bi bi-megaphone-fill me-1"></i> إعلان عرض عام
                            </span>
                            @if (spendPromo.EndDate > DateTimeOffset.UtcNow)
                            {
                                <span class="badge bg-danger text-white px-2 py-1 fs-6 rounded-pill">
                                    <i class="bi bi-clock-history me-1"></i> لفترة محدودة
                                </span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(spendPromo.BannerImage))
                        {
                            <div class="my-2 text-center rounded-3 overflow-hidden" style="max-height: 160px;">
                                <img src="@spendPromo.BannerImage" alt="@spendPromo.Title" class="img-fluid rounded-3 w-100 h-100" style="object-fit: cover;" />
                            </div>
                        }

                        <div class="mt-2 text-center flex-grow-1 d-flex flex-column justify-content-center">
                            <h4 class="text-gold fw-bold mb-2 fs-5">@spendPromo.Title</h4>
                            <p class="text-light small mb-2 opacity-90">
                                @(string.IsNullOrWhiteSpace(spendPromo.Description)
                                    ? spendPromo.SpendDiscountType == YAGOT_2._0.Models.DiscountValueType.Percentage
                                        ? $"خصم {spendPromo.DiscountValue:0.##}% على الفاتورة عند الوصول للحد الأدنى"
                                        : $"خصم {spendPromo.DiscountValue.ToYaqutPrice()} على الفاتورة عند الوصول للحد الأدنى"
                                    : spendPromo.Description)
                            </p>
                            @if (spendPromo.MinimumAmount.HasValue && spendPromo.MinimumAmount > 0)
                            {
                                <div class="p-2 rounded-3 bg-dark bg-opacity-50 text-warning small fw-bold mb-2 border border-warning border-opacity-25">
                                    <i class="bi bi-cart-check me-1"></i> الحد الأدنى: @spendPromo.MinimumAmount.Value.ToYaqutPrice()
                                </div>
                            }
                        </div>

                        <a asp-controller="Products" asp-action="Index" class="btn btn-warning w-100 fw-bold mt-2 py-2 shadow-sm rounded-3" style="background: #e3b65b; border: none; color: #111;">
                            <i class="bi bi-bag-heart me-1"></i> تسوق واستفد من العرض
                        </a>
                    </article>
                }
            }

            @foreach (var item in products)
            {
                <partial name="_ProductCard" model="item" view-data='new ViewDataDictionary(ViewData) { { "IsPromoSection", true } }' />
            }
        </div>

        <!-- PAGINATION BAR -->
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-5 d-flex justify-content-center" aria-label="تنقل الصفحات">
                <ul class="pagination pagination-md">
                    @if (Model.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link bg-dark text-warning border-secondary"
                               asp-action="Index"
                               asp-route-q="@Model.SearchQuery"
                               asp-route-categoryId="@Model.CategoryId"
                               asp-route-promoType="@Model.PromoType"
                               asp-route-sort="@Model.Sort"
                               asp-route-page="@(Model.CurrentPage - 1)">
                                <i class="bi bi-chevron-right"></i> السابق
                            </a>
                        </li>
                    }

                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link @(p == Model.CurrentPage ? "bg-warning text-dark border-warning fw-bold" : "bg-dark text-white border-secondary")"
                               asp-action="Index"
                               asp-route-q="@Model.SearchQuery"
                               asp-route-categoryId="@Model.CategoryId"
                               asp-route-promoType="@Model.PromoType"
                               asp-route-sort="@Model.Sort"
                               asp-route-page="@p">
                                @p
                            </a>
                        </li>
                    }

                    @if (Model.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link bg-dark text-warning border-secondary"
                               asp-action="Index"
                               asp-route-q="@Model.SearchQuery"
                               asp-route-categoryId="@Model.CategoryId"
                               asp-route-promoType="@Model.PromoType"
                               asp-route-sort="@Model.Sort"
                               asp-route-page="@(Model.CurrentPage + 1)">
                                التالي <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="yaqut-empty yq-glass p-5 text-center rounded-3 my-5">
            <i class="bi bi-tag-slash yaqut-empty__icon text-warning fs-1"></i>
            <h3 class="mt-3 text-warning">لا توجد عروض متاحة حالياً</h3>
            <p class="text-muted">لم نجد أي عروض ترويجية مطابقة لخيارات البحث المحددة. حاول تغيير الفلتر أو العودة لاحقاً.</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-warning fw-bold mt-3 px-4" style="background: #e3b65b; border: none; color: #111;">
                <i class="bi bi-grid me-1"></i> تصفح جميع المنتجات
            </a>
        </div>
    }
</div>
