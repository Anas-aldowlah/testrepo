@model YAGOT_2._0.Models.ProductsCatalogViewModel
@{
    var request = Model.Request;
    var selectedCategory = Model.SelectedCategory;
    var isSearchMode = !string.IsNullOrWhiteSpace(request.Search);
    var isBrandMode = request.Brand.Length > 0;
    var activeFilterCount = 0;
    if (selectedCategory != null) activeFilterCount++;
    if (isSearchMode) activeFilterCount++;
    activeFilterCount += request.Brand.Length;
    if (request.MinPrice.HasValue) activeFilterCount++;
    if (request.MaxPrice.HasValue) activeFilterCount++;
    if (request.Retail != "all") activeFilterCount++;
    activeFilterCount += request.RetailSize.Length;
    var hasActiveFilter = activeFilterCount > 0;

    ViewData["Title"] = isSearchMode
        ? $"نتائج البحث: {request.Search}"
        : (isBrandMode ? $"منتجات: {string.Join(", ", request.Brand)}"
        : (selectedCategory != null ? $"منتجات: {selectedCategory.Name}" : "جميع المنتجات"));
}

@section Styles {
    <link rel="stylesheet" href="~/css/products/index.css" asp-append-version="true" />
}

<div class="yq-shop" data-yq-search-term="@request.Search">
    <header class="yq-shop-header yq-reveal">
        <nav class="yq-shop-breadcrumb" aria-label="مسار التصفح">
            <a asp-controller="Home" asp-action="Index">الرئيسية</a>
            <i class="bi bi-chevron-left"></i>
            @if (isSearchMode || isBrandMode)
            {
                <a asp-action="Index">المنتجات</a>
                <i class="bi bi-chevron-left"></i>
                <span>@(isBrandMode && !isSearchMode ? "الشركة المنتجة" : "نتائج البحث")</span>
            }
            else
            {
                <span>@(selectedCategory?.Name ?? "جميع المنتجات")</span>
            }
        </nav>

        @if (isSearchMode || isBrandMode)
        {
            <div class="yq-search-banner">
                <div class="yq-search-banner__icon"><i class="bi @(isBrandMode && !isSearchMode ? "bi-building" : "bi-search")"></i></div>
                <div class="yq-search-banner__text">
                    <span class="yq-search-banner__label">@(isBrandMode && !isSearchMode ? "منتجات الشركة" : "نتائج البحث عن")</span>
                    <h1 class="yq-search-banner__query">"@(isBrandMode && !isSearchMode ? string.Join(", ", request.Brand) : request.Search)"</h1>
                    <p class="yq-search-banner__count">
                        تم العثور على <strong>@Model.TotalCount</strong> @(Model.TotalCount == 1 ? "منتج" : "منتجات")
                    </p>
                </div>
                <a asp-action="Index" class="yq-search-banner__clear">
                    <i class="bi bi-x-circle"></i> @(isBrandMode && !isSearchMode ? "إزالة فلتر الشركة" : "إزالة البحث")
                </a>
            </div>
        }
        else
        {
            <div class="yq-shop-header__row">
                <div>
                    <h1 class="yq-shop-header__title"><span>@(selectedCategory?.Name ?? "جميع المنتجات")</span></h1>
                    <p class="yq-shop-header__sub">تصفّح منتجاتنا الفاخرة والأصيلة</p>
                </div>
                @if (hasActiveFilter)
                {
                    <a asp-action="Index" class="yq-shop-clear-link"><i class="bi bi-x-circle"></i> إزالة الفلاتر</a>
                }
            </div>
        }
    </header>

    <div class="yq-recent-searches" id="yqRecentSearches" hidden>
        <span class="yq-recent-searches__label"><i class="bi bi-clock-history"></i> عمليات بحث سابقة</span>
        <div class="yq-recent-searches__list" id="yqRecentSearchesList"></div>
    </div>

    @if (Model.Categories.Count > 0)
    {
        <nav class="yq-shop-pills yq-reveal" aria-label="تصفية حسب التصنيف">
            <button type="button" class="yq-shop-pill @(request.CategoryId == null ? "is-active" : "")" data-yq-category="">
                <i class="bi bi-grid"></i> الكل
            </button>
            @foreach (var category in Model.Categories)
            {
                <button type="button" class="yq-shop-pill @(request.CategoryId == category.Id ? "is-active" : "")" data-yq-category="@category.Id">
                    @category.Name
                </button>
            }
        </nav>
    }

    <div class="yq-shop-toolbar yq-reveal">
        <p id="yaqutResultsCount" class="yq-shop-toolbar__count" role="status" aria-live="polite">@Model.TotalCount عطر</p>
        <div class="yq-shop-toolbar__actions">
            <div class="yq-shop-sort">
                <label for="yqSortSelect"><i class="bi bi-sort-down"></i> ترتيب حسب</label>
                <select id="yqSortSelect" name="sort" form="yqCatalogFilters" class="yq-shop-sort__select" data-yq-auto-submit>
                    <option value="newest" selected="@(request.Sort == "newest")">الأحدث</option>
                    <option value="price-asc" selected="@(request.Sort == "price-asc")">السعر: الأقل أولاً</option>
                    <option value="price-desc" selected="@(request.Sort == "price-desc")">السعر: الأعلى أولاً</option>
                    <option value="name" selected="@(request.Sort == "name")">الاسم (أ-ي)</option>
                </select>
            </div>
            <button type="button" id="yaqutFilterToggle" class="btn-yaqut-outline yq-shop-filter-toggle">
                <i class="bi bi-sliders"></i> الفلاتر
                @if (activeFilterCount > 0)
                {
                    <span class="yq-shop-filter-badge" aria-label="عدد الفلاتر المطبقة: @activeFilterCount">@activeFilterCount</span>
                }
            </button>
        </div>
    </div>

    <div class="yq-shop-layout">
        <aside id="yaqutFilters" class="yq-shop-filters yq-glass">
            <div class="yq-shop-filters__head">
                <h3><i class="bi bi-sliders"></i> تصفية المنتجات</h3>
                <button type="button" class="yq-shop-filters__close" id="yqFiltersClose" aria-label="إغلاق الفلاتر">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <form id="yqCatalogFilters" asp-action="Index" method="get">
                <input type="hidden" name="search" value="@request.Search" />
                <input type="hidden" id="yqCategoryId" name="categoryId" value="@request.CategoryId" />

                @if (Model.Brands.Count > 0)
                {
                    <div class="yq-shop-filter-group">
                        <span class="yq-shop-filter-group__label" id="yqBrandGroupLabel">الشركة المنتجة</span>
                        @if (request.Brand.Length == 0) {
                            <div class="text-muted small mb-2">كل الشركات</div>
                        }
                        <div class="yq-shop-filter-options" role="group" aria-labelledby="yqBrandGroupLabel">
                            @foreach (var brand in Model.Brands)
                            {
                                <label class="yq-shop-filter-option">
                                    <input type="checkbox" name="brand" value="@brand" checked="@request.Brand.Contains(brand, StringComparer.OrdinalIgnoreCase)" data-yq-auto-submit /> @brand
                                </label>
                            }
                        </div>
                    </div>
                }

                <div class="yq-shop-filter-group">
                    <span class="yq-shop-filter-group__label" id="yqRetailGroupLabel">توفر البيع بالتجزئة</span>
                    <div class="yq-shop-filter-options" role="radiogroup" aria-labelledby="yqRetailGroupLabel">
                        <label class="yq-shop-filter-option"><input type="radio" name="retail" value="all" checked="@(request.Retail == "all")" data-yq-auto-submit /> كل المنتجات</label>
                        <label class="yq-shop-filter-option"><input type="radio" name="retail" value="yes" checked="@(request.Retail == "yes")" data-yq-auto-submit /> متاح بالتجزئة</label>
                        <label class="yq-shop-filter-option"><input type="radio" name="retail" value="no" checked="@(request.Retail == "no")" data-yq-auto-submit /> غير متاح بالتجزئة</label>
                    </div>
                </div>

                @if (Model.RetailSizes.Count > 0)
                {
                    <div class="yq-shop-filter-group" id="yqRetailSizeGroup" style="display: @(request.Retail == "no" ? "none" : "block")">
                        <span class="yq-shop-filter-group__label" id="yqRetailSizeGroupLabel">حجم التجزئة</span>
                        <div class="yq-shop-filter-options" role="group" aria-labelledby="yqRetailSizeGroupLabel">
                            @foreach (var size in Model.RetailSizes)
                            {
                                <label class="yq-shop-filter-option">
                                    <input type="checkbox" name="retailSize" value="@size" checked="@request.RetailSize.Contains(size)" data-yq-auto-submit /> @size مل
                                </label>
                            }
                        </div>
                    </div>
                }

                <div class="yq-shop-filter-group">
                    <span class="yq-shop-filter-group__label" id="yqPriceGroupLabel">نطاق السعر</span>
                    <div class="yq-shop-price-range" role="group" aria-labelledby="yqPriceGroupLabel">
                        <label>من <input type="number" name="minPrice" value="@request.MinPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture)" min="0" step="0.01" inputmode="decimal" /></label>
                        <label>إلى <input type="number" name="maxPrice" value="@request.MaxPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture)" min="0" step="0.01" inputmode="decimal" /></label>
                    </div>
                    <button type="submit" class="btn-yaqut-outline yq-shop-apply">تطبيق السعر</button>
                </div>

                <div class="yq-shop-filters__footer d-lg-none mt-4 border-top pt-4 d-flex flex-column gap-3">
                    <button type="submit" form="yqCatalogFilters" class="btn-yaqut-gold w-100" style="height: 52px; font-size: 1.05rem;">عرض النتائج</button>
                    <button type="button" class="btn-yaqut-outline w-100" id="yqMobileCancel" style="height: 52px; border-color: var(--yq-border); color: var(--yq-text-soft) !important; font-weight: 600;">إلغاء</button>
                </div>
            </form>
        </aside>

        <div class="yq-shop-main">
            @if (hasActiveFilter)
            {
                <div class="yq-applied-filters yq-reveal is-visible d-flex flex-wrap align-items-center gap-2">
                    <span class="yq-applied-filters__label">الفلاتر المطبقة:</span>
                    @if (request.Retail == "yes") { <button type="button" class="yq-chip yq-chip-remove yq-recent-search-chip" data-remove-name="retail" data-remove-val="all" aria-label="إزالة فلتر متاح بالتجزئة">متاح بالتجزئة &times;</button> }
                    @if (request.Retail == "no") { <button type="button" class="yq-chip yq-chip-remove yq-recent-search-chip" data-remove-name="retail" data-remove-val="all" aria-label="إزالة فلتر غير متاح بالتجزئة">غير متاح بالتجزئة &times;</button> }

                    @if (selectedCategory != null)
                    {
                        <button type="button" class="yq-chip yq-chip-remove yq-recent-search-chip" data-remove-name="categoryId" data-remove-val="" aria-label="إزالة فلتر التصنيف @selectedCategory.Name">@selectedCategory.Name &times;</button>
                    }

                    @foreach (var size in request.RetailSize)
                    {
                        <button type="button" class="yq-chip yq-chip-remove yq-recent-search-chip" data-remove-name="retailSize" data-remove-val="@size" aria-label="إزالة فلتر حجم التجزئة @size مل">@size مل &times;</button>
                    }

                    @foreach (var br in request.Brand)
                    {
                        <button type="button" class="yq-chip yq-chip-remove yq-recent-search-chip" data-remove-name="brand" data-remove-val="@br" aria-label="إزالة فلتر الشركة @br">@br &times;</button>
                    }

                    @if (request.MinPrice.HasValue || request.MaxPrice.HasValue)
                    {
                        var priceLabel = (request.MinPrice.HasValue ? $"من {request.MinPrice}" : "") + (request.MaxPrice.HasValue ? $" إلى {request.MaxPrice}" : "");
                        <button type="button" class="yq-chip yq-chip-remove yq-recent-search-chip" data-remove-name="price" data-remove-val="" aria-label="إزالة فلتر السعر @priceLabel.Trim()">@priceLabel.Trim() &times;</button>
                    }

                    <a asp-action="Index" class="yq-chip yq-chip-clear yq-shop-clear-link yq-recent-search-chip">مسح الكل</a>
                </div>
            }

            @if (Model.Products.Count > 0)
            {
                <div id="yaqutProductsGrid" class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3 yq-shop-grid">
                    @foreach (var item in Model.Products)
                    {
                        <div class="col yq-col-item" data-product-id="@item.Id">
                            <partial name="_ProductCard" model="item" />
                        </div>
                    }
                </div>

                <div class="yq-shop-load-more">
                    <button type="button" id="yqLoadMoreBtn" class="btn-yaqut-outline" data-current-page="@Model.CurrentPage" hidden="@(!Model.HasNextPage)">
                        <i class="bi bi-arrow-down-circle"></i>
                        عرض المزيد (<span data-yq-remaining>@Model.RemainingCount</span>)
                    </button>
                </div>
                <p id="yqCatalogStatus" class="visually-hidden" role="status" aria-live="polite"></p>
            }
            else if (isSearchMode || isBrandMode)
            {
                <div class="yaqut-empty yq-glass yq-search-empty">
                    <i class="bi bi-search yaqut-empty__icon"></i>
                    @{
                        var brandDisplay = request.Brand.Length > 0 ? "منتجات: " + string.Join("، ", request.Brand) : "";
                        var searchTerm = isBrandMode && !isSearchMode ? brandDisplay : request.Search;
                    }
                    <h2 class="yq-shop-empty__title">لم نعثر على نتائج لـ "@searchTerm"</h2>
                    <p class="yaqut-empty__text">جرّب تعديل الفلاتر أو البحث بكلمات مختلفة.</p>
                    <a asp-action="Index" class="btn-yaqut-gold mt-3"><i class="bi bi-stars"></i> عرض جميع المنتجات</a>
                </div>
            }
            else
            {
                <div class="yaqut-empty yq-glass yq-shop-empty">
                    <i class="bi bi-search yaqut-empty__icon"></i>
                    <h2 class="yq-shop-empty__title">لا توجد منتجات تطابق معايير البحث</h2>
                    <p class="yaqut-empty__text">جرّب تعديل الفلاتر أو البحث بكلمات مختلفة.</p>
                    <a asp-action="Index" class="btn-yaqut-gold mt-3">عرض جميع المنتجات</a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/products/index.js" asp-append-version="true"></script>
}
