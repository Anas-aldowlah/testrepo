@{
    ViewData["Title"] = "قصتنا | ياقوت";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home/about.css" asp-append-version="true" />
}

<div class="yq-about">

    <!-- HERO -->
    <section class="yq-about-hero yq-reveal">
        <div class="yq-about-hero__bg" aria-hidden="true"></div>
        <div class="yq-about-hero__content">
            <span class="yq-about-hero__eyebrow"><i class="bi bi-gem"></i> قصة ياقوت</span>
            <h1 class="yq-about-hero__title">فنٌ يُروى برائحة</h1>
            <p class="yq-about-hero__desc">
                ياقوت ليست مجرد متجر عطور، بل رسالة نحملها في كل قطرة: أن تكون الفخامة تجربة حسية
                تُروى بعناية، وأن يكون العطر امتداداً لهوية من يرتديه.
            </p>
        </div>
    </section>

    <!-- BRAND STORY -->
    <section class="yq-about-section yq-reveal">
        <div class="yq-about-story">
            <div class="yq-about-story__media">
                <div class="yq-about-story__placeholder"><i class="bi bi-gem"></i></div>
            </div>
            <div class="yq-about-story__content">
                <span class="yq-about-tag">قصتنا</span>
                <h2 class="yq-about-section__title">من فكرة إلى تجربة فاخرة</h2>
                <p>
                    وُلدت ياقوت من شغف حقيقي بعالم العطور الشرقية والغربية الأصيلة، ومن رغبة صادقة
                    في تقديم تجربة تسوق تليق بذوق عملائنا الرفيع. اخترنا اسم "ياقوت" لأنه يرمز إلى
                    الجوهرة النادرة، تماماً كما نرى كل عطر نقدّمه: قطعة فنية خالدة تُروى من خلالها
                    قصة حسية فريدة.
                </p>
                <p>
                    نؤمن أن العطر الحقيقي لا يُشترى، بل يُختار بعناية ليعكس شخصية من يرتديه. لهذا
                    نضع الأصالة والجودة في قلب كل قرار نتخذه، من اختيار العطور إلى تجربة التسوق
                    بأكملها.
                </p>
            </div>
        </div>
    </section>

    <!-- MISSION & VISION -->
    <section class="yq-about-section yq-reveal">
        <div class="yq-about-mv">
            <div class="yq-about-mv__card yq-glass">
                <div class="yq-about-mv__icon"><i class="bi bi-bullseye"></i></div>
                <h3>مهمتنا</h3>
                <p>
                    تقديم عطور فاخرة أصيلة بأعلى معايير الجودة، ضمن تجربة تسوق سلسة وموثوقة تمنح
                    عملاءنا الثقة الكاملة في كل عملية شراء.
                </p>
            </div>
            <div class="yq-about-mv__card yq-glass">
                <div class="yq-about-mv__icon"><i class="bi bi-stars"></i></div>
                <h3>رؤيتنا</h3>
                <p>
                    أن نكون الوجهة الأولى لعشاق العطور الفاخرة في المنطقة، ومرجعاً يُعتمد عليه في
                    الأصالة والفخامة والاحترافية.
                </p>
            </div>
        </div>
    </section>

    <!-- CORE VALUES -->
    <section class="yq-about-section yq-reveal">
        <header class="yq-about-section__head">
            <span class="yq-about-tag">قيمنا</span>
            <h2 class="yq-about-section__title">ما يميزنا</h2>
        </header>

        <div class="yq-about-values">
            <div class="yq-about-value yq-glass">
                <i class="bi bi-gem"></i>
                <h3>الأصالة</h3>
                <p>نضمن أصالة كل عطر نقدّمه، دون أي مساس بالجودة أو المصداقية.</p>
            </div>
            <div class="yq-about-value yq-glass">
                <i class="bi bi-award"></i>
                <h3>الجودة</h3>
                <p>نختار مكوناتنا ومورّدينا بمعايير دقيقة تعكس فخامة العلامة.</p>
            </div>
            <div class="yq-about-value yq-glass">
                <i class="bi bi-heart"></i>
                <h3>الشفافية</h3>
                <p>نتعامل بصدق مع عملائنا في كل تفاصيل المنتج والخدمة.</p>
            </div>
            <div class="yq-about-value yq-glass">
                <i class="bi bi-shield-check"></i>
                <h3>الثقة</h3>
                <p>نبني علاقة طويلة الأمد مع عملائنا أساسها الثقة والاحترافية.</p>
            </div>
        </div>
    </section>

    <!-- WHY CHOOSE YAQOOT -->
    <section class="yq-about-section yq-reveal">
        <header class="yq-about-section__head">
            <span class="yq-about-tag">لماذا ياقوت</span>
            <h2 class="yq-about-section__title">تجربة تسوق تليق بك</h2>
        </header>

        <div class="yq-about-highlights">
            <div class="yq-about-highlight">
                <span class="yq-about-highlight__icon"><i class="bi bi-gem"></i></span>
                <div>
                    <h3>عطور أصيلة 100%</h3>
                    <p>نضمن أصالة جميع منتجاتنا من أرقى دور العطور العالمية.</p>
                </div>
            </div>
            <div class="yq-about-highlight">
                <span class="yq-about-highlight__icon"><i class="bi bi-truck"></i></span>
                <div>
                    <h3>شحن سريع ومجاني</h3>
                    <p>توصيل مجاني للطلبات فوق 500 ر.س خلال 2-3 أيام عمل.</p>
                </div>
            </div>
            <div class="yq-about-highlight">
                <span class="yq-about-highlight__icon"><i class="bi bi-shield-check"></i></span>
                <div>
                    <h3>ضمان الجودة</h3>
                    <p>استبدال أو استرجاع خلال 14 يوماً مع ضمان الرضا الكامل.</p>
                </div>
            </div>
            <div class="yq-about-highlight">
                <span class="yq-about-highlight__icon"><i class="bi bi-headset"></i></span>
                <div>
                    <h3>دعم يليق بك</h3>
                    <p>فريق مخصص لمساعدتك في اختيار العطر الأنسب لشخصيتك.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="yq-about-cta yq-reveal">
        <div class="yq-about-cta__content">
            <h2>اكتشف عالم ياقوت</h2>
            <p>تصفّح منتجاتنا الفاخرة أو تواصل معنا لأي استفسار.</p>
            <div class="yq-about-cta__actions">
                <a asp-controller="Products" asp-action="Index" class="btn-yaqut-gold">
                    <i class="bi bi-stars"></i> تصفح المنتجات 
                </a>
                <a asp-controller="Home" asp-action="Privacy" class="btn-yaqut-outline">
                    <i class="bi bi-envelope"></i> تواصل معنا
                </a>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/home/about.js" asp-append-version="true"></script>
}