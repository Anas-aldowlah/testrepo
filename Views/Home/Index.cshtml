@model YAGOT_2._0.Services.ViewModels
@{
    ViewData["Title"] = "الرئيسية | ياقوت";

    var categories = Model.Categories?.ToList() ?? new List<YAGOT_2._0.Models.Category>();
    var inStockProducts = Model.Products?.Where(p => p.Stockquantity > 0).ToList()
                           ?? new List<YAGOT_2._0.Models.Product>();

    foreach (var p in inStockProducts)
    {
        p.Category = categories.FirstOrDefault(c => c.Id == p.Categoryid);
    }

    var newArrivals = inStockProducts.OrderByDescending(p => p.Createdat).Take(8).ToList();
    var premiumSelection = inStockProducts.OrderByDescending(p => p.Price).Take(8).ToList();
    var heroSlides = newArrivals.Take(5).ToList();
    var storyImageUrl = categories.FirstOrDefault(c => !string.IsNullOrEmpty(c.Imageurl))?.Imageurl;
}

@section Styles {
    <link rel="stylesheet" href="~/css/home/index.css" asp-append-version="true" />
}

<div class="yq-home-page">

    <!-- HERO -->
    <section class="yq-home-hero yq-reveal">
        <div class="yq-home-hero__bg" aria-hidden="true"></div>
        <div class="yq-home-hero__inner">
            <div class="yq-home-hero__content">
                <span class="yq-home-hero__eyebrow"><i class="bi bi-gem"></i> مجموعة العطور الفاخرة</span>
                <h1 class="yq-home-hero__title">حيث تولد الروائح<br />كقطع فنية خالدة</h1>
                <p class="yq-home-hero__desc">
                    اكتشف عالماً من العطور الشرقية والغربية الأصيلة، المصنوعة بأجود المكونات
                    لتجربة فاخرة تأسر حواسك من أول رشة.
                </p>
                <div class="yq-home-hero__actions">
                    <a asp-controller="Products" asp-action="Index" class="btn-yaqut-gold">
                        <i class="bi bi-stars"></i> استكشف المجموعة
                    </a>
                    @if (categories.Any())
                    {
                        <a asp-controller="Products" asp-action="Index"
                           asp-route-categoryId="@categories.First().Id"
                           class="btn-yaqut-outline">
                            <i class="bi bi-flower1"></i> العائلات العطرية
                        </a>
                    }
                </div>
            </div>

            @if (heroSlides.Any())
            {
                <div class="yq-home-hero__spotlight" data-yq-hero-carousel aria-label="أحدث العطور المميزة" aria-live="polite">
                    <div class="yq-home-hero__spotlight-track">
                        @for (var i = 0; i < heroSlides.Count; i++)
                        {
                            var product = heroSlides[i];
                            <div class="yq-home-hero__slide @(i == 0 ? "is-active" : "")" data-index="@i">
                                <span class="yq-home-hero__spotlight-badge">جديد</span>
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id"
                                   class="yq-home-hero__spotlight-media">
                                    <img src="@product.Imageurl" alt="@product.Name"
                                         data-yaqut-fallback="/images/placeholder-product.svg"
                                         loading="@(i == 0 ? "eager" : "lazy")" />
                                </a>
                                <div class="yq-home-hero__spotlight-info">
                                    <span class="yq-home-hero__spotlight-name">@product.Name</span>
                                    <span class="yq-home-hero__spotlight-price">@product.Price.ToString("N0") ر.س</span>
                                </div>
                            </div>
                        }
                    </div>

                    @if (heroSlides.Count > 1)
                    {
                        <div class="yq-home-hero__spotlight-dots">
                            @for (var i = 0; i < heroSlides.Count; i++)
                            {
                                <button type="button" class="yq-home-hero__dot @(i == 0 ? "is-active" : "")"
                                        data-yq-hero-dot="@i" aria-label="عرض المنتج @(i + 1)"></button>
                            }
                        </div>
                    }
                </div>
            }
        </div>
        <div class="yq-home-hero__scroll" aria-hidden="true">
            <i class="bi bi-chevron-down"></i>
        </div>
    </section>

    <!-- TRUST STRIP -->
    <section class="yq-home-trust yq-reveal">
        <div class="yq-home-trust__item">
            <i class="bi bi-gem"></i>
            <span>عطور أصيلة 100%</span>
        </div>
        <div class="yq-home-trust__item">
            <i class="bi bi-truck"></i>
            <span>شحن مجاني فوق 500 ر.س</span>
        </div>
        <div class="yq-home-trust__item">
            <i class="bi bi-shield-check"></i>
            <span>ضمان استرجاع 14 يوماً</span>
        </div>
        <div class="yq-home-trust__item">
            <i class="bi bi-lock"></i>
            <span>دفع وتصفح آمن</span>
        </div>
    </section>

    <!-- CATEGORIES -->
    @if (categories.Any())
    {
        <section class="yq-home-section yq-reveal">
            <header class="yq-home-section__head">
                <div>
                    <h2 class="yq-home-section__title">العائلات العطرية</h2>
                    <p class="yq-home-section__sub">اختر عطرك من مجموعاتنا المنسقة بعناية</p>
                </div>
                <a asp-controller="Products" asp-action="Index" class="yq-home-section__link">
                    عرض الكل <i class="bi bi-arrow-left"></i>
                </a>
            </header>

            <div class="yq-home-categories">
                @foreach (var cat in categories)
                {
                    <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@cat.Id"
                       class="yq-home-cat-card">
                        @if (!string.IsNullOrEmpty(cat.Imageurl))
                        {
                            <img src="@Url.Content("~/" + cat.Imageurl)" alt="@cat.Name"
                                 data-yaqut-fallback="/images/placeholder-product.svg" />
                        }
                        else
                        {
                            <div class="yq-home-cat-card__placeholder"><i class="bi bi-flower2"></i></div>
                        }
                        <div class="yq-home-cat-card__overlay">
                            <span class="yq-home-cat-card__name">@cat.Name</span>
                            <span class="yq-home-cat-card__arrow"><i class="bi bi-arrow-left"></i></span>
                        </div>
                    </a>
                }
            </div>
        </section>
    }

    <!-- NEW ARRIVALS -->
    <section class="yq-home-section yq-reveal">
        <header class="yq-home-section__head">
            <div>
                <h2 class="yq-home-section__title">وصل حديثاً</h2>
                <p class="yq-home-section__sub">أحدث الإصدارات المضافة إلى مجموعتنا</p>
            </div>
            <a asp-controller="Products" asp-action="Index" class="yq-home-section__link">
                عرض الكل <i class="bi bi-arrow-left"></i>
            </a>
        </header>

        @if (newArrivals.Any())
        {
            <div class="yq-home-products-grid">
                @foreach (var item in newArrivals)
                {
                    <div class="yq-home-product-item">
                        <partial name="_ProductCard" model="item" />
                    </div>
                }
            </div>
        }
        else
        {
            <div class="yaqut-empty yq-glass">
                <i class="bi bi-droplet yaqut-empty__icon"></i>
                <p class="yaqut-empty__text">لا توجد عطور معروضة حالياً. عُد قريباً لاكتشاف المزيد.</p>
            </div>
        }
    </section>

    <!-- BRAND STORY -->
    <section class="yq-home-story yq-reveal">
        <div class="yq-home-story__media">
            @if (!string.IsNullOrEmpty(storyImageUrl))
            {
                <img src="@Url.Content("~/" + storyImageUrl)" alt="ياقوت للعطور الفاخرة"
                     data-yaqut-fallback="/images/placeholder-product.svg" />
            }
            else
            {
                <div class="yq-home-story__placeholder"><i class="bi bi-gem"></i></div>
            }
        </div>
        <div class="yq-home-story__content">
            <span class="yq-home-hero__eyebrow"><i class="bi bi-award"></i> قصتنا</span>
            <h2 class="yq-home-section__title">فن صناعة العطور</h2>
            <p>
                منذ انطلاقتنا، تبنّت ياقوت رسالة واحدة: تقديم عطور فاخرة أصيلة تُروى من خلالها قصة
                كل رائحة. نختار مكوناتنا بعناية فائقة من أرقى دور العطور العالمية، لنمنحك تجربة
                حسية لا تُنسى تعكس فخامة الأناقة الشرقية والغربية في آنٍ واحد.
            </p>
            <a asp-controller="Products" asp-action="Index" class="btn-yaqut-outline">
                <i class="bi bi-stars"></i> اكتشف المجموعة الكاملة
            </a>
        </div>
    </section>

    <!-- PREMIUM SELECTION -->
    @if (premiumSelection.Any())
    {
        <section class="yq-home-section yq-reveal">
            <header class="yq-home-section__head">
                <div>
                    <h2 class="yq-home-section__title">المختارات الفاخرة</h2>
                    <p class="yq-home-section__sub">قطع حصرية مختارة لعشاق العطور الراقية</p>
                </div>
                <a asp-controller="Products" asp-action="Index" class="yq-home-section__link">
                    عرض الكل <i class="bi bi-arrow-left"></i>
                </a>
            </header>

            <div class="yq-home-products-grid">
                @foreach (var item in premiumSelection)
                {
                    <div class="yq-home-product-item">
                        <partial name="_ProductCard" model="item" />
                    </div>
                }
            </div>
        </section>
    }

    <!-- CTA BANNER -->
    <section class="yq-home-cta yq-reveal">
        <div class="yq-home-cta__content">
            <h2>ابدأ رحلتك مع ياقوت اليوم</h2>
            <p>تصفح مجموعتنا الكاملة من العطور الفاخرة واعثر على رائحتك المميزة.</p>
            <a asp-controller="Products" asp-action="Index" class="btn-yaqut-gold">
                <i class="bi bi-bag-heart"></i> تسوق الآن
            </a>
        </div>
    </section>

    <!-- WHY YAQUT -->
    <section class="yq-home-section yq-reveal">
        <header class="yq-home-section__head">
            <div>
                <h2 class="yq-home-section__title">لماذا ياقوت؟</h2>
                <p class="yq-home-section__sub">تجربة تسوق فاخرة لا مثيل لها</p>
            </div>
        </header>
        <div class="yq-home-features">
            <div class="yq-home-feature yq-glass">
                <i class="bi bi-gem"></i>
                <h3>عطور أصيلة 100%</h3>
                <p>نضمن أصالة جميع منتجاتنا من أرقى دور العطور العالمية</p>
            </div>
            <div class="yq-home-feature yq-glass">
                <i class="bi bi-truck"></i>
                <h3>شحن سريع ومجاني</h3>
                <p>توصيل مجاني للطلبات فوق 500 ر.س خلال 2-3 أيام عمل</p>
            </div>
            <div class="yq-home-feature yq-glass">
                <i class="bi bi-shield-check"></i>
                <h3>ضمان الجودة</h3>
                <p>استبدال أو استرجاع خلال 14 يوماً مع ضمان الرضا الكامل</p>
            </div>
        </div>
    </section>

</div>

@section Scripts {
    <script src="~/js/home/index.js" asp-append-version="true"></script>
}