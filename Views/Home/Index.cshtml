@model YAGOT_2._0.Services.ViewModels
@{
    ViewData["Title"] = "الرئيسية | ياقوت";
    ViewData["IsHomePage"] = true;

    var categories = Model.Categories?.ToList() ?? new List<YAGOT_2._0.Models.Category>();
    var inStockProducts = Model.Products?
        .Where(product => product.Stockquantity > 0)
        .ToList() ?? new List<YAGOT_2._0.Models.Product>();

    var newArrivals = inStockProducts
        .OrderByDescending(product => product.Createdat ?? DateTime.MinValue)
        .Take(8)
        .ToList();
    var premiumSelection = inStockProducts
        .OrderByDescending(product => product.Price)
        .Take(8)
        .ToList();
    var heroProducts = newArrivals
        .Where(product => !string.IsNullOrWhiteSpace(product.Imageurl))
        .Take(5)
        .ToList();

    var storeSettings = Model.StoreSettings ?? new YAGOT_2._0.Models.StoreSettings();
    var heroTitle = !string.IsNullOrWhiteSpace(storeSettings.HeroMarketingText)
        ? storeSettings.HeroMarketingText
        : "عطور مختارة تروي حضورك";
    var heroDescription = !string.IsNullOrWhiteSpace(storeSettings.HeroMarketingDesc)
        ? storeSettings.HeroMarketingDesc
        : "اكتشف تشكيلة ياقوت من العطور الشرقية والغربية الأصيلة، مختارة بعناية لترافق أجمل لحظاتك.";
    var configuredFeaturedCategory = storeSettings.FeaturedCategoryId.HasValue
        ? categories.FirstOrDefault(category => category.Id == storeSettings.FeaturedCategoryId.Value)
        : null;
    var featuredCategory = configuredFeaturedCategory ?? categories.FirstOrDefault();
    var brandNames = inStockProducts
        .Where(product => !string.IsNullOrWhiteSpace(product.Brand))
        .Select(product => product.Brand!.Trim())
        .Where(brand => brand != "-")
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(brand => brand)
        .ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/home/index.css" asp-append-version="true" />
}

<div class="yq-home-page" data-yq-auth-clear="@(TempData["Success"] != null ? "true" : "false")">
    <section class="yq-home-hero yq-home-hero--cinematic" aria-label="الرئيسية">
        @if (heroProducts.Any())
        {
            <div class="yq-home-hero__carousel-bg yq-home-carousel"
                 data-yq-hero-carousel
                 role="region"
                 aria-roledescription="عرض شرائح"
                 aria-label="أحدث عطور ياقوت">
                <div class="yq-home-carousel__viewport">
                    @for (var index = 0; index < heroProducts.Count; index++)
                    {
                        var product = heroProducts[index];
                        var imageUrl = product.Imageurl!.StartsWith("http", StringComparison.OrdinalIgnoreCase) || product.Imageurl.StartsWith("/")
                            ? product.Imageurl
                            : Url.Content("~/" + product.Imageurl.TrimStart('/'));
                        <article class="yq-home-carousel__slide @(index == 0 ? "is-active" : "")"
                                 data-yq-hero-slide
                                 aria-hidden="@(index == 0 ? "false" : "true")">
                            <div class="yq-home-hero__blurred-bg" style="background-image: url('@imageUrl');"></div>
                            <div class="yq-home-carousel__product">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="yq-home-carousel__product-link" aria-label="عرض @product.Name">
                                    <img src="@imageUrl"
                                         alt="@product.Name"
                                         loading="@(index == 0 ? "eager" : "lazy")"
                                         fetchpriority="@(index == 0 ? "high" : "auto")"
                                         decoding="async"
                                         data-yaqut-fallback="/images/placeholder-product.svg" />
                                </a>
                                <div class="yq-home-hero__overlay" aria-hidden="true"></div>
                                <div class="container yq-home-carousel__bottom-wrapper">
                                    <div class="yq-home-carousel__bottom-bar">
                                        <div class="yq-home-carousel__info">
                                            <small>@(string.IsNullOrWhiteSpace(product.Brand) ? "من مختارات ياقوت" : product.Brand)</small>
                                            <strong>@product.Name</strong>
                                            <span>@product.Price.ToString("N0") ر.س</span>
                                        </div>
                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="yq-home-button yq-home-button--primary">
                                            تسوّق الآن <i class="bi bi-arrow-left" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </article>
                    }
                </div>

                @if (heroProducts.Count > 1)
                {
                    <button type="button" class="yq-home-carousel__control yq-home-carousel__control--prev"
                            data-yq-hero-prev aria-label="العطر السابق">
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="yq-home-carousel__control yq-home-carousel__control--next"
                            data-yq-hero-next aria-label="العطر التالي">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i>
                    </button>
                    <div class="yq-home-carousel__dots" aria-label="اختيار العطر">
                        @for (var index = 0; index < heroProducts.Count; index++)
                        {
                            <button type="button"
                                    class="yq-home-carousel__dot @(index == 0 ? "is-active" : "")"
                                    data-yq-hero-dot="@index"
                                    aria-label="عرض العطر @(index + 1)"
                                    aria-current="@(index == 0 ? "true" : "false")"></button>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="yq-home-hero__carousel-bg yq-home-carousel yq-home-carousel--empty"
                 aria-label="ستظهر أحدث العطور هنا قريباً">
                <img src="~/images/placeholder-product.svg" alt="" />
            </div>
        }


    </section>

    @if (brandNames.Any())
    {
        <section class="container yq-home-brands" aria-label="الشركات المنتجة">
            <div class="yq-home-brands__viewport">
                <div class="yq-home-brands__track">
                    <div class="yq-home-brands__group">
                        @foreach (var brand in brandNames)
                        {
                            <a asp-controller="Products" asp-action="Index" asp-route-brand="@brand" class="yq-home-brand">@brand</a>
                        }
                    </div>
                    @for (int i = 1; i < 6; i++)
                    {
                        <div class="yq-home-brands__group" aria-hidden="true">
                            @foreach (var brand in brandNames)
                            {
                                <a asp-controller="Products" asp-action="Index" asp-route-brand="@brand" class="yq-home-brand" tabindex="-1">@brand</a>
                            }
                        </div>
                    }
                </div>
            </div>
        </section>
    }



    <section class="container yq-home-section" aria-labelledby="newArrivalsTitle">
        <header class="yq-home-section__head">
            <div>
                <span class="yq-home-kicker">مختار بعناية</span>
                <h2 id="newArrivalsTitle" class="yq-home-section__title">وصل حديثاً</h2>
                <p class="yq-home-section__sub">أحدث الإصدارات التي انضمت إلى مجموعة ياقوت</p>
            </div>
            <a asp-controller="Products" asp-action="Index" class="yq-home-section__link">عرض الكل <i class="bi bi-arrow-left"></i></a>
        </header>

        @if (newArrivals.Any())
        {
            <div class="yq-home-product-rail" tabindex="0" aria-label="منتجات وصلت حديثاً">
                @foreach (var product in newArrivals)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        }
        else
        {
            <div class="yq-home-empty"><i class="bi bi-droplet"></i><p>لا توجد عطور معروضة حالياً. عُد قريباً لاكتشاف الجديد.</p></div>
        }
    </section>

    @if (premiumSelection.Any())
    {
        <section class="container yq-home-section" aria-labelledby="premiumTitle">
            <header class="yq-home-section__head">
                <div>
                    <span class="yq-home-kicker">توقيع فاخر</span>
                    <h2 id="premiumTitle" class="yq-home-section__title">المختارات الفاخرة</h2>
                    <p class="yq-home-section__sub">قطع استثنائية لعشّاق الروائح الراقية</p>
                </div>
                <a asp-controller="Products" asp-action="Index" class="yq-home-section__link">عرض الكل <i class="bi bi-arrow-left"></i></a>
            </header>
            <div class="yq-home-product-rail" tabindex="0" aria-label="المختارات الفاخرة">
                @foreach (var product in premiumSelection)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        </section>
    }

    @if (categories.Any())
    {
        <section class="container yq-home-section" aria-labelledby="categoriesTitle">
            <header class="yq-home-section__head">
                <div>
                    <span class="yq-home-kicker">اعثر على عطرك</span>
                    <h2 id="categoriesTitle" class="yq-home-section__title">التصنيفات</h2>
                    <p class="yq-home-section__sub">استكشف التصنيفات المنسّقة حسب ذوقك</p>
                </div>
            </header>
            <div class="yq-home-categories" aria-label="تصنيفات العطور">
                @foreach (var category in categories)
                {
                    var categoryImage = string.IsNullOrWhiteSpace(category.Imageurl)
                        ? Url.Content("~/images/placeholder-product.svg")
                        : (category.Imageurl.StartsWith("http", StringComparison.OrdinalIgnoreCase) || category.Imageurl.StartsWith("/")
                            ? category.Imageurl
                            : Url.Content("~/" + category.Imageurl.TrimStart('/')));
                    <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@category.Id" class="yq-home-category">
                        <img src="@categoryImage" alt="@category.Name" loading="lazy" decoding="async"
                             data-yaqut-fallback="/images/placeholder-product.svg" />
                        <span><strong>@category.Name</strong><i class="bi bi-arrow-left" aria-hidden="true"></i></span>
                    </a>
                }
            </div>
        </section>
    }

    <section class="container yq-home-promise" aria-labelledby="promiseTitle">
        <div class="yq-home-promise__panel">
            <div>
                <span class="yq-home-kicker">تجربة تليق بك</span>
                <h2 id="promiseTitle">ابدأ رحلتك العطرية اليوم</h2>
                <p>عطور أصيلة، اختيار راقٍ، ودعم يساعدك في الوصول إلى عطرك المناسب.</p>
            </div>
            <a asp-controller="Products" asp-action="Index" class="yq-home-button yq-home-button--primary">تصفّح العطور <i class="bi bi-bag-heart"></i></a>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/home/index.js" asp-append-version="true"></script>
}
