@model YAGOT_2._0.Models.ContactMessageVM
@inject YAGOT_2._0.Services.StoreSettingsService StoreSettingsService
@{
    ViewData["Title"] = "تواصل معنا | ياقوت";
    var isSuccess = TempData["ContactSuccess"] != null;
    var storeSettings = StoreSettingsService.GetSettings();
    var whatsappNumber = string.Concat((storeSettings.WhatsAppNumber ?? string.Empty).Where(char.IsDigit));
    var hasContactInfo = !string.IsNullOrWhiteSpace(whatsappNumber)
        || !string.IsNullOrWhiteSpace(storeSettings.ContactEmail)
        || !string.IsNullOrWhiteSpace(storeSettings.InstagramLink)
        || !string.IsNullOrWhiteSpace(storeSettings.TwitterLink)
        || !string.IsNullOrWhiteSpace(storeSettings.TikTokLink);
}

@section Styles {
    <link rel="stylesheet" href="~/css/home/contact.css" asp-append-version="true" />
}

<div class="yq-contact">

    <!-- HEADER -->
    <header class="yq-contact-header yq-reveal">
        <span class="yq-contact-header__eyebrow"><i class="bi bi-headset"></i> نحن هنا لمساعدتك</span>
        <h1 class="yq-contact-header__title">تواصل معنا</h1>
        <p class="yq-contact-header__sub">
            لديك استفسار عن منتج، طلب، أو أي شيء آخر؟ فريق ياقوت جاهز للرد عليك.
        </p>
    </header>

    <div class="yq-contact-layout">

        <!-- CONTACT INFO -->
        <aside class="yq-contact-info yq-reveal">
            <div class="yq-contact-info__card yq-glass">
                <h2 class="yq-contact-info__title">طرق التواصل</h2>
                @if (!hasContactInfo)
                {
                    <p class="yq-contact-info__note">
                        لم تتم إضافة قنوات التواصل بعد.
                    </p>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(whatsappNumber))
                    {
                        <p class="yq-contact-info__note">
                            <i class="bi bi-whatsapp"></i>
                            <a href="https://wa.me/@whatsappNumber" target="_blank" rel="noopener noreferrer">@storeSettings.WhatsAppNumber</a>
                        </p>
                    }
                    @if (!string.IsNullOrWhiteSpace(storeSettings.ContactEmail))
                    {
                        <p class="yq-contact-info__note">
                            <i class="bi bi-envelope"></i>
                            <a href="mailto:@storeSettings.ContactEmail">@storeSettings.ContactEmail</a>
                        </p>
                    }
                }

                @if (!string.IsNullOrWhiteSpace(storeSettings.InstagramLink)
                    || !string.IsNullOrWhiteSpace(storeSettings.TwitterLink)
                    || !string.IsNullOrWhiteSpace(storeSettings.TikTokLink))
                {
                    <div class="yq-contact-social">
                        <span class="yq-contact-social__label">تابعنا</span>
                        <div class="yq-contact-social__links">
                            @if (!string.IsNullOrWhiteSpace(storeSettings.InstagramLink))
                            {
                                <a href="@storeSettings.InstagramLink" target="_blank" rel="noopener noreferrer" aria-label="إنستغرام"><i class="bi bi-instagram"></i></a>
                            }
                            @if (!string.IsNullOrWhiteSpace(storeSettings.TwitterLink))
                            {
                                <a href="@storeSettings.TwitterLink" target="_blank" rel="noopener noreferrer" aria-label="X"><i class="bi bi-twitter-x"></i></a>
                            }
                            @if (!string.IsNullOrWhiteSpace(storeSettings.TikTokLink))
                            {
                                <a href="@storeSettings.TikTokLink" target="_blank" rel="noopener noreferrer" aria-label="تيك توك"><i class="bi bi-tiktok"></i></a>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="yq-contact-info__card yq-glass">
                <h2 class="yq-contact-info__title"><i class="bi bi-clock"></i> زمن الرد</h2>
                <p class="yq-contact-info__note">
                    نسعى للرد على جميع الرسائل في أقرب وقت ممكن خلال أيام العمل.
                </p>
            </div>
        </aside>

        <!-- CONTACT FORM -->
        <section class="yq-contact-form-wrap yq-glass yq-reveal">
            @if (isSuccess)
            {
                <div class="yq-contact-success" id="yqContactSuccess" role="status" aria-live="polite">
                    <div class="yq-contact-success__icon"><i class="bi bi-check-lg"></i></div>
                    <h2>تم إرسال رسالتك بنجاح</h2>
                    <p>شكراً لتواصلك مع ياقوت. سنقوم بالرد عليك في أقرب وقت ممكن.</p>
                </div>
            }
            else
            {
                <h2 class="yq-contact-form__title">أرسل لنا رسالة</h2>

                <form asp-controller="Home" asp-action="Contact" method="post" data-yq-validate novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="yaqut-alert yaqut-alert--danger"></div>

                    <div class="yq-contact-form__row">
                        <div class="yaqut-form-group">
                            <label asp-for="Name" class="yaqut-form-label">الاسم الكامل</label>
                            <div class="yaqut-input-wrap">
                                <i class="bi bi-person"></i>
                                <input asp-for="Name" class="yaqut-form-input" placeholder="اسمك الكامل" required minlength="2" aria-describedby="ContactNameValidation" />
                            </div>
                            <span asp-validation-for="Name" id="ContactNameValidation" class="text-danger small"></span>
                        </div>

                        <div class="yaqut-form-group">
                            <label asp-for="Email" class="yaqut-form-label">البريد الإلكتروني</label>
                            <div class="yaqut-input-wrap">
                                <i class="bi bi-envelope"></i>
                                <input asp-for="Email" type="email" class="yaqut-form-input" placeholder="example@email.com" required aria-describedby="ContactEmailValidation" />
                            </div>
                            <span asp-validation-for="Email" id="ContactEmailValidation" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="yq-contact-form__row">
                        <div class="yaqut-form-group">
                            <label asp-for="Phone" class="yaqut-form-label">رقم الجوال <span class="yq-contact-optional">(اختياري)</span></label>
                            <div class="yaqut-input-wrap">
                                <i class="bi bi-phone"></i>
                                <input asp-for="Phone" type="tel" class="yaqut-form-input" placeholder="05XXXXXXXX" aria-describedby="ContactPhoneValidation" />
                            </div>
                            <span asp-validation-for="Phone" id="ContactPhoneValidation" class="text-danger small"></span>
                        </div>

                        <div class="yaqut-form-group">
                            <label asp-for="Subject" class="yaqut-form-label">الموضوع</label>
                            <div class="yaqut-input-wrap">
                                <i class="bi bi-chat-text"></i>
                                <input asp-for="Subject" class="yaqut-form-input" placeholder="موضوع رسالتك" required aria-describedby="ContactSubjectValidation" />
                            </div>
                            <span asp-validation-for="Subject" id="ContactSubjectValidation" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="yaqut-form-group">
                        <label asp-for="Message" class="yaqut-form-label">الرسالة</label>
                        <textarea asp-for="Message" rows="5" class="yaqut-form-input" placeholder="اكتب رسالتك هنا..." required minlength="10" aria-describedby="ContactMessageValidation"></textarea>
                        <span asp-validation-for="Message" id="ContactMessageValidation" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn-yaqut-gold yq-contact-submit-btn">
                        <i class="bi bi-send"></i> إرسال الرسالة
                    </button>
                </form>
            }
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/home/contact.js" asp-append-version="true"></script>
}
