@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "الحساب محظور";
    var whatsAppUrl = ViewBag.WhatsAppUrl as string;
    var storePhone = ViewBag.StorePhone as string;
}

<div class="yaqut-auth-page">
    <article class="yaqut-auth-card yaqut-auth-card--single text-center">
        <div class="yaqut-auth-card__shine" aria-hidden="true"></div>
        <div class="yaqut-auth-card__body py-4">
            <div class="mb-4">
                <div style="width: 80px; height: 80px; margin: 0 auto; border-radius: 50%; background: rgba(239, 68, 68, 0.12); border: 2px solid rgba(239, 68, 68, 0.35); color: #ef4444; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; box-shadow: 0 0 25px rgba(239, 68, 68, 0.2);">
                    <i class="bi bi-slash-circle-fill"></i>
                </div>
            </div>

            <h1 class="yaqut-auth-title text-danger mb-2">تم حظر هذا الحساب</h1>
            <p class="yaqut-auth-subtitle mb-4">
                تم تقييد وصول حسابك إلى المتجر من قبل الإدارة. لا يمكنك حالياً إتمام عمليات الشراء أو الوصول إلى لوحة التحكم أو ميزات الحساب.
            </p>

            <div class="yaqut-alert yaqut-alert--danger mb-4" role="alert">
                <i class="bi bi-shield-lock-fill me-2"></i>
                إذا كنت تعتقد أن هذا الإجراء تم عن طريق الخطأ أو ترغب في إعادة تفعيل حسابك، يرجى التواصل مباشرة مع إدارة المتجر.
            </div>

            <div class="d-flex flex-column gap-3 mt-4">
                @if (!string.IsNullOrWhiteSpace(whatsAppUrl))
                {
                    <a href="@whatsAppUrl" target="_blank" rel="noopener noreferrer" class="btn btn-success btn-lg py-3 fw-bold d-inline-flex align-items-center justify-content-center gap-2 rounded-3 shadow-sm" style="background-color: #25D366; border-color: #25D366;">
                        <i class="bi bi-whatsapp fs-5"></i>
                        <span>التواصل مع إدارة المتجر عبر واتساب</span>
                    </a>
                }
                else if (!string.IsNullOrWhiteSpace(storePhone))
                {
                    <a href="tel:@storePhone" class="btn btn-success btn-lg py-3 fw-bold d-inline-flex align-items-center justify-content-center gap-2 rounded-3 shadow-sm">
                        <i class="bi bi-telephone-fill fs-5"></i>
                        <span>الاتصال بإدارة المتجر (@storePhone)</span>
                    </a>
                }

                <a asp-controller="Home" asp-action="Index" class="btn-yaqut-outline py-2 mt-2">
                    <i class="bi bi-house-door me-1"></i> العودة للصفحة الرئيسية
                </a>
            </div>
        </div>
    </article>
</div>
