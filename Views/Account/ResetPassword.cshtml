@model ResetPasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "تعيين كلمة مرور جديدة";
    var invalidToken = ViewData["ResetError"] is string;
}

<div class="yaqut-auth-page">
    <article class="yaqut-auth-card" style="grid-template-columns: 1fr; max-width: 550px; margin: 0 auto;">
        <div class="yaqut-auth-card__shine" aria-hidden="true"></div>
        <div class="yaqut-auth-card__body">
            <div class="yaqut-auth-logo">
                <div class="yaqut-logo-wrap yaqut-logo-wrap--auth">
                    <img src="~/images/yaqut-logo.png" alt="ياقوت" class="yaqut-logo" />
                </div>
            </div>

            <h1 class="yaqut-auth-title">تعيين كلمة مرور جديدة</h1>

            @if (invalidToken)
            {
                <div class="yaqut-alert yaqut-alert--danger" role="alert">@ViewData["ResetError"]</div>
                <a asp-action="RecoveryAccount" class="btn-yaqut-gold yaqut-auth-submit" style="text-decoration:none;">
                    طلب رابط جديد
                </a>
            }
            else
            {
                <div asp-validation-summary="ModelOnly" class="yaqut-alert yaqut-alert--danger"></div>
                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="Token" type="hidden" />

                    <div class="yaqut-form-group">
                        <label asp-for="Password" class="yaqut-form-label">كلمة المرور الجديدة</label>
                        <div class="yaqut-input-wrap">
                            <i class="bi bi-shield-lock"></i>
                            <input asp-for="Password" type="password" class="yaqut-form-input"
                                   required minlength="6" autocomplete="new-password" />
                        </div>
                        <span asp-validation-for="Password" class="yq-field-error"></span>
                    </div>

                    <div class="yaqut-form-group">
                        <label asp-for="ConfirmPassword" class="yaqut-form-label">تأكيد كلمة المرور</label>
                        <div class="yaqut-input-wrap">
                            <i class="bi bi-shield-check"></i>
                            <input asp-for="ConfirmPassword" type="password" class="yaqut-form-input"
                                   required minlength="6" autocomplete="new-password" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="yq-field-error"></span>
                    </div>

                    <button type="submit" class="btn-yaqut-gold yaqut-auth-submit">
                        حفظ كلمة المرور
                    </button>
                </form>
            }
        </div>
    </article>
</div>
