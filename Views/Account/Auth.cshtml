@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "بوابة الدخول";
    var returnUrl = ViewData["ReturnUrl"] as string ?? "/Home/Index";
    var showRegisterPanel = (ViewData["ShowRegister"] as bool?) == true || (TempData["ShowRegister"] as bool?) == true;
}

<div class="yaqut-auth-page yq-login-view @(showRegisterPanel ? "is-register-active" : "is-login-active")" data-yq-auth-root data-yq-auth-initial="@(showRegisterPanel ? "register" : "login")">
    <article class="yaqut-auth-card yq-login-card" aria-labelledby="authPageTitle">
        <div class="yaqut-auth-card__shine" aria-hidden="true"></div>
        <aside class="yaqut-auth-card__visual yq-login-visual" aria-label="تجربة حساب ياقوت">
            <div class="yq-login-visual__brand" aria-hidden="true">
                <img src="~/images/yaqut-logo.png" alt="" />
            </div>
            <div class="yq-login-visual__content">
                <span class="yaqut-auth-card__eyebrow">Yaqut Private Access</span>
                <h2>دخول هادئ لتجربة عطور أكثر خصوصية</h2>
                <p>تابع الطلبات، احفظ بياناتك بأمان، وعد إلى رحلتك الشرائية من النقطة نفسها.</p>
            </div>
            <div class="yaqut-auth-perks" aria-label="مزايا الحساب">
                <span><i class="bi bi-shield-check" aria-hidden="true"></i> جلسة محمية</span>
                <span><i class="bi bi-bag-heart" aria-hidden="true"></i> سلة محفوظة</span>
                <span><i class="bi bi-stars" aria-hidden="true"></i> تجربة مخصصة</span>
            </div>
        </aside>
        <div class="yaqut-auth-card__body">

            <div class="yaqut-auth-logo">
                <div class="yaqut-logo-wrap yaqut-logo-wrap--auth">
                    <img src="~/images/yaqut-logo.png" alt="ياقوت" class="yaqut-logo" />
                </div>
            </div>

            <header class="yaqut-auth-heading">
                <span class="yq-login-kicker">حساب العملاء</span>
                <h1 id="authPageTitle" class="yaqut-auth-title">مرحباً بك في ياقوت</h1>
                <p class="yaqut-auth-subtitle">سجّل الدخول لإكمال الشراء ومتابعة طلباتك، أو أنشئ حساباً جديداً خلال لحظات.</p>
            </header>

            <div class="yaqut-auth-tabs" role="tablist" aria-label="اختيار نوع الدخول">
                <button type="button"
                        class="yaqut-auth-tab @(showRegisterPanel ? "" : "is-active")"
                        id="loginToggle"
                        role="tab"
                        aria-controls="loginPanel"
                        aria-selected="@(showRegisterPanel ? "false" : "true")"
                        tabindex="@(showRegisterPanel ? "-1" : "0")">
                    <i class="bi bi-box-arrow-in-left" aria-hidden="true"></i> دخول
                </button>
                <button type="button"
                        class="yaqut-auth-tab @(showRegisterPanel ? "is-active" : "")"
                        id="registerToggle"
                        role="tab"
                        aria-controls="registerPanel"
                        aria-selected="@(showRegisterPanel ? "true" : "false")"
                        tabindex="@(showRegisterPanel ? "0" : "-1")">
                    <i class="bi bi-person-plus" aria-hidden="true"></i> حساب جديد
                </button>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="yaqut-alert yaqut-alert--danger" role="alert">
                    <strong>يرجى مراجعة البيانات التالية:</strong>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <div id="loginPanel"
                 class="auth-panel @(showRegisterPanel ? "d-none" : "")"
                 role="tabpanel"
                 aria-labelledby="loginToggle"
                 aria-hidden="@(showRegisterPanel ? "true" : "false")"
                 tabindex="0">
                <form asp-controller="Account" asp-action="Login" method="post" class="yaqut-auth-form" data-yq-validate novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />

                    <div class="yaqut-form-group">
                        <label class="yaqut-form-label" for="loginPhone">رقم الجوال</label>
                        <div class="yaqut-input-wrap">
                            <i class="bi bi-phone" aria-hidden="true"></i>
                            <input id="loginPhone" name="Phone" type="tel" class="yaqut-form-input"
                                   placeholder="ادخل رقم الجوال"
                                   required
                                   autocomplete="tel"
                                   inputmode="numeric"
                                   pattern="[0-9]{9}"
                                   minlength="9"
                                   maxlength="9"
                                   aria-describedby="loginPhoneHint loginPhoneError" />
                        </div>
                        <p id="loginPhoneHint" class="yq-field-hint">استخدم رقم الجوال المكوّن من 9 أرقام.</p>
                        <div id="loginPhoneError" class="yq-field-error" data-yq-error-for="loginPhone" aria-live="polite"></div>
                    </div>

                    <div class="yaqut-form-group">
                        <label class="yaqut-form-label" for="loginPassword">كلمة المرور</label>
                        <div class="yaqut-input-wrap">
                            <i class="bi bi-lock" aria-hidden="true"></i>
                            <input id="loginPassword" name="Password" type="password" class="yaqut-form-input"
                                   placeholder="أدخل كلمة المرور"
                                   required
                                   autocomplete="current-password"
                                   minlength="6"
                                   aria-describedby="loginPasswordError" />
                        </div>
                        <div id="loginPasswordError" class="yq-field-error" data-yq-error-for="loginPassword" aria-live="polite"></div>
                    </div>

                    <button type="submit" class="btn-yaqut-gold yaqut-auth-submit">
                        <i class="bi bi-unlock" aria-hidden="true"></i> تسجيل الدخول
                    </button>
                </form>
                <div class="yaqut-auth-help">
                    <span><i class="bi bi-question-circle" aria-hidden="true"></i> تحتاج لاستعادة الوصول؟</span>
                    <a asp-controller="Account" asp-action="RecoveryAccount">نسيت أو تريد تغيير كلمة المرور</a>
                </div>
            </div>

            <div id="registerPanel"
                 class="auth-panel yq-register-panel @(showRegisterPanel ? "" : "d-none")"
                 role="tabpanel"
                 aria-labelledby="registerToggle"
                 aria-hidden="@(showRegisterPanel ? "false" : "true")"
                 tabindex="0">
                <form asp-controller="Account" asp-action="Register" method="post" class="yaqut-auth-form yq-register-form" data-yq-validate novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <input name="Email" value='@TempData["Email"]' type="hidden" />

                    <div class="yq-register-intro" aria-labelledby="registerIntroTitle">
                        <span class="yq-register-intro__icon" aria-hidden="true">
                            <i class="bi bi-person-hearts"></i>
                        </span>
                        <div>
                            <h2 id="registerIntroTitle">أنشئ حسابك بخطوات واضحة</h2>
                            <p>املأ البيانات الأساسية، اربط بريدك عبر Google، ثم اختر كلمة مرور آمنة لإكمال التسجيل.</p>
                        </div>
                    </div>

                    <section class="yaqut-auth-form-section yq-register-section yq-register-section--identity" aria-labelledby="registerIdentityTitle">
                        <h2 id="registerIdentityTitle" class="yaqut-auth-form-section__title">
                            <i class="bi bi-person-vcard" aria-hidden="true"></i> بيانات الحساب
                        </h2>
                        <p class="yq-register-section__note">سنستخدم هذه البيانات لتجربة شراء أسرع ومتابعة الطلبات بدقة.</p>

                        <div class="yaqut-form-group">
                            <label class="yaqut-form-label" for="regName">الاسم الكامل <span class="yq-required-mark">مطلوب</span></label>
                            <div class="yaqut-input-wrap">
                                <i class="bi bi-person" aria-hidden="true"></i>
                                <input id="regName" name="Name" type="text" class="yaqut-form-input"
                                       placeholder="اسمك الكامل"
                                       required
                                       autocomplete="name"
                                       minlength="2"
                                       aria-describedby="regNameHint regNameError" />
                            </div>
                            <p id="regNameHint" class="yq-field-hint">اكتب الاسم كما تفضّل أن يظهر في حسابك وطلباتك.</p>
                            <div id="regNameError" class="yq-field-error" data-yq-error-for="regName" aria-live="polite"></div>
                        </div>

                        <div class="yaqut-auth-field-row">
                            <div class="yaqut-form-group">
                                <label class="yaqut-form-label" for="regPhone">رقم الجوال <span class="yq-required-mark">مطلوب</span></label>
                                <div class="yaqut-input-wrap">
                                    <i class="bi bi-phone" aria-hidden="true"></i>
                                    <input id="regPhone" name="Phone" type="tel" class="yaqut-form-input"
                                           placeholder="ادخل رقم الجوال"
                                           required
                                           autocomplete="tel"
                                           inputmode="numeric"
                                           pattern="[0-9]{9}"
                                           minlength="9"
                                           maxlength="9"
                                           aria-describedby="regPhoneHint regPhoneError" />
                                </div>
                                <p id="regPhoneHint" class="yq-field-hint">9 أرقام فقط بدون مفتاح الدولة أو مسافات.</p>
                                <div id="regPhoneError" class="yq-field-error" data-yq-error-for="regPhone" aria-live="polite"></div>
                            </div>

                            <div class="yaqut-form-group">
                                <label class="yaqut-form-label" for="regConfirmPhone">تأكيد رقم الجوال <span class="yq-required-mark">مطلوب</span></label>
                                <div class="yaqut-input-wrap">
                                    <i class="bi bi-phone-flip" aria-hidden="true"></i>
                                    <input id="regConfirmPhone" name="ConfirmPhone" type="tel" class="yaqut-form-input"
                                           placeholder="أعد كتابة رقم الجوال"
                                           required
                                           autocomplete="tel"
                                           inputmode="numeric"
                                           pattern="[0-9]{9}"
                                           minlength="9"
                                           maxlength="9"
                                           aria-describedby="regConfirmPhoneHint regConfirmPhoneError" />
                                </div>
                                <p id="regConfirmPhoneHint" class="yq-field-hint">يساعدنا التأكيد على منع أخطاء التواصل والتوصيل.</p>
                                <div id="regConfirmPhoneError" class="yq-field-error" data-yq-error-for="regConfirmPhone" aria-live="polite"></div>
                            </div>
                        </div>
                    </section>

                    <section class="yaqut-auth-form-section yq-register-section yq-register-section--email" aria-labelledby="registerEmailTitle">
                        <h2 id="registerEmailTitle" class="yaqut-auth-form-section__title">
                            <i class="bi bi-envelope-check" aria-hidden="true"></i> البريد الإلكتروني
                        </h2>
                        <p class="yq-register-section__note">ربط البريد يؤكد ملكية الحساب ويجعل استعادته أسهل عند الحاجة.</p>
                        <a asp-controller="Account"
                           asp-action="GoogleLogin"
                           class="google-btn-rect yq-register-google"
                           aria-describedby="registerEmailHelp">
                            <div class="google-icon-wrapper">
                                <svg class="google-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
                                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05" />
                                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.53 12-4.53z" fill="#EA4335" />
                                </svg>
                            </div>
                            <span class="google-btn-text">ربط البريد بواسطة Google</span>
                        </a>
                        @{
                            if (TempData["Email"] == null)
                            {
                                <p id="registerEmailHelp" class="yaqut-auth-email-status yaqut-auth-email-status--error">
                                    <i class="bi bi-exclamation-circle" aria-hidden="true"></i> اربط البريد بواسطة Google قبل إنشاء الحساب.
                                </p>
                            }
                            else
                            {
                                <p id="registerEmailHelp" class="yaqut-auth-email-status yaqut-auth-email-status--success">
                                    <i class="bi bi-check-circle" aria-hidden="true"></i> @TempData["Email"]
                                </p>
                            }
                        }
                    </section>

                    <section class="yaqut-auth-form-section yq-register-section yq-register-section--security" aria-labelledby="registerSecurityTitle">
                        <h2 id="registerSecurityTitle" class="yaqut-auth-form-section__title">
                            <i class="bi bi-shield-lock" aria-hidden="true"></i> حماية الحساب
                        </h2>
                        <p class="yq-register-section__note">اختر كلمة مرور لا تقل عن 6 أحرف، ويفضل أن تجمع بين حروف وأرقام.</p>
                        <div class="yaqut-auth-field-row">
                            <div class="yaqut-form-group">
                                <label class="yaqut-form-label" for="regPassword">كلمة المرور <span class="yq-required-mark">مطلوب</span></label>
                                <div class="yaqut-input-wrap">
                                    <i class="bi bi-shield-lock" aria-hidden="true"></i>
                                    <input id="regPassword" name="Password" type="password" class="yaqut-form-input"
                                           placeholder="6 أحرف على الأقل"
                                           required
                                           autocomplete="new-password"
                                           minlength="6"
                                           aria-describedby="regPasswordHint regPasswordError" />
                                </div>
                                <p id="regPasswordHint" class="yq-field-hint">استخدم كلمة مرور يسهل عليك تذكرها ويصعب تخمينها.</p>
                                <div id="regPasswordError" class="yq-field-error" data-yq-error-for="regPassword" aria-live="polite"></div>
                            </div>

                            <div class="yaqut-form-group">
                                <label class="yaqut-form-label" for="regConfirm">تأكيد كلمة المرور <span class="yq-required-mark">مطلوب</span></label>
                                <div class="yaqut-input-wrap">
                                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                                    <input id="regConfirm" name="ConfirmPassword" type="password" class="yaqut-form-input"
                                           placeholder="أعد كتابة كلمة المرور"
                                           required
                                           autocomplete="new-password"
                                           minlength="6"
                                           aria-describedby="regConfirmHint regConfirmError" />
                                </div>
                                <p id="regConfirmHint" class="yq-field-hint">أعد كتابة كلمة المرور للتأكد من عدم وجود خطأ.</p>
                                <div id="regConfirmError" class="yq-field-error" data-yq-error-for="regConfirm" aria-live="polite"></div>
                            </div>
                        </div>
                    </section>

                    <div class="yq-register-actions">
                        <p>
                            <i class="bi bi-lock" aria-hidden="true"></i>
                            بالمتابعة سيتم إنشاء حساب آمن وربطه بسلة التسوق وطلباتك القادمة.
                        </p>
                        <button type="submit" class="btn-yaqut-gold yaqut-auth-submit">
                            <i class="bi bi-stars" aria-hidden="true"></i> إنشاء حساب
                        </button>
                    </div>
                </form>
            </div>

            <p class="yaqut-auth-footnote">
                <i class="bi bi-shield-lock" aria-hidden="true"></i>
                جلستك محمية وتتجدد تلقائياً لمدة يوم
            </p>
        </div>
    </article>
</div>
