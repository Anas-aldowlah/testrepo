@model YAGOT_2._0.Models.Cart
@using YAGOT_2._0.Services
@{
    ViewData["Title"] = "سلة المشتريات";
    var items = Model?.Cartitems?.ToList() ?? new List<YAGOT_2._0.Models.Cartitem>();
    decimal UnitPrice(YAGOT_2._0.Models.Cartitem item) => item.RetailPrice?.Price ?? item.Product?.Price ?? 0;
    int MaxUnits(YAGOT_2._0.Models.Cartitem item)
    {
        if (item.Product == null) return item.Quantity;
        if (item.RetailPrice?.SizeMl > 0) return item.Product.Stockquantity / item.RetailPrice.SizeMl;
        if (item.Product.StockUnit == "Ml" && item.Product.VolumeMl is > 0) return item.Product.Stockquantity / item.Product.VolumeMl.Value;
        return item.Product.Stockquantity;
    }
    string UnitLabel(YAGOT_2._0.Models.Cartitem item) => item.RetailPrice?.SizeMl > 0
        ? $"{item.RetailPrice.SizeMl} ml"
        : (item.Product?.StockUnit == "Ml" && item.Product.VolumeMl is > 0 ? $"{item.Product.VolumeMl.Value} ml" : "للقطعة");
    decimal subtotal = items.Sum(i => i.Quantity * UnitPrice(i));
    var remainingForFreeShipping = ShippingPolicy.RemainingForFreeShipping(subtotal);
    var qualifiesForFreeShipping = ShippingPolicy.QualifiesForFreeShipping(subtotal);
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/cart/index.css" asp-append-version="true" />
}

<div class="yq-cart" data-yq-cart-page>

    <header class="yq-cart-header yq-reveal">
        <div>
            <h1 class="yq-cart-header__title"><i class="bi bi-bag"></i> سلة المشتريات</h1>
            @if (items.Any())
            {
                <p class="yq-cart-header__sub">@items.Count @(items.Count == 1 ? "منتج" : "منتجات") في سلتك</p>
            }
        </div>
        <a asp-controller="Products" asp-action="Index" class="yq-cart-continue-link">
            <i class="bi bi-arrow-left"></i> متابعة التسوق
        </a>
    </header>

    @if (TempData["Message"] != null)
    {
        <div class="yaqut-alert yaqut-alert--danger yq-reveal" role="alert" aria-live="polite">
            <i class="bi bi-exclamation-circle"></i> @TempData["Message"]
        </div>
    }

    @if (items.Any())
    {
        <div class="yq-cart-layout">

            <!-- CART ITEMS -->
            <div class="yq-cart-items yq-reveal">
                @foreach (var item in items)
                {
                    var lineTotal = item.Quantity * UnitPrice(item);
                    var maxUnits = MaxUnits(item);
                    <article class="yq-cart-item yq-glass" data-yq-cart-item>
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Product?.Id"
                           class="yq-cart-item__media">
                            <img src="@(item.Product?.Imageurl ?? "/images/placeholder-product.svg")"
                                 alt="@item.Product?.Name"
                                 data-yaqut-fallback="/images/placeholder-product.svg" />
                        </a>

                        <div class="yq-cart-item__body">
                            <div class="yq-cart-item__head">
                                <div>
                                    @if (!string.IsNullOrEmpty(item.Product?.Category?.Name))
                                    {
                                        <span class="yq-cart-item__category">@item.Product.Category.Name</span>
                                    }
                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Product?.Id"
                                       class="yq-cart-item__name">@item.Product?.Name</a>
                                </div>
                                <form asp-controller="Cart" asp-action="Remove" method="post" class="yq-cart-item__remove-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="cartItemId" value="@item.Id" />
                                    <input type="hidden" name="productId" value="@item.Productid" />
                                    <input type="hidden" name="retailPriceId" value="@item.RetailPriceId" />
                                    <button type="submit" class="yq-cart-item__remove" aria-label="إزالة @item.Product?.Name من السلة">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </div>

                            <div class="yq-cart-item__footer">
                                <form asp-controller="Cart" asp-action="Update" method="post" class="yq-cart-item__qty-block" data-yq-cart-qty-form>
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="cartItemId" value="@item.Id" />
                                    <input type="hidden" name="productId" value="@item.Productid" />
                                    <input type="hidden" name="retailPriceId" value="@item.RetailPriceId" />
                                    <input type="hidden" name="quantity" value="@item.Quantity" data-yq-cart-qty-value />
                                    <input type="hidden" name="expectedQuantity" value="@item.Quantity" data-yq-cart-qty-expected />
                                    <span class="yq-cart-item__qty-label">الكمية</span>
                                    <div class="yq-cart-item__qty-control">
                                        <select class="yq-cart-item__qty-select"
                                                data-yq-cart-qty-select
                                                aria-label="كمية @item.Product?.Name">
                                            @for (var quantityOption = 1; quantityOption <= 5; quantityOption++)
                                            {
                                                <option value="@quantityOption"
                                                        selected="@(item.Quantity == quantityOption)"
                                                        disabled="@(quantityOption > maxUnits)">
                                                    @quantityOption
                                                </option>
                                            }
                                            <option value="custom" selected="@(item.Quantity > 5)"
                                                    disabled="@(maxUnits <= 5)">
                                                أكثر من 5 (5+)
                                            </option>
                                        </select>
                                        <input type="number"
                                               value="@item.Quantity"
                                               min="1"
                                               max="@maxUnits"
                                               class="yq-cart-item__qty-input @(item.Quantity <= 5 ? "d-none" : null)"
                                               data-yq-cart-qty-custom
                                               inputmode="numeric"
                                               aria-label="كمية @item.Product?.Name" />
                                        <span class="yq-cart-item__qty-spinner spinner-border spinner-border-sm"
                                              data-yq-cart-qty-spinner hidden
                                              role="status"
                                              aria-label="جاري تحديث الكمية"></span>
                                    </div>
                                </form>

                                <div class="yq-cart-item__pricing">
                                    <span class="yq-cart-item__unit-price">
                                        @UnitPrice(item).ToString("N0") ر.س / @UnitLabel(item)
                                    </span>
                                    <span class="yq-cart-item__line-total">
                                        @lineTotal.ToString("N0") <small>ر.س</small>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            </div>

            <!-- ORDER SUMMARY -->
            <aside class="yq-cart-summary yq-reveal">
                <div class="yq-cart-summary__content">
                    <h2 class="yq-cart-summary__title">
                        <i class="bi bi-receipt"></i> الفاتورة الإجمالية
                    </h2>

                    <div class="yq-cart-summary__total-box">
                        <span class="yq-cart-summary__total-label">الإجمالي النهائي</span>
                        <div class="yq-cart-summary__total-value">
                            <span data-yq-summary-total>@subtotal.ToString("N0")</span>
                            <small>ر.س</small>
                        </div>
                    </div>
                </div>

                <a asp-controller="Orders"
                   asp-action="Checkout"
                   class="btn-yaqut-gold yq-cart-checkout-btn"
                   data-yq-cart-checkout-link
                   data-yq-auth-required="@((!isAuthenticated).ToString().ToLowerInvariant())"
                   data-yq-auth-modal="yqCheckoutAuthModal">
                    <i class="bi bi-credit-card"></i> إتمام الطلب والدفع
                </a>

                <a asp-controller="Products" asp-action="Index" class="yq-cart-summary__continue">
                    <i class="bi bi-arrow-left"></i> متابعة التسوق
                </a>

            </aside>
        </div>
    }
    else
    {
        <div class="yq-cart-empty yq-glass yq-reveal">
            <div class="yq-cart-empty__icon"><i class="bi bi-bag-x"></i></div>
            <h2 class="yq-cart-empty__title">سلتك فارغة حالياً</h2>
            <p class="yq-cart-empty__text">
                لم تُضف أي منتجات إلى سلتك بعد. تصفّح منتجاتنا الفاخرة واعثر على عطرك المميز.
            </p>
            <a asp-controller="Products" asp-action="Index" class="btn-yaqut-gold mt-3">
                <i class="bi bi-stars"></i> تصفح المنتجات
            </a>
        </div>
    }
</div>

<div class="visually-hidden" data-yq-cart-live aria-live="polite" aria-atomic="true"></div>

@section Scripts {
    <script src="~/js/cart/index.js" asp-append-version="true"></script>
}
