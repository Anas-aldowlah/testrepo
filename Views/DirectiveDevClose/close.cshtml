@model YAGOT_2._0.Models.SiteMaintenanceViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تجديد الاشتراك | المنصة الإلكترونية</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/fonts/font-delivery.css" asp-append-version="true" />
    <style nonce="@Context.Items["csp-nonce"]">
        .yq-container-max { max-width: 1140px; margin: 0 auto; }
        /* ===== RESET & BASE ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        .fa-solid.fa-arrow-right-from-bracket::before {
            content: "\f1c3";
            display: inline-block;
            font-family: "bootstrap-icons";
            font-style: normal;
            font-weight: normal;
            line-height: 1;
            vertical-align: -.125em;
        }

        body {
            font-family: 'Tajawal', 'Segoe UI', sans-serif;
            background: linear-gradient(145deg, #0f172a 0%, #1e1b4b 50%, #0f172a 100%);
            color: #f1f5f9;
            min-height: 100vh;
            padding-bottom: 3rem;
            position: relative;
        }

            /* خلفية نجوم متحركة (عصرية) */
            body::before {
                content: '';
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background-image: radial-gradient(1px 1px at 10% 20%, rgba(255,255,255,0.3), transparent), radial-gradient(1px 1px at 30% 60%, rgba(255,255,255,0.2), transparent), radial-gradient(1.5px 1.5px at 50% 10%, rgba(255,255,255,0.25), transparent), radial-gradient(1px 1px at 70% 80%, rgba(255,255,255,0.15), transparent), radial-gradient(1px 1px at 90% 40%, rgba(255,255,255,0.2), transparent), radial-gradient(1.5px 1.5px at 15% 90%, rgba(255,255,255,0.15), transparent), radial-gradient(1px 1px at 65% 30%, rgba(255,255,255,0.2), transparent);
                background-size: 100% 100%;
                pointer-events: none;
                z-index: 0;
                animation: twinkle 4s ease-in-out infinite alternate;
            }

        @@keyframes twinkle {
            0%

        {
            opacity: 0.3;
        }

        100% {
            opacity: 0.8;
        }

        }

        .container {
            position: relative;
            z-index: 1;
        }

        /* ===== شريط التنبيه العلوي الثابت (عصري) ===== */
        .sticky-alert-banner {
            position: sticky;
            top: 0;
            z-index: 1050;
            background: linear-gradient(135deg, #ec4899, #f59e0b);
            color: #ffffff;
            font-weight: 600;
            text-align: center;
            padding: 0.9rem 1rem;
            box-shadow: 0 8px 32px rgba(236, 72, 153, 0.25);
            font-size: 0.95rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            backdrop-filter: blur(4px);
        }

            .sticky-alert-banner i {
                margin-left: 8px;
                animation: pulse 2s infinite;
                color: #fcd34d;
            }

        @@keyframes pulse {
            0%, 100%

        {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(1.2);
            opacity: 0.7;
        }

        }

        /* ===== البطاقات الزجاجية العصرية ===== */
        .glass-card {
            background: rgba(255, 255, 255, 0.06);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 28px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.3);
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

            .glass-card:hover {
                border-color: rgba(167, 139, 250, 0.2);
                box-shadow: 0 30px 80px rgba(139, 92, 246, 0.08);
            }

        /* ===== وضع القراءة فقط ===== */
        .read-only-container {
            position: relative;
            overflow: hidden;
            padding: 2rem;
            height: 100%;
        }

        .read-only-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(1px);
            z-index: 2;
            pointer-events: none;
            border-radius: 28px;
        }

        /* ===== عناوين الصفحة ===== */
        .page-title {
            font-size: 1.8rem;
            font-weight: 800;
            color: #f8fafc;
            text-shadow: 0 2px 30px rgba(167, 139, 250, 0.1);
        }

            .page-title i {
                color: #a78bfa;
                filter: drop-shadow(0 0 15px rgba(167, 139, 250, 0.3));
            }

        /* ===== عناصر المعلومات ===== */
        .info-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.9rem 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        }

            .info-item:last-child {
                border-bottom: none;
            }

        .info-label {
            color: #94a3b8;
            font-weight: 500;
            font-size: 0.95rem;
        }

        .info-value {
            color: #f1f5f9;
            font-weight: 700;
            font-size: 0.95rem;
        }

            .info-value.text-primary {
                color: #60a5fa !important;
                text-shadow: 0 0 30px rgba(96, 165, 250, 0.15);
            }

        /* ===== شارة منتهي الصلاحية (نيون أحمر) ===== */
        .badge-expired {
            background: rgba(239, 68, 68, 0.15);
            color: #f87171;
            padding: 0.4rem 1rem;
            border-radius: 50px;
            font-weight: 700;
            font-size: 0.85rem;
            border: 1px solid rgba(239, 68, 68, 0.25);
            box-shadow: 0 0 25px rgba(239, 68, 68, 0.1);
            backdrop-filter: blur(4px);
        }

            .badge-expired i {
                color: #ef4444;
            }

        /* ===== بطاقة الـ CTA ===== */
        .cta-card {
            padding: 2rem;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

            .cta-card .icon-wrapper {
                width: 48px;
                height: 48px;
                background: rgba(167, 139, 250, 0.15);
                border-radius: 16px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #a78bfa;
                font-size: 1.2rem;
                border: 1px solid rgba(167, 139, 250, 0.1);
            }

            .cta-card h3 {
                color: #f8fafc;
                font-weight: 700;
            }

            .cta-card p {
                color: #94a3b8;
                font-size: 0.95rem;
                line-height: 1.8;
            }

        /* ===== أزرار عصرية بتدرج لوني ===== */
        .btn-whatsapp {
            background: linear-gradient(135deg, #25d366, #10b981);
            color: #ffffff;
            font-weight: 700;
            border-radius: 16px;
            padding: 0.9rem 1.5rem;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            border: none;
            box-shadow: 0 8px 30px rgba(37, 211, 102, 0.2);
            text-decoration: none;
        }

            .btn-whatsapp:hover {
                background: linear-gradient(135deg, #20ba5a, #0d9e6e);
                color: #ffffff;
                transform: translateY(-3px);
                box-shadow: 0 15px 40px rgba(37, 211, 102, 0.35);
            }

        .btn-support {
            background: linear-gradient(135deg, #8b5cf6, #6366f1);
            color: #ffffff;
            font-weight: 600;
            border-radius: 16px;
            padding: 0.9rem 1.5rem;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            border: none;
            box-shadow: 0 8px 30px rgba(139, 92, 246, 0.15);
            text-decoration: none;
        }

            .btn-support:hover {
                background: linear-gradient(135deg, #7c3aed, #4f46e5);
                color: #ffffff;
                transform: translateY(-3px);
                box-shadow: 0 15px 40px rgba(139, 92, 246, 0.3);
            }

        /* ===== قسم الأسئلة الشائعة ===== */
        .faq-section {
            padding: 2rem;
            border-radius: 28px;
        }

        .faq-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: #f8fafc;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .faq-title i {
                color: #fbbf24;
                font-size: 1.4rem;
                filter: drop-shadow(0 0 20px rgba(251, 191, 36, 0.2));
            }

        .faq-item {
            margin-bottom: 1.2rem;
            padding: 1rem 1.2rem;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 16px;
            border: 1px solid rgba(255, 255, 255, 0.04);
            transition: all 0.3s ease;
        }

            .faq-item:hover {
                background: rgba(255, 255, 255, 0.06);
                border-color: rgba(167, 139, 250, 0.1);
            }

            .faq-item:last-child {
                margin-bottom: 0;
            }

        .faq-question {
            font-weight: 700;
            color: #e2e8f0;
            font-size: 0.95rem;
            margin-bottom: 0.3rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .faq-question::before {
                content: '✦';
                color: #a78bfa;
                font-size: 0.7rem;
            }

        .faq-answer {
            color: #94a3b8;
            font-size: 0.9rem;
            line-height: 1.7;
            padding-right: 1.5rem;
        }

        /* ===== رابط في حالة القراءة فقط ===== */
        .info-value a {
            color: #94a3b8 !important;
            text-decoration: none;
            pointer-events: none;
            opacity: 0.6;
        }

        /* ===== تنسيق للأجهزة الصغيرة ===== */
        @@media (max-width: 576px) {
            .page-title

        {
            font-size: 1.3rem;
        }

        .read-only-container {
            padding: 1.2rem;
        }

        .cta-card {
            padding: 1.5rem;
        }

        .faq-section {
            padding: 1.2rem;
        }

        .info-item {
            flex-direction: column;
            align-items: flex-start;
            gap: 4px;
        }

        }

        @@media (max-width: 768px) {
            .badge-expired

        {
            font-size: 0.7rem;
            padding: 0.3rem 0.8rem;
        }

        }

        /* ===== دخول الصفحة ===== */
        .container {
            opacity: 0;
            transform: translateY(20px);
            animation: fadeUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @@keyframes fadeUp {
            to

        {
            opacity: 1;
            transform: translateY(0);
        }

        }
        /* هذا الجزء يقوم بتوسيط الرابط بالكامل في منتصف الشاشة */
        .logout-container {
            display: flex;
            justify-content: center; /* التوسيط الأفقي */
            align-items: center; /* التوسيط العمودي */
            text-decoration: none; /* إلغاء الخط السفلي الموروث */
            width: 100%; /* يضمن أن الحاوية تأخذ عرض الشاشة بالكامل للتوسيط */
            margin: 20px 0; /* مسافة إضافية من الأعلى والأسفل */
        }

        /* تنسيق الزر الداخلي وجعله جذاباً ومنظماً */
        .logout-btn {
            border: 3px Gold solid;
            color: white;
            font-size: 1.3rem;
            padding: 10px 25px; /* مساحات داخلية متناسقة للزر بدل تحديد عرض ثابت */
            display: flex;
            align-items: center;
            gap: 10px; /* مسافة مناسبة بين الأيقونة والنص */
            border-radius: 8px; /* حواف دائرية خفيفة لجمالية التصميم */
            background-color: #333; /* خلفية داكنة اختيارية ليظهر النص الأبيض والذهبي بوضوح */
            transition: all 0.3s ease; /* تأثير ناعم عند مرور الماوس */
            cursor: pointer;
        }

            /* تأثير عند تمرير الماوس فوق الزر (Hover Effect) */
            .logout-btn:hover {
                background-color: Gold;
                color: black;
            }
    </style>
</head>
<body>

    <div class="sticky-alert-banner">
        <i class="bi bi-exclamation-triangle-fill"></i>
        تنبيه: انتهت فترة صلاحية اشتراك موقعك. يرجى تجديد الاشتراك لضمان استمرار الخدمة وعدم فقدان البيانات.
    </div>

    <div class="container mt-5 yq-container-max">

        <div class="row g-4">

            <!-- العمود الأيمن: معلومات الخطة السابقة -->
            <div class="col-lg-7">
                <div class="glass-card read-only-container h-100">
                    <div class="read-only-overlay"></div>

                    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
                        <h2 class="page-title m-0 d-flex align-items-center gap-2">
                            <i class="bi bi-boxes"></i> معلومات خطتك السابقة
                        </h2>
                        <span class="badge-expired"><i class="bi bi-x-circle-fill me-1"></i> منتهي الصلاحية</span>
                    </div>

                    <div class="info-list">
                        <div class="info-item">
                            <span class="info-label">اسم الموقع</span>
                            <span class="info-value">@Model.SiteName</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">رابط الموقع</span>
                            <span class="info-value">
                                @if (Model.ClickableSiteUrl is not null)
                                {
                                    <a href="@Model.ClickableSiteUrl.AbsoluteUri">@Model.SiteUrlText <i class="bi bi-link-45deg ms-1 small"></i></a>
                                }
                                else
                                {
                                    @Model.SiteUrlText
                                }
                            </span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">تاريخ بدء الاشتراك</span>
                            <span class="info-value">@Model.StartDate</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">تاريخ انتهاء الاشتراك</span>
                            <span class="info-value">@Model.EndDate</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">إجمالي مدة الاشتراك السابق</span>
                            <span class="info-value text-primary">@Model.OriginalDurationDays</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- العمود الأيسر: بطاقة إعادة التفعيل -->
            <div class="col-lg-5">
                <div class="glass-card cta-card">
                    <div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="icon-wrapper">
                                <i class="bi bi-headset"></i>
                            </div>
                            <h3 class="h5 m-0 fw-bold">إعادة تفعيل الخدمة</h3>
                        </div>
                        <p class="mb-4">
                            نحن هنا لمساعدتك في إعادة تشغيل موقعك فوراً. تواصل مع الدعم الفني لتجديد اشتراكك واختيار الخطة المناسبة لك بكل سهولة.
                        </p>
                    </div>

                    <div class="d-grid gap-3">
                        <a href="https://wa.me/775458250?text=أهلاً،%20أريد%20تجديد%20اشتراك%20موقعي%20ٍ@Uri.EscapeDataString(Model.SiteName)" target="_blank" rel="noopener noreferrer" class="btn-whatsapp d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-whatsapp fs-5"></i> تواصل معنا عبر الواتساب
                        </a>

                    </div>
                </div>
            </div>

            <!-- الأسئلة الشائعة -->
            <div class="col-12 mt-4">
                <div class="glass-card faq-section">
                    <h4 class="faq-title">
                        <i class="bi bi-question-circle-fill"></i> الأسئلة الشائعة وطمأنة العملاء
                    </h4>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="faq-item">
                                <div class="faq-question">هل سأفقد بيانات موقعي أو متجري؟</div>
                                <div class="faq-answer">لا تقلق أبداً، بياناتك وملفاتك بالكامل محفوظة ومحمية بشكل آمن في سيرفراتنا لفترة احتياطية مدتها 30 يوماً لتمنحك الوقت الكافي لإتمام عملية التجديد.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="faq-item">
                                <div class="faq-question">كم تستغرق عملية إعادة التفعيل؟</div>
                                <div class="faq-answer">بمجرد تواصلك معنا وتأكيد عملية التحويل أو السداد، يقوم فريق العمل بإعادة تفعيل موقعك وربطه بالدومين الخاص بك ليعمل فوراً وخلال دقائق معدودة.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <center>
                <div class="d-inline-flex flex-wrap justify-content-center gap-3 my-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    if (User.IsInRole("Admin") || User.IsInRole("Developer"))
                    {
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="logout-btn text-decoration-none">
                            <i class="bi bi-speedometer2"></i>
                            <span>لوحة التحكم</span>
                        </a>
                    }
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" asp-antiforgery="true" class="d-inline m-0 p-0">
                        <button type="submit" class="logout-btn">
                            <i class="fa-solid fa-arrow-right-from-bracket"></i>
                            <span>تسجيل الخروج</span>
                        </button>
                    </form>
                }
                else
                {
                    <a asp-area="" asp-controller="Account" asp-action="Auth" class="logout-btn text-decoration-none">
                        <i class="bi bi-box-arrow-in-left"></i>
                        <span>تسجيل الدخول</span>
                    </a>
                    <button type="button" class="logout-btn" onclick="if(history.length > 1) { history.back(); } else { window.location.href='/'; }">
                        <i class="bi bi-arrow-right"></i>
                        <span>الرجوع</span>
                    </button>
                }
                </div>
            </center>
        </div>
    </div>

</body>
</html>
