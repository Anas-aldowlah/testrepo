@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>الخدمة غير متاحة مؤقتاً</title>
    <style nonce="@Context.Items["csp-nonce"]">
        * { box-sizing: border-box; }
        body {
            min-height: 100vh;
            margin: 0;
            display: grid;
            place-items: center;
            padding: 1.5rem;
            color: #f8fafc;
            background: #0f172a;
            font-family: "Segoe UI", Tahoma, sans-serif;
        }
        main {
            width: min(100%, 36rem);
            padding: 2.5rem 2rem;
            text-align: center;
            border: 1px solid #334155;
            border-radius: 1.5rem;
            background: #1e293b;
        }
        h1 { margin-top: 0; font-size: clamp(1.7rem, 5vw, 2.5rem); }
        p { margin-bottom: 0; color: #cbd5e1; line-height: 1.9; }
    </style>
</head>
<body>
    <main>
        <h1>الخدمة غير متاحة مؤقتاً</h1>
        <p>تعذر التحقق من حالة الموقع حالياً. يرجى المحاولة مرة أخرى لاحقاً.</p>
    </main>
</body>
</html>
