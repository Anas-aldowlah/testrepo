@model bool
@inject YAGOT_2._0.Core.Capabilities.ICapabilityEvaluator CapabilityEvaluator
@{
    var returnUrl = ViewData["CheckoutAuthReturnUrl"] as string ?? $"{Context.Request.Path}{Context.Request.QueryString}";
    var loginEnabled = CapabilityEvaluator.IsFeatureEnabled(YAGOT_2._0.Core.Capabilities.CapabilityFeatureCodes.CustomerLogin)
        || CapabilityEvaluator.IsFeatureEnabled(YAGOT_2._0.Core.Capabilities.CapabilityFeatureCodes.CustomerGoogleLogin);
    var registrationEnabled = CapabilityEvaluator.IsFeatureEnabled(YAGOT_2._0.Core.Capabilities.CapabilityFeatureCodes.CustomerAccountCreate)
        && CapabilityEvaluator.IsFeatureEnabled(YAGOT_2._0.Core.Capabilities.CapabilityFeatureCodes.CustomerGoogleLogin);
}

<div class="modal fade yq-checkout-auth-modal"
     id="yqCheckoutAuthModal"
     tabindex="-1"
     aria-labelledby="yqCheckoutAuthModalTitle"
     aria-hidden="true"
     data-yq-show-on-load="@(Model.ToString().ToLowerInvariant())">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content yq-checkout-auth-modal__content">
            <div class="modal-header yq-checkout-auth-modal__header">
                <div>
                    <span class="yq-checkout-auth-modal__eyebrow">
                        <i class="bi bi-shield-lock"></i> خطوة أخيرة
                    </span>
                    <h2 class="modal-title yq-checkout-auth-modal__title" id="yqCheckoutAuthModalTitle">
                        سجّل دخولك لإتمام الطلب
                    </h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body yq-checkout-auth-modal__body">
                <p>
                    حتى نحفظ طلبك باسمك وتقدر تتابع حالته لاحقاً، سجّل دخولك أو أنشئ حساباً جديداً. سلتك محفوظة، وبعدها تكمل الطلب مباشرة.
                </p>
            </div>
            <div class="modal-footer yq-checkout-auth-modal__actions">
                @if (loginEnabled)
                {
                <a asp-controller="Account"
                   asp-action="Auth"
                   asp-route-returnUrl="@returnUrl"
                   class="btn-yaqut-gold yq-checkout-auth-modal__action">
                    <i class="bi bi-box-arrow-in-left"></i> تسجيل الدخول
                </a>
                }
                @if (registrationEnabled)
                {
                <a asp-controller="Account"
                   asp-action="Auth"
                   asp-route-register="true"
                   asp-route-returnUrl="@returnUrl"
                   class="btn-yaqut-outline yq-checkout-auth-modal__action">
                    <i class="bi bi-person-plus"></i> إنشاء حساب جديد
                </a>
                }
            </div>
        </div>
    </div>
</div>
