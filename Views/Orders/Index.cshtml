@model YAGOT_2._0.Models.CustomerOrdersIndexViewModel
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = "طلباتي | ياقوت";
    var orders = Model.Orders;

    string StatusLabel(string status) => status switch
    {
        "Pending" => "قيد الانتظار",
        "Paid" => "تم الدفع",
        "Processed" => "قيد التجهيز",
        "Shipped" => "تم الشحن",
        "Delivered" => "تم التوصيل",
        "Refunded" => "مرتجع",
        _ => "ملغي"
    };

    string StatusBadgeClass(string status) => status.ToLower() switch
    {
        "pending" => "yq-orders-badge--pending",
        "paid" => "yq-orders-badge--processed",
        "processed" => "yq-orders-badge--processed",
        "shipped" => "yq-orders-badge--shipped",
        "delivered" => "yq-orders-badge--delivered",
        _ => "yq-orders-badge--cancelled"
    };


    var statusFilters = new (string Key, string Label)[]
    {
        ("all", "الكل"),
        ("Pending", "قيد الانتظار"),
        ("Paid", "تم الدفع"),
        ("Processed", "قيد التجهيز"),
        ("Shipped", "تم الشحن"),
        ("Delivered", "تم التوصيل"),
        ("Cancelled", "ملغي")
    };

    var currentStatus = statusFilters.FirstOrDefault(f => f.Key == Model.Status);
    var currentStatusLabel = !string.IsNullOrEmpty(currentStatus.Label) ? currentStatus.Label : "الكل";
    var currentStatusCount = Model.Status == "all" ? Model.AllCount : Model.StatusCounts.GetValueOrDefault(Model.Status);

    string OrdersUrl(string status, int page = 1, string? search = null) =>
        Url.Action("Index", "Orders", new { status, search = search ?? Model.Search, page, pageSize = Model.PageSize }) ?? "/Orders";
}

@section Styles {
    <link rel="stylesheet" href="~/css/orders/index.css" asp-append-version="true" />
}

<div class="yq-orders-page" data-yq-orders-root data-yq-orders-url="@Url.Action("Index", "Orders")"
     data-yq-review-count="@Model.ReviewRequiredCount"
     data-yq-review-url="@(Model.FirstReviewRequiredOrderId.HasValue ? Url.Action("Details", "Orders", new { id = Model.FirstReviewRequiredOrderId.Value }) : "")">

    <!-- HEADER -->
    @{
        Func<dynamic, IHtmlContent> ordersAction = @<a asp-controller="Products" asp-action="Index" class="btn-yaqut-outline"><i class="bi bi-bag-plus" aria-hidden="true"></i> تسوق الآن</a>;
        
        var ordersHeaderVM = new YAGOT_2._0.Models.PageHeaderViewModel {
            Variant = "Utility",
            Title = "طلباتي",
            Eyebrow = "سجل المشتريات",
            EyebrowIcon = "bi-bag-check",
            Subtitle = Model.AllCount > 0 ? $"لديك <strong>{Model.AllCount}</strong> {(Model.AllCount == 1 ? "طلب" : "طلبات")} مسجلة في حسابك" : null,
            Actions = ordersAction(null)
        };
    }
    <partial name="_PageHeader" model="ordersHeaderVM" />

    @if (Model.ReviewRequiredCount > 0)
    {
        <section class="yq-orders-conflict-banner yq-glass yq-reveal" role="alert" aria-live="polite">
            <div class="yq-orders-conflict-banner__content">
                <span class="yq-orders-conflict-banner__icon" aria-hidden="true">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </span>
                <div class="yq-orders-conflict-banner__text">
                    <strong class="yq-orders-conflict-banner__title">طلبات تحتاج قرارك</strong>
                    @if (Model.ReviewRequiredCount == 1)
                    {
                        <p class="yq-orders-conflict-banner__desc">لديك طلب يحتاج إلى مراجعتك بسبب تغير توفر بعض المنتجات.</p>
                    }
                    else
                    {
                        <p class="yq-orders-conflict-banner__desc">لديك @Model.ReviewRequiredCount طلبات تحتاج إلى مراجعتك بسبب تغير توفر بعض المنتجات.</p>
                    }
                </div>
            </div>
            @if (Model.ReviewRequiredCount == 1 && Model.FirstReviewRequiredOrderId.HasValue)
            {
                <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.FirstReviewRequiredOrderId.Value"
                   class="btn-yaqut-warning yq-orders-conflict-banner__cta">
                    <i class="bi bi-arrow-left-circle" aria-hidden="true"></i> مراجعة الطلب
                </a>
            }
            else
            {
                <span class="yq-orders-conflict-banner__hint">
                    يرجى مراجعة كل طلب مميز أدناه لاتخاذ قرارك.
                </span>
            }
        </section>
    }

    @if (Model.AllCount == 0)
    {
        <!-- EMPTY STATE -->
        <div class="yaqut-empty yq-glass yq-orders-empty yq-reveal">
            <i class="bi bi-inbox yaqut-empty__icon"></i>
            <h2 class="yq-orders-empty__title">لا يوجد لديك طلبات سابقة</h2>
            <p class="yaqut-empty__text">ابدأ رحلتك مع ياقوت واكتشف منتجاتنا الفاخرة من العطور الأصيلة.</p>
            <a asp-controller="Products" asp-action="Index" class="btn-yaqut-gold mt-3">
                <i class="bi bi-stars"></i> تصفح المنتجات
            </a>
        </div>
    }
    else
    {
        <!-- TOOLBAR: STATUS DROPDOWN + SEARCH -->
        <div class="yq-orders-toolbar yq-reveal">
            <div class="dropdown yq-orders-filter-dropdown">
                <button class="btn yq-orders-filter-btn dropdown-toggle" type="button"
                        id="yqOrdersFilterDropdown"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        aria-label="تصفية الطلبات حسب الحالة. الحالة الحالية: @currentStatusLabel">
                    <span class="yq-orders-filter-btn__content">
                        <span class="yq-orders-filter-btn__label">الحالة:</span>
                        <strong class="yq-orders-filter-btn__current">@currentStatusLabel</strong>
                        @if (currentStatusCount > 0)
                        {
                            <span class="yq-orders-filter__count">@currentStatusCount</span>
                        }
                    </span>
                    <i class="bi bi-chevron-down yq-orders-filter-btn__chevron" aria-hidden="true"></i>
                </button>
                <ul class="dropdown-menu yq-orders-filter-menu" aria-labelledby="yqOrdersFilterDropdown">
                    @foreach (var (key, label) in statusFilters)
                    {
                        var count = key == "all" ? Model.AllCount : Model.StatusCounts.GetValueOrDefault(key);
                        var isSelected = key == Model.Status;
                        <li>
                            <a href="@OrdersUrl(key)"
                               class="dropdown-item yq-orders-filter-menu__item @(isSelected ? "is-selected active" : "")"
                               data-yq-order-filter="@key"
                               aria-current="@(isSelected ? "true" : null)">
                                <span class="yq-orders-filter-menu__item-label">@label</span>
                                @if (count > 0)
                                {
                                    <span class="yq-orders-filter__count">@count</span>
                                }
                                @if (isSelected)
                                {
                                    <i class="bi bi-check2 yq-orders-filter-menu__check" aria-hidden="true"></i>
                                }
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <form class="yq-orders-search" method="get" action="@Url.Action("Index", "Orders")" data-yq-orders-search>
                <button type="submit" class="yq-orders-search__submit" aria-label="تطبيق البحث"><i class="bi bi-search" aria-hidden="true"></i></button>
                <input type="hidden" name="status" value="@Model.Status" />
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                <input type="search" id="yqOrdersSearchInput" class="yq-orders-search__input"
                       name="search" value="@Model.Search"
                       placeholder="ابحث في طلباتك..." autocomplete="off"
                       aria-label="البحث برقم الطلب أو رقم التتبع أو اسم المنتج" />
            </form>
        </div>

        <!-- ORDERS GRID -->
        @if (orders.Count > 0)
        {
            <div class="yq-orders-grid" id="yqOrdersGrid">
                @foreach (var order in orders)
            {
                var items = order.Orderitems?.ToList() ?? new List<YAGOT_2._0.Models.Orderitem>();
                var itemCount = items.Sum(i => i.Quantity);
                var isCancelled = order.Status is "Cancelled" or "Refunded";
                var isConflict = order.Workflowstate == YAGOT_2._0.Services.OrderWorkflowStates.ConflictAwaitingDecision;
                var thumbs = items.Take(4).ToList();
                var extraCount = items.Count - thumbs.Count;
                var firstItem = items.FirstOrDefault();
                var hasFulfilledAdjustment = !isCancelled && order.Finalfulfilledamount.HasValue && order.Finalfulfilledamount.Value != order.Totalamount;

                <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id"
                   class="yq-order-card yq-glass yq-reveal @(isConflict ? "yq-order-card--attention" : "")"
                   data-yq-order-card
                   aria-label="طلب رقم @order.Id - @StatusLabel(order.Status)">

                    <div class="yq-order-card__header">
                        <h3 class="yq-order-card__id"><bdi>طلب #@order.Id</bdi></h3>
                        <div class="yq-order-card__badges">
                            <span class="yq-orders-badge @StatusBadgeClass(order.Status)">
                                @StatusLabel(order.Status)
                            </span>
                            @if (isConflict)
                            {
                                <span class="yq-order-card__conflict-tag">
                                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> بانتظار قرارك
                                </span>
                            }
                        </div>
                    </div>

                    @if (isConflict)
                    {
                        <div class="yq-order-card__conflict-alert" role="note">
                            <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
                            <span>بعض المنتجات تحتاج مراجعتك بسبب تغير الكمية المتوفرة.</span>
                        </div>
                    }

                    <div class="yq-order-card__preview">
                        <div class="yq-order-card__thumbs">
                            @if (thumbs.Any())
                            {
                                @foreach (var item in thumbs)
                                {
                                    <span class="yq-order-card__thumb">
                                        <img src="@(item.Product?.Imageurl ?? "/images/placeholder-product.svg")"
                                             alt="@(item.Product?.Name ?? "منتج")"
                                             data-yaqut-fallback="/images/placeholder-product.svg"
                                             loading="lazy" />
                                    </span>
                                }
                                @if (extraCount > 0)
                                {
                                    <span class="yq-order-card__thumb yq-order-card__thumb--more">+@extraCount</span>
                                }
                            }
                            else
                            {
                                <span class="yq-order-card__thumb yq-order-card__thumb--empty">
                                    <i class="bi bi-bag" aria-hidden="true"></i>
                                </span>
                            }
                        </div>
                        <div class="yq-order-card__preview-text">
                            <strong class="yq-order-card__product-name">@(firstItem?.Product?.Name ?? "منتجات ياقوت")</strong>
                            @if (items.Count > 1)
                            {
                                <span class="yq-order-card__items-extra">+@(items.Count - 1) @(items.Count - 1 == 1 ? "منتج آخر" : "منتجات أخرى")</span>
                            }
                        </div>
                    </div>

                    <div class="yq-order-card__body">
                        <div class="yq-order-card__row">
                            <span class="yq-order-card__label">التاريخ</span>
                            <span class="yq-order-card__value"><bdi>@(order.Orderdate.HasValue? order.Orderdate.Value.ToString("dd/MM/yyyy") : "-")</bdi></span>
                        </div>
                        <div class="yq-order-card__row">
                            <span class="yq-order-card__label">عدد القطع</span>
                            <span class="yq-order-card__value">@itemCount @(itemCount == 1 ? "قطعة" : "قطع")</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(order.Trackingnumber))
                        {
                            <div class="yq-order-card__row">
                                <span class="yq-order-card__label">رقم التتبع</span>
                                <span class="yq-order-card__tracking"><bdi>@order.Trackingnumber</bdi></span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(order.AdminNote))
                        {
                            <div class="yq-order-card__row yq-order-card__row--admin-note">
                                <span class="yq-order-card__label">ملاحظة الإدارة</span>
                                <span class="yq-order-card__admin-note">@order.AdminNote</span>
                            </div>
                        }
                    </div>

                    <div class="yq-order-card__footer">
                        <div class="yq-order-card__total-block">
                            <span class="yq-order-card__label">الإجمالي</span>
                            <strong class="yq-order-card__total"><bdi>@(order.Totalamount.ToYaqutPrice(order.Currencycode))</bdi></strong>
                            @if (hasFulfilledAdjustment)
                            {
                                <span class="yq-order-card__fulfilled-note">المعتمد للتنفيذ: <bdi>@(order.Finalfulfilledamount.ToYaqutPrice(order.Currencycode))</bdi></span>
                            }
                        </div>
                        @if (isConflict)
                        {
                            <span class="yq-order-card__cta yq-order-card__cta--conflict">
                                مراجعة الطلب <i class="bi bi-arrow-left" aria-hidden="true"></i>
                            </span>
                        }
                        else
                        {
                            <span class="yq-order-card__cta yq-order-card__cta--normal">
                                عرض التفاصيل <i class="bi bi-arrow-left" aria-hidden="true"></i>
                            </span>
                        }
                    </div>
                </a>
            }
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="yq-orders-pager" aria-label="صفحات الطلبات" data-yq-orders-pager>
                    <a class="yq-orders-pager__link" href="@OrdersUrl(Model.Status, Math.Max(1, Model.CurrentPage - 1))"
                       aria-label="الصفحة السابقة" aria-disabled="@(!Model.HasPreviousPage ? "true" : "false")" tabindex="@(!Model.HasPreviousPage ? "-1" : null)">
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </a>
                    @for (var pageNumber = Math.Max(1, Model.CurrentPage - 2); pageNumber <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); pageNumber++)
                    {
                        <a class="yq-orders-pager__link @(pageNumber == Model.CurrentPage ? "is-active" : null)"
                           href="@OrdersUrl(Model.Status, pageNumber)" aria-current="@(pageNumber == Model.CurrentPage ? "page" : null)">@pageNumber</a>
                    }
                    <a class="yq-orders-pager__link" href="@OrdersUrl(Model.Status, Math.Min(Model.TotalPages, Model.CurrentPage + 1))"
                       aria-label="الصفحة التالية" aria-disabled="@(!Model.HasNextPage ? "true" : "false")" tabindex="@(!Model.HasNextPage ? "-1" : null)">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i>
                    </a>
                </nav>
            }
        }

        @if (orders.Count == 0)
        {
            <div class="yaqut-empty yq-glass yq-orders-no-results" id="yqOrdersNoResults">
                <i class="bi bi-search yaqut-empty__icon"></i>
                <h2 class="yq-orders-empty__title">لا توجد طلبات مطابقة</h2>
                <p class="yaqut-empty__text">جرّب تعديل كلمة البحث أو اختيار حالة مختلفة.</p>
                <a class="btn-yaqut-outline mt-3" href="@OrdersUrl("all", 1, string.Empty)" data-yq-orders-reset>
                    <i class="bi bi-x-circle"></i> إعادة تعيين الفلاتر
                </a>
            </div>
        }
    }
</div>

<partial name="_YaqutOperationDialog" />

@section Scripts {
    <script src="~/js/orders/index.js" asp-append-version="true"></script>
}
