@model IEnumerable<YAGOT_2._0.Models.Order>
@{
    ViewData["Title"] = "طلباتي";
}

<div class="yaqut-page-header">
    <h1><i class="bi bi-box-seam"></i> طلباتي</h1>
</div>

@if (Model.Any())
{
    @foreach (var order in Model)
    {
        string stateAr = order.Status switch
        {
            "Pending" => "قيد الانتظار",
            "Processed" => "قيد المعالجة",
            "Shipped" => "تم الشحن",
            "Delivered" => "تم التوصيل",
            _ => "ملغي"
        };
        var badgeClass = order.Status.ToLower() switch
        {
            "pending" => "yaqut-badge--pending",
            "processed" => "yaqut-badge--processed",
            "shipped" => "yaqut-badge--shipped",
            "delivered" => "yaqut-badge--delivered",
            _ => "yaqut-badge--cancelled"
        };

        <article class="yaqut-order-card glass-effect">
            <div class="yaqut-order-card__header">
                <div>
                    <span class="text-muted">رقم التتبع: </span>
                    <span class="yaqut-order-card__tracking">@order.Trackingnumber</span>
                </div>
                <span class="yaqut-badge @badgeClass">@stateAr</span>
            </div>

            @foreach (var item in order.Orderitems)
            {
                <div class="yaqut-order-item">
                    <span>@item.Product?.Name × @item.Quantity</span>
                    <span>@((item.Quantity * item.Unitprice).ToString("N0")) ر.س</span>
                </div>
            }

            <div class="yaqut-order-card__footer">
                <span>الإجمالي</span>
                <span class="yaqut-order-card__tracking">@order.Totalamount.ToString("N0") ر.س</span>
            </div>
            <div class="yaqut-order-card__date">@(order.Orderdate.HasValue ? order.Orderdate.Value.ToString("dd/MM/yyyy HH:mm") : "-")</div>
        </article>
    }
}
else
{
    <div class="yaqut-empty glass-effect">
        <i class="bi bi-inbox yaqut-empty__icon"></i>
        <p class="yaqut-empty__text">لا يوجد لديك طلبات سابقة.</p>
        <a asp-controller="Products" asp-action="Index" class="btn-yaqut-gold mt-3">تصفح العطور</a>
    </div>
}
