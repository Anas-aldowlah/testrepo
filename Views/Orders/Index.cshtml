@model IEnumerable<YAGOT_2._0.Models.Order>
@{
    ViewData["Title"] = "طلباتي | ياقوت";
    var orders = Model?.ToList() ?? new List<YAGOT_2._0.Models.Order>();
    var hasError = Model == null;

    string StatusLabel(string status) => status switch
    {
        "Pending" => "قيد الانتظار",
        "Processed" => "تم الدفع",
        "Shipped" => "تم الشحن",
        "Delivered" => "تم التوصيل",
        "Refunded" => "مرتجع",
        _ => "ملغي"
    };

    string StatusBadgeClass(string status) => status.ToLower() switch
    {
        "pending" => "yq-orders-badge--pending",
        "processed" => "yq-orders-badge--processed",
        "shipped" => "yq-orders-badge--shipped",
        "delivered" => "yq-orders-badge--delivered",
        _ => "yq-orders-badge--cancelled"
    };

    int StatusProgress(string status) => status switch
    {
        "Pending" => 25,
        "Processed" => 50,
        "Shipped" => 75,
        "Delivered" => 100,
        _ => 0
    };

    var statusFilters = new (string Key, string Label)[]
    {
        ("all", "الكل"),
        ("Pending", "قيد الانتظار"),
        ("Processed", "تم الدفع"),
        ("Shipped", "تم الشحن"),
        ("Delivered", "تم التوصيل"),
        ("Cancelled", "ملغي")
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/orders/index.css" asp-append-version="true" />
}

<div class="yq-orders-page" data-yq-orders-root>

    <!-- HEADER -->
    <header class="yq-orders-header yq-reveal">
        <div>
            <span class="yq-orders-header__eyebrow"><i class="bi bi-bag-check"></i> سجل المشتريات</span>
            <h1 class="yq-orders-header__title">طلباتي</h1>
            @if (!hasError && orders.Any())
            {
                <p class="yq-orders-header__sub">لديك <strong>@orders.Count</strong> @(orders.Count == 1 ? "طلب" : "طلبات") مسجلة في حسابك</p>
            }
        </div>
        <a asp-controller="Products" asp-action="Index" class="btn-yaqut-outline yq-orders-header__cta">
            <i class="bi bi-bag-plus"></i> تسوق الآن
        </a>
    </header>

    @if (hasError)
    {
        <!-- ERROR STATE -->
        <div class="yaqut-empty yq-glass yq-orders-error yq-reveal">
            <i class="bi bi-exclamation-triangle yaqut-empty__icon"></i>
            <h2 class="yq-orders-empty__title">تعذّر تحميل طلباتك</h2>
            <p class="yaqut-empty__text">حدث خطأ أثناء جلب بيانات طلباتك. حاول تحديث الصفحة، أو تواصل معنا إن استمرت المشكلة.</p>
            <button type="button" class="btn-yaqut-gold mt-3" id="yq-btn-reload">
                <i class="bi bi-arrow-clockwise"></i> إعادة المحاولة
            </button>
        </div>
    }
    else if (!orders.Any())
    {
        <!-- EMPTY STATE -->
        <div class="yaqut-empty yq-glass yq-orders-empty yq-reveal">
            <i class="bi bi-inbox yaqut-empty__icon"></i>
            <h2 class="yq-orders-empty__title">لا يوجد لديك طلبات سابقة</h2>
            <p class="yaqut-empty__text">ابدأ رحلتك مع ياقوت واكتشف منتجاتنا الفاخرة من العطور الأصيلة.</p>
            <a asp-controller="Products" asp-action="Index" class="btn-yaqut-gold mt-3">
                <i class="bi bi-stars"></i> تصفح المنتجات
            </a>
        </div>
    }
    else
    {
        <!-- TOOLBAR: FILTERS + SEARCH -->
        <div class="yq-orders-toolbar yq-reveal">
            <div class="yq-orders-filters" role="tablist" aria-label="تصفية حسب الحالة">
                @foreach (var (key, label) in statusFilters)
                {
                    var count = key == "all" ? orders.Count : orders.Count(o => o.Status == key);
                    <button type="button"
                            class="yq-orders-filter @(key == "all" ? "is-active" : "")"
                            data-yq-order-filter="@key"
                            role="tab"
                            aria-selected="@(key == "all" ? "true" : "false")">
                        @label
                        @if (count > 0)
                        {
                            <span class="yq-orders-filter__count">@count</span>
                        }
                    </button>
                }
            </div>

            <div class="yq-orders-search">
                <i class="bi bi-search"></i>
                <input type="search" id="yqOrdersSearchInput" class="yq-orders-search__input"
                       placeholder="ابحث برقم التتبع أو اسم المنتج..." autocomplete="off"
                       aria-label="بحث في الطلبات" />
            </div>
        </div>

        <!-- ORDERS GRID -->
        <div class="yq-orders-grid" id="yqOrdersGrid">
            @foreach (var order in orders)
            {
                var items = order.Orderitems?.ToList() ?? new List<YAGOT_2._0.Models.Orderitem>();
                var itemCount = items.Sum(i => i.Quantity);
                var isCancelled = order.Status is "Cancelled" or "Refunded";
                var searchBlob = ($"{order.Trackingnumber} " + string.Join(" ", items.Select(i => i.Product?.Name))).ToLower();
                var thumbs = items.Take(4).ToList();
                var extraCount = items.Count - thumbs.Count;

                <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id"
                   class="yq-order-card yq-glass yq-reveal"
                   data-yq-order-card
                   data-status="@order.Status"
                   data-search="@searchBlob">

                    <div class="yq-order-card__top">
                        <div class="yq-order-card__thumbs">
                            @if (thumbs.Any())
                            {
                                @foreach (var item in thumbs)
                                {
                                    <span class="yq-order-card__thumb">
                                        <img src="@(item.Product?.Imageurl ?? "/images/placeholder-product.svg")"
                                             alt="@item.Product?.Name"
                                             data-yaqut-fallback="/images/placeholder-product.svg"
                                             loading="lazy" />
                                    </span>
                                }
                                @if (extraCount > 0)
                                {
                                    <span class="yq-order-card__thumb yq-order-card__thumb--more">+@extraCount</span>
                                }
                            }
                            else
                            {
                                <span class="yq-order-card__thumb yq-order-card__thumb--empty">
                                    <i class="bi bi-bag"></i>
                                </span>
                            }
                        </div>

                        <span class="yq-orders-badge @StatusBadgeClass(order.Status)">
                            @StatusLabel(order.Status)
                        </span>
                    </div>

                    <div class="yq-order-card__body">
                        <div class="yq-order-card__row">
                            <span class="yq-order-card__label">رقم التتبع</span>
                            <span class="yq-order-card__tracking">@order.Trackingnumber</span>
                        </div>
                        <div class="yq-order-card__row">
                            <span class="yq-order-card__label">التاريخ</span>
                            <span>@(order.Orderdate.HasValue? order.Orderdate.Value.ToString("dd/MM/yyyy") : "-")</span>
                        </div>
                        <div class="yq-order-card__row">
                            <span class="yq-order-card__label">عدد القطع</span>
                            <span>@itemCount @(itemCount == 1 ? "قطعة" : "قطع")</span>
                        </div>
                    </div>

                    @if (!isCancelled)
                    {
                        <div class="yq-order-card__progress" aria-hidden="true">
                            <style nonce="@Context.Items["csp-nonce"]">.yq-progress-@order.Id { width: @(StatusProgress(order.Status))%; }</style>
                            <div class="yq-order-card__progress-bar yq-progress-@order.Id"></div>
                        </div>
                    }

                    <div class="yq-order-card__footer">
                        <div>
                            <span class="yq-order-card__label">الإجمالي</span>
                            <strong class="yq-order-card__total">@order.Totalamount.ToString("N0") <small>ر.س</small></strong>
                        </div>
                        <span class="yq-order-card__link">
                            عرض التفاصيل <i class="bi bi-arrow-left"></i>
                        </span>
                    </div>
                </a>
            }
        </div>

        <!-- NO-RESULTS (search/filter combo yields nothing) -->
        <div class="yaqut-empty yq-glass yq-orders-no-results" id="yqOrdersNoResults" hidden>
            <i class="bi bi-search yaqut-empty__icon"></i>
            <h2 class="yq-orders-empty__title">لا توجد طلبات مطابقة</h2>
            <p class="yaqut-empty__text">جرّب تعديل كلمة البحث أو اختيار حالة مختلفة.</p>
            <button type="button" class="btn-yaqut-outline mt-3" id="yqOrdersResetBtn">
                <i class="bi bi-x-circle"></i> إعادة تعيين الفلاتر
            </button>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/orders/index.js" asp-append-version="true"></script>
}

<script nonce="@Context.Items["csp-nonce"]">
    document.getElementById('yq-btn-reload')?.addEventListener('click', function() {
        window.location.reload();
    });
</script>