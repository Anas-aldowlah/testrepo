@using YAGOT_2._0.Models
@model CustomerInventoryConflictViewModel
@{
    var orderId = (int)ViewData["OrderId"]!;
    var conflictHasPaymentReview = (bool)ViewData["ConflictHasPaymentReview"]!;
    var whatsAppUrl = ViewData["CustomerOrderWhatsAppUrl"] as string;
    var conflictLines = Model.Lines
        .Select((line, index) => new { line, index })
        .ToDictionary(entry => entry.line.OrderitemId);
    var canSave = Model.Lines.Count > 0 && Model.Lines.All(line => line.CanContinue || line.CanRemove);
}

<section class="yq-od-card yq-glass yq-conflict-notice" aria-labelledby="inventoryDecisionTitle">
    <div>
        <h2 id="inventoryDecisionTitle" class="yq-od-card__title"><i class="bi bi-exclamation-triangle"></i> طلبك يحتاج إلى تحديث</h2>
        @if (!conflictHasPaymentReview)
        {
            <p role="status">المتجر يراجع الدفع الآن. ستظهر خيارات الكميات بعد اكتمال المراجعة.</p>
        }
        else
        {
            <p>بعض الكميات المطلوبة لم تعد متوفرة. اختر ما يناسبك لإكمال الطلب.</p>
        }
    </div>
    @if (conflictHasPaymentReview)
    {
        <button type="button" class="btn-yaqut-outline" data-yq-conflict-open>
            <span>مراجعة المنتجات</span>
        </button>
    }
</section>

@if (conflictHasPaymentReview)
{
    <dialog class="yq-conflict-dialog"
            data-yq-conflict-dialog
            aria-labelledby="yqConflictDialogTitle"
            aria-describedby="yqConflictDialogDescription">
        <div class="yq-conflict-dialog__panel" dir="rtl">
            <header class="yq-conflict-dialog__header">
                <span class="yq-conflict-dialog__icon" aria-hidden="true"><i class="bi bi-exclamation-triangle"></i></span>
                <div>
                    <h2 id="yqConflictDialogTitle">طلبك يحتاج إلى تحديث</h2>
                    <p id="yqConflictDialogDescription">بعض الكميات المطلوبة لم تعد متوفرة. اختر ما يناسبك لإكمال الطلب.</p>
                </div>
                <button type="button" class="yq-conflict-dialog__close" data-yq-conflict-close aria-label="إغلاق">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </header>

            <form asp-action="ResolveInventoryConflict"
                  method="post"
                  class="yq-conflict-resolution"
                  data-yq-conflict-resolution
                  data-yq-conflict-whatsapp-url="@whatsAppUrl">
                <input type="hidden" name="Id" value="@orderId" />
                <input type="hidden" name="CancelEntireOrder" value="false" data-yq-cancel-entire />

                <div class="yq-conflict-dialog__products">
                    @foreach (var product in Model.Products)
                    {
                        var isConflict = conflictLines.TryGetValue(product.OrderitemId, out var conflictEntry);
                        <article class="yq-conflict-product @(isConflict ? "yq-conflict-product--affected" : "yq-conflict-product--neutral")">
                            <div class="yq-conflict-product__heading">
                                <strong>@product.ProductName</strong>
                                @if (isConflict)
                                {
                                    <span>يحتاج إلى قرار</span>
                                }
                                else
                                {
                                    <span>متوفر</span>
                                }
                            </div>
                            <dl class="yq-conflict-resolution__quantities">
                                <div><dt>الكمية المطلوبة</dt><dd>@product.RequestedQuantity</dd></div>
                                <div><dt>الكمية المتوفرة</dt><dd>@product.AvailableQuantity</dd></div>
                            </dl>

                            @if (isConflict && conflictEntry != null)
                            {
                                var line = conflictEntry.line;
                                var index = conflictEntry.index;
                                <fieldset class="yq-conflict-resolution__line" data-yq-conflict-decision>
                                    <legend class="visually-hidden">قرار المنتج @line.ProductName</legend>
                                    <input type="hidden" name="Decisions[@index].OrderitemId" value="@line.OrderitemId" />
                                    @if (line.CanContinue)
                                    {
                                        <label>
                                            <input type="radio" name="Decisions[@index].Decision" value="@InventoryConflictDecisions.Continue" />
                                            المتابعة بالكمية المتوفرة (@line.AvailableQuantity)
                                        </label>
                                    }
                                    @if (line.CanRemove)
                                    {
                                        <label>
                                            <input type="radio" name="Decisions[@index].Decision" value="@InventoryConflictDecisions.Remove" />
                                            إزالة المنتج
                                        </label>
                                    }
                                </fieldset>
                            }
                        </article>
                    }
                </div>

                <p class="yq-conflict-resolution__feedback" data-yq-conflict-feedback role="status" aria-live="polite" hidden></p>
                <footer class="yq-conflict-resolution__actions">
                    @if (canSave)
                    {
                        <button type="submit" class="yq-conflict-resolution__button yq-conflict-resolution__button--save yq-paired-action yq-paired-action--primary" data-yq-resolution-submit="continue" disabled><span>حفظ القرار</span></button>
                    }
                    <button type="submit" class="yq-conflict-resolution__button yq-conflict-resolution__button--cancel yq-paired-action yq-paired-action--destructive" data-yq-resolution-submit="cancel"><span>إلغاء الطلب بالكامل</span></button>
                </footer>
            </form>
        </div>
    </dialog>
}
