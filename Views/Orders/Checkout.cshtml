@model YAGOT_2._0.Models.CheckoutVM
@using System.Security.Claims;
@using YAGOT_2._0.Services
@using YAGOT_2._0.Services.Promotions
@inject DealingAPI DealingApiService;
@inject YAGOT_2._0.Core.Capabilities.ICapabilityEvaluator CapabilityEvaluator
@{
    ViewData["Title"] = "إتمام الطلب";
    var items = Model?.Cart?.Cartitems?.ToList() ?? new List<YAGOT_2._0.Models.Cartitem>();
    var promoResult = ViewBag.PromotionResult as CartPromotionResult;
    decimal UnitPrice(YAGOT_2._0.Models.Cartitem item) => item.RetailPrice?.Price ?? item.Product?.Price ?? 0;
    string UnitLabel(YAGOT_2._0.Models.Cartitem item) => item.RetailPrice?.SizeMl > 0
        ? $"{item.RetailPrice.SizeMl} ml"
        : (item.Product?.StockUnit == "Ml" && item.Product.VolumeMl is > 0 ? $"{item.Product.VolumeMl.Value} ml" : "");
    decimal subtotal = items.Sum(i => i.Quantity * UnitPrice(i));
    decimal expectedTotal = promoResult != null ? promoResult.FinalTotal : subtotal;
    var itemsCount = items.Sum(i => i.Quantity);
    var itemsCountText = itemsCount switch
    {
        1 => "منتج واحد",
        2 => "منتجان",
        >= 3 and <= 10 => $"{itemsCount} منتجات",
        _ => $"{itemsCount} منتج"
    };
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var orderCreateEnabled = CapabilityEvaluator.IsFeatureEnabled(YAGOT_2._0.Core.Capabilities.CapabilityFeatureCodes.OrderCreate);
    var paymentProofEnabled = CapabilityEvaluator.IsFeatureEnabled(YAGOT_2._0.Core.Capabilities.CapabilityFeatureCodes.OrderPaymentProof);
    var checkoutFormValues = ViewData["CheckoutFormValues"] as Microsoft.AspNetCore.Http.IFormCollection;
    var customerName = User.Identity?.Name;
    var encryptedPhone = User.FindFirst(ClaimTypes.MobilePhone)?.Value;
    string customerPhone = DealingApiService.DecryptPhone(encryptedPhone);
    var customerEmail = User.FindFirst(ClaimTypes.Email)?.Value ?? "";
    string CheckoutValue(string name, string? fallback = null)
    {
        if (checkoutFormValues != null && checkoutFormValues.TryGetValue(name, out var value))
        {
            return value.ToString();
        }

        return fallback ?? string.Empty;
    }
    var selectedPaymentMethod = !string.IsNullOrWhiteSpace(Model?.PaymentMethod)
        ? Model.PaymentMethod
        : CheckoutValue("PaymentMethod", "al-amqi");
    var hasModelErrors = !ViewData.ModelState.IsValid;
    var paymentMethods = Model?.PaymentMethods ?? Array.Empty<YAGOT_2._0.Models.Paymentmethod>();
    YAGOT_2._0.Models.Paymentmethod PaymentInfo(string code, string name)
    {
        return paymentMethods.FirstOrDefault(method => string.Equals(method.Type, code, StringComparison.OrdinalIgnoreCase))
            ?? new YAGOT_2._0.Models.Paymentmethod
            {
                Type = code,
                Name = name,
                Accountholdername = string.Empty,
                Accountnumber = string.Empty,
                Isactive = true
            };
    }
    var checkoutPaymentMethods = paymentMethods.Any()
        ? paymentMethods.Where(method => method.Isactive).ToList()
        : new List<YAGOT_2._0.Models.Paymentmethod> { PaymentInfo("al-amqi", "العمقي") };
    var selectedPaymentExists = checkoutPaymentMethods.Any(method => string.Equals(method.Type, selectedPaymentMethod, StringComparison.OrdinalIgnoreCase));
    if (!selectedPaymentExists)
    {
        selectedPaymentMethod = checkoutPaymentMethods.First().Type;
    }
    var selectedPaymentIndex = checkoutPaymentMethods.FindIndex(method => string.Equals(method.Type, selectedPaymentMethod, StringComparison.OrdinalIgnoreCase));
    var initialPaymentPage = selectedPaymentIndex >= 0 ? selectedPaymentIndex / 4 : 0;
    var initialPaymentStart = initialPaymentPage * 4;
    var initialPaymentEnd = initialPaymentStart + 4;
    var hasPaymentPages = checkoutPaymentMethods.Count > 4;
    string PaymentIcon(string type)
    {
        return type switch
        {
            "al-amqi" => "bi-cash-coin",
            "bin-dawl" => "bi-bank",
            "al-basiri" => "bi-wallet2",
            "other" => "bi-three-dots",
            _ => "bi-credit-card-2-front"
        };
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/orders/checkout.css" asp-append-version="true" />
}

<div class="yq-checkout">

    <!-- PROGRESS STEPS -->
    <nav class="yq-checkout-steps yq-reveal" aria-label="مراحل إتمام الطلب">
        <div class="yq-checkout-step is-done">
            <span class="yq-checkout-step__icon"><i class="bi bi-check-lg"></i></span>
            <span class="yq-checkout-step__label">السلة</span>
        </div>
        <div class="yq-checkout-step__connector is-done"></div>
        <div class="yq-checkout-step is-active">
            <span class="yq-checkout-step__icon">2</span>
            <span class="yq-checkout-step__label">الدفع</span>
        </div>
        <div class="yq-checkout-step__connector"></div>
        <div class="yq-checkout-step">
            <span class="yq-checkout-step__icon">3</span>
            <span class="yq-checkout-step__label">التأكيد</span>
        </div>
    </nav>

    <header class="yq-checkout-header yq-reveal">
        <div class="yq-checkout-header__content">
            <span class="yq-checkout-kicker"><i class="bi bi-gem" aria-hidden="true"></i> خطوة أخيرة قبل تجهيز الطلب</span>
            <h1><i class="bi bi-credit-card" aria-hidden="true"></i> إتمام الطلب</h1>
            <p class="yq-checkout-header__desc">تبقّت الخطوة الأخيرة لتأكيد طلبك. أكمل بيانات التوصيل، اختر طريقة الدفع، ثم أكد الطلب.</p>
        </div>
        <a asp-controller="Cart" asp-action="Index" class="yq-checkout-back-link">
            <i class="bi bi-arrow-right" aria-hidden="true"></i> العودة للسلة
        </a>
    </header>

    <form asp-controller="Orders"
          asp-action="Checkout"
          method="post"
          enctype="multipart/form-data"
          id="yqCheckoutForm"
          data-yq-checkout-user="@(User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty)"
          novalidate>
        @Html.AntiForgeryToken()
        <input asp-for="CheckoutDraftId" type="hidden" data-yq-checkout-draft-id />
        <input type="hidden" asp-for="SubmittedCartTotal" value="@expectedTotal" />
        @for (var snapshotIndex = 0; snapshotIndex < items.Count; snapshotIndex++)
        {
            <input type="hidden" name="SubmittedCartItems[@snapshotIndex].ProductId" value="@items[snapshotIndex].Productid" />
            <input type="hidden" name="SubmittedCartItems[@snapshotIndex].RetailPriceId" value="@items[snapshotIndex].RetailPriceId" />
            <input type="hidden" name="SubmittedCartItems[@snapshotIndex].RetailSizeMl" value="@items[snapshotIndex].RetailPrice?.SizeMl" />
            <input type="hidden" name="SubmittedCartItems[@snapshotIndex].Quantity" value="@items[snapshotIndex].Quantity" />
            <input type="hidden" name="SubmittedCartItems[@snapshotIndex].UnitPrice" value="@UnitPrice(items[snapshotIndex])" />
        }

        @if (hasModelErrors)
        {
            <div asp-validation-summary="ModelOnly" class="yaqut-alert yaqut-alert--danger yq-reveal" role="alert"></div>
        }

        <section class="yq-checkout-draft-recovery yq-glass" data-yq-checkout-draft-recovery hidden aria-labelledby="yqCheckoutDraftRecoveryTitle">
            <div>
                <h2 id="yqCheckoutDraftRecoveryTitle">هل تريد استعادة بيانات التوصيل السابقة؟</h2>
                <p>عثرنا على مسودة مؤقتة محفوظة لهذا الحساب.</p>
            </div>
            <div class="yq-checkout-draft-recovery__actions">
                <button type="button" class="btn-yaqut-gold" data-yq-checkout-draft-restore>استعادة بيانات التوصيل السابقة</button>
                <button type="button" class="yq-checkout-draft-recovery__fresh" data-yq-checkout-draft-fresh>البدء من جديد</button>
            </div>
        </section>

        <div class="yq-checkout-layout">

        <!-- LEFT: DETAILS -->
        <div class="yq-checkout-details yq-reveal">

            <!-- CUSTOMER INFO -->
            <section class="yq-checkout-card yq-checkout-card--customer yq-glass">
                <div class="yq-checkout-card__head">
                    <div class="yq-checkout-card__title-row">
                        <span class="yq-checkout-card__step">01</span>
                        <h2 class="yq-checkout-card__title"><i class="bi bi-person" aria-hidden="true"></i> معلومات العميل</h2>
                    </div>
                    <p class="yq-checkout-card__desc">بيانات التواصل الأساسية لمتابعة الطلب.</p>
                </div>

                <!-- Mobile compact customer summary (read-only presentation) -->
                <div class="yq-checkout-customer-summary" aria-label="بيانات العميل">
                    <span class="yq-checkout-customer-pill">
                        <i class="bi bi-person" aria-hidden="true"></i>
                        <span>@customerName</span>
                    </span>
                    @if (!string.IsNullOrWhiteSpace(customerPhone))
                    {
                        <span class="yq-checkout-customer-pill">
                            <i class="bi bi-telephone" aria-hidden="true"></i>
                            <span dir="ltr">@customerPhone</span>
                        </span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model?.CustomerEmail))
                    {
                        <span class="yq-checkout-customer-pill">
                            <i class="bi bi-envelope" aria-hidden="true"></i>
                            <span dir="ltr">@Model.CustomerEmail</span>
                        </span>
                    }
                </div>

                <!-- Desktop/Tablet canonical inputs (participate in form submission) -->
                <div class="yq-checkout-field-grid yq-checkout-customer-fields">
                    <label class="yq-checkout-field">
                        <span>الاسم الكامل</span>
                        <input asp-for="CustomerName" form="yqCheckoutForm" type="text" value="@customerName" readonly="readonly" class="yq-readonly" />
                        <span asp-validation-for="CustomerName" class="yq-checkout-field__error"></span>
                    </label>
                    <label class="yq-checkout-field">
                        <span>رقم الجوال</span>
                        <input asp-for="CustomerPhone" form="yqCheckoutForm" type="tel" value="@customerPhone"
                               readonly="readonly" class="yq-readonly" dir="ltr" />
                        <span asp-validation-for="CustomerPhone" class="yq-checkout-field__error"></span>
                    </label>
                    <label class="yq-checkout-field yq-checkout-field--wide">
                        <span>البريد الإلكتروني</span>
                        <input asp-for="CustomerEmail" form="yqCheckoutForm" type="email" value="@Model?.CustomerEmail" readonly="readonly" class="yq-readonly" />
                        <span asp-validation-for="CustomerEmail" class="yq-checkout-field__error"></span>
                    </label>
                </div>
            </section>

            <!-- DELIVERY INFO -->
            <section class="yq-checkout-card yq-glass">
                <div class="yq-checkout-card__head">
                    <div class="yq-checkout-card__title-row">
                        <span class="yq-checkout-card__step">02</span>
                        <h2 class="yq-checkout-card__title"><i class="bi bi-truck" aria-hidden="true"></i> معلومات التوصيل</h2>
                    </div>
                    <p class="yq-checkout-card__desc">العنوان الذي سيتم اعتماده عند تأكيد الطلب.</p>
                </div>
                <div class="yq-checkout-field-grid">
                    <label class="yq-checkout-field">
                        <span>المحافظة</span>
                        <input asp-for="Governorate" id="govInput" form="yqCheckoutForm" type="text" autocomplete="address-level1" list="yemen-govs"  title="الرجاء إدخال أحرف فقط" />
                        <span asp-validation-for="Governorate" class="yq-checkout-field__error"></span>
                        <datalist id="yemen-govs">
                            <option value="حضرموت"></option>
                            <option value="عدن"></option>
                            <option value="صنعاء"></option>
                            <option value="تعز"></option>
                            <option value="الحديدة"></option>
                            <option value="المهرة"></option>
                            <option value="شبوة"></option>
                            <option value="أبين"></option>
                            <option value="لحج"></option>
                            <option value="مأرب"></option>
                            <option value="إب"></option>
                            <option value="الضالع"></option>
                            <option value="البيضاء"></option>
                            <option value="حجة"></option>
                            <option value="عمران"></option>
                            <option value="صعدة"></option>
                            <option value="المحويت"></option>
                            <option value="ذمار"></option>
                            <option value="ريمة"></option>
                            <option value="الجوف"></option>
                            <option value="سقطرى"></option>
                        </datalist>
                    </label>
                    <label class="yq-checkout-field">
                        <span>المدينة</span>
                        <input asp-for="City" id="cityInput" form="yqCheckoutForm" type="text" autocomplete="address-level2" list="yemen-cities"  title="الرجاء إدخال أحرف فقط" />
                        <span asp-validation-for="City" class="yq-checkout-field__error"></span>
                        <datalist id="yemen-cities"></datalist>
                    </label>
                    <label class="yq-checkout-field">
                        <span>اسم المستلم</span>
                        <input asp-for="District" form="yqCheckoutForm" type="text"  title="الرجاء إدخال أحرف فقط"  />
                        <span asp-validation-for="District" class="yq-checkout-field__error"></span>
                    </label>
                    <label class="yq-checkout-field">
                        <span>رقم جوال المستلم</span>
                        <input asp-for="Street" form="yqCheckoutForm" type="tel" minlength="9" maxlength="9"
                               inputmode="numeric" autocomplete="tel"
                               required
                               pattern="7[01378][0-9]{7}"
                               dir="ltr"
                               placeholder="7xxxxxxxx"
                               title="أدخل 9 أرقام تبدأ بـ 70 أو 71 أو 73 أو 77 أو 78" />
                        <span asp-validation-for="Street" class="yq-checkout-field__error"></span>
                    </label>
                    <label class="yq-checkout-field yq-checkout-field--wide">
                        <span>ملاحظات إضافية</span>
                        <textarea asp-for="DeliveryNotes" form="yqCheckoutForm" rows="3"></textarea>
                        <span asp-validation-for="DeliveryNotes" class="yq-checkout-field__error"></span>
                    </label>
                </div>
                <div class="yq-checkout-delivery-note">
                    <i class="bi bi-clock-history"></i>
                    <span>مدة التوصيل المتوقعة 2-3 أيام عمل، وسيتم التواصل معك لتأكيد التفاصيل قبل التسليم.</span>
                </div>
            </section>

            <!-- PAYMENT METHOD -->
            <section class="yq-checkout-card yq-glass">
                <div class="yq-checkout-card__head">
                    <div class="yq-checkout-card__title-row">
                        <span class="yq-checkout-card__step">03</span>
                        <h2 class="yq-checkout-card__title"><i class="bi bi-wallet2" aria-hidden="true"></i> طريقة الدفع</h2>
                    </div>
                    <p class="yq-checkout-card__desc">اختر طريقة الدفع المناسبة؛ الخيار المحدد سيظهر بإطار ذهبي واضح.</p>
                </div>
                <fieldset class="yq-checkout-payment-fieldset" aria-describedby="paymentMethodError">
                    <legend class="visually-hidden">اختر طريقة الدفع</legend>
                    @if (hasPaymentPages)
                    {
                        <div class="yq-checkout-payment-nav" data-yq-payment-nav>
                            <span data-yq-payment-status></span>
                            <div>
                                <button type="button" class="yq-checkout-payment-nav__btn" data-yq-payment-prev aria-label="طرق الدفع السابقة">
                                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                </button>
                                <button type="button" class="yq-checkout-payment-nav__btn" data-yq-payment-next aria-label="طرق الدفع التالية">
                                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                    }
                    <div class="yq-checkout-payment" data-yq-payment-list data-yq-payment-page="@initialPaymentPage">
                        @for (var methodIndex = 0; methodIndex < checkoutPaymentMethods.Count; methodIndex++)
                        {
                            var method = checkoutPaymentMethods[methodIndex];
                            var isSelected = string.Equals(selectedPaymentMethod, method.Type, StringComparison.OrdinalIgnoreCase);
                            var inputId = $"PaymentMethod-{method.Type}";
                            var isInitialVisible = !hasPaymentPages || (methodIndex >= initialPaymentStart && methodIndex < initialPaymentEnd);
                            <label for="@inputId"
                                   class="yq-checkout-payment__option @(isSelected ? "is-selected" : "") @(isInitialVisible ? "" : "is-page-hidden")"
                                   data-yq-payment-option
                                   data-yq-payment-index="@methodIndex">
                                <input asp-for="PaymentMethod" id="@inputId" form="yqCheckoutForm" type="radio" value="@method.Type" checked="@isSelected" />
                                <div class="yq-checkout-payment__main">
                                    <span class="yq-checkout-payment__icon"><i class="bi @PaymentIcon(method.Type)" aria-hidden="true"></i></span>
                                    <div class="yq-checkout-payment__text">
                                        <div class="yq-checkout-payment__title-wrap">
                                            <strong>@method.Name</strong>
                                            <span class="yq-checkout-payment__badge" aria-hidden="true">محدد</span>
                                        </div>
                                        <small>@(method.Type == "other" ? "سيتم الاتفاق على الطريقة المناسبة قبل التجهيز" : "اختره وسيتم تأكيد الدفع مع الطلب")</small>
                                    </div>
                                    <i class="bi bi-check-circle-fill yq-checkout-payment__check" aria-hidden="true"></i>
                                </div>
                                <div class="yq-checkout-payment__details">
                                    @if (method.Type == "other")
                                    {
                                        <p class="yq-checkout-payment__instructions">@(string.IsNullOrWhiteSpace(method.Instructions) ? "لم تتم إضافة تعليمات لهذه الطريقة بعد." : method.Instructions)</p>
                                    }
                                    else
                                    {
                                        <div class="yq-checkout-payment__detail-row">
                                            <span class="yq-checkout-payment__detail-label">اسم الحساب:</span>
                                            <span class="yq-checkout-payment__detail-value">@(string.IsNullOrWhiteSpace(method.Accountholdername) ? "غير محدد" : method.Accountholdername)</span>
                                        </div>
                                        <div class="yq-checkout-payment__detail-row">
                                            <span class="yq-checkout-payment__detail-label">رقم الحساب:</span>
                                            <span class="yq-checkout-payment__detail-value"><b dir="ltr">@(string.IsNullOrWhiteSpace(method.Accountnumber) ? "غير محدد" : method.Accountnumber)</b></span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(method.Instructions))
                                        {
                                            <p class="yq-checkout-payment__instructions">@method.Instructions</p>
                                        }
                                    }
                                </div>
                            </label>
                        }
                    </div>
                </fieldset>
                <span asp-validation-for="PaymentMethod" id="paymentMethodError" class="yq-checkout-field__error yq-checkout-field__error--payment" role="alert"></span>

                @if (paymentProofEnabled)
                {
                <div id="receiptUploadSection" class="yq-receipt-upload-section">
                    <div class="yq-receipt-box">
                        <div class="yq-receipt-box__header">
                            <span class="yq-receipt-box__icon" aria-hidden="true"><i class="bi bi-cloud-arrow-up"></i></span>
                            <div class="yq-receipt-box__title-wrap">
                                <label for="yqReceiptInput" class="yq-receipt-box__title">
                                    <span>صورة إيصال التحويل</span>
                                    <span class="yq-receipt-box__optional">(اختياري)</span>
                                </label>
                                <p class="yq-receipt-box__subtitle">أرفق صورة الإيصال لتأكيد وتجهيز طلبك فوراً.</p>
                            </div>
                        </div>

                        <div class="yq-receipt-upload-container">
                            <input asp-for="ReceiptImage"
                                   id="yqReceiptInput"
                                   form="yqCheckoutForm"
                                   type="file"
                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                   class="form-control yq-receipt-upload-input"
                                   aria-describedby="yqReceiptLimits yqReceiptHelp yqReceiptRedisplay yqReceiptError" />
                            <div id="yqReceiptSelectedFeedback" class="yq-receipt-selected-feedback" hidden>
                                <div class="yq-receipt-selected-info">
                                    <span class="yq-receipt-selected-icon" aria-hidden="true"><i class="bi bi-file-earmark-check"></i></span>
                                    <div class="yq-receipt-selected-meta">
                                        <span id="yqReceiptFileName" class="yq-receipt-filename"></span>
                                        <span id="yqReceiptFileSize" class="yq-receipt-filesize"></span>
                                    </div>
                                </div>
                                <button type="button"
                                        id="yqReceiptClearBtn"
                                        class="yq-receipt-clear-btn"
                                        aria-label="إلغاء اختيار صورة الإيصال">
                                    <i class="bi bi-x-circle" aria-hidden="true"></i>
                                    <span class="yq-receipt-clear-text">إزالة</span>
                                </button>
                            </div>
                        </div>

                        <span asp-validation-for="ReceiptImage"
                              id="yqReceiptError"
                              class="yq-checkout-field__error"
                              role="alert"
                              aria-live="polite"></span>

                        <div class="yq-receipt-helpers">
                            <div class="yq-receipt-limit-text" id="yqReceiptLimits">
                                <i class="bi bi-info-circle" aria-hidden="true"></i>
                                <span>الصيغ المدعومة: JPG، PNG، WEBP — الحد الأقصى 5 ميجابايت</span>
                            </div>
                            <small class="yq-receipt-upload-note" id="yqReceiptHelp">
                                سيتم حفظ صورة الإيصال مع طلبك لمراجعته واعتماده.
                            </small>
                            <small class="yq-receipt-redisplay-note" id="yqReceiptRedisplay">
                                في حال ظهرت أخطاء في الحقول وتطلّب الأمر تصحيحها، ستحتاج لإعادة اختيار الإيصال قبل التأكيد.
                            </small>
                        </div>
                    </div>
                </div>
                }

            </section>
        </div>

        <!-- RIGHT: ORDER SUMMARY -->
        <aside class="yq-checkout-summary yq-glass yq-reveal" id="yqCheckoutSummary">
            <div class="yq-checkout-summary__head">
                <div class="yq-checkout-summary__header-static">
                    <span class="yq-checkout-summary__head-icon" aria-hidden="true"><i class="bi bi-bag-check"></i></span>
                    <div class="yq-checkout-summary__head-text">
                        <div class="yq-checkout-summary__title-wrap">
                            <h2 class="yq-checkout-summary__title">ملخص الطلب</h2>
                            <span class="yq-checkout-summary__count">(@itemsCountText)</span>
                        </div>
                        <p class="yq-checkout-summary__subtitle">تأكد من المنتجات قبل إرسال الطلب</p>
                    </div>
                </div>
                <button type="button"
                        class="yq-checkout-summary__toggle"
                        id="yqCheckoutSummaryToggle"
                        aria-expanded="false"
                        aria-controls="yqCheckoutSummaryBody"
                        aria-label="عرض تفاصيل ملخص الطلب">
                    <div class="yq-checkout-summary__toggle-main">
                        <span class="yq-checkout-summary__head-icon" aria-hidden="true"><i class="bi bi-bag-check"></i></span>
                        <div class="yq-checkout-summary__head-text">
                            <div class="yq-checkout-summary__title-wrap">
                                <h2 class="yq-checkout-summary__title">ملخص الطلب</h2>
                                <span class="yq-checkout-summary__count">(@itemsCountText)</span>
                            </div>
                            <p class="yq-checkout-summary__subtitle">تأكد من المنتجات قبل إرسال الطلب</p>
                        </div>
                    </div>
                    <div class="yq-checkout-summary__toggle-side">
                        <span class="yq-checkout-summary__collapsed-total" data-yq-summary-collapsed-total>
                            @(expectedTotal.ToYaqutPrice(promoResult?.CurrencyCode))
                        </span>
                        <span class="yq-checkout-summary__toggle-action">
                            <span class="yq-checkout-summary__toggle-text">عرض التفاصيل</span>
                            <i class="bi bi-chevron-down yq-checkout-summary__chevron" aria-hidden="true"></i>
                        </span>
                    </div>
                </button>
            </div>

            <div class="yq-checkout-summary__body" id="yqCheckoutSummaryBody" hidden>
                <div class="yq-checkout-summary__items">
                    @foreach (var item in items)
                    {
                        var lineTotal = item.Quantity * UnitPrice(item);
                        var itemPromo = promoResult?.ItemResults.FirstOrDefault(ir => ir.ProductId == item.Productid && ir.RetailPriceId == item.RetailPriceId);
                        var productImageUrl = Url.Content("~/images/placeholder-product.svg");
                        if (!string.IsNullOrWhiteSpace(item.Product?.Imageurl))
                        {
                            var candidateImageUrl = item.Product.Imageurl.Trim();
                            if (Uri.TryCreate(candidateImageUrl, UriKind.Absolute, out var absoluteImageUri))
                            {
                                if (absoluteImageUri.Scheme == Uri.UriSchemeHttp || absoluteImageUri.Scheme == Uri.UriSchemeHttps)
                                {
                                    productImageUrl = candidateImageUrl;
                                }
                            }
                            else
                            {
                                var localImageUrl = candidateImageUrl.TrimStart('/');
                                while (localImageUrl.StartsWith("./", StringComparison.Ordinal))
                                {
                                    localImageUrl = localImageUrl[2..];
                                }

                                var pathEnd = localImageUrl.IndexOfAny(new[] { '?', '#' });
                                var localImagePath = pathEnd >= 0 ? localImageUrl[..pathEnd] : localImageUrl;
                                var decodedLocalPath = Uri.UnescapeDataString(localImagePath).Replace('\\', '/');
                                var hasParentSegment = decodedLocalPath.Split('/', StringSplitOptions.RemoveEmptyEntries).Contains("..");
                                if (!string.IsNullOrWhiteSpace(localImagePath) &&
                                    !localImagePath.Contains(':') &&
                                    !localImagePath.Contains('\\') &&
                                    !hasParentSegment)
                                {
                                    productImageUrl = Url.Content("~/" + localImageUrl);
                                }
                            }
                        }
                        <div class="yq-checkout-summary__item">
                            <div class="yq-checkout-summary__item-media">
                                <img src="@productImageUrl"
                                     alt="@item.Product?.Name"
                                     width="52"
                                     height="52"
                                     decoding="async"
                                     data-yaqut-fallback="/images/placeholder-product.svg" />
                                <span class="yq-checkout-summary__item-qty">@item.Quantity</span>
                            </div>
                            <span class="yq-checkout-summary__item-name">@item.Product?.Name @(string.IsNullOrWhiteSpace(UnitLabel(item)) ? "" : $" - {UnitLabel(item)}")</span>
                            <span class="yq-checkout-summary__item-price">
                                @if (itemPromo != null && itemPromo.DiscountAmount > 0)
                                {
                                    <span class="text-success fw-bold">@((itemPromo.FinalPrice * item.Quantity).ToYaqutPrice(promoResult?.CurrencyCode))</span>
                                }
                                else
                                {
                                    @(lineTotal.ToYaqutPrice(promoResult?.CurrencyCode))
                                }
                            </span>
                        </div>
                    }
                    @if (promoResult?.FreeProducts?.Any() == true)
                    {
                        @foreach (var fp in promoResult.FreeProducts)
                        {
                            <div class="yq-checkout-summary__item border-start border-success border-3 ps-2">
                                <div class="yq-checkout-summary__item-media">
                                    <img src="/images/placeholder-product.svg" width="52" height="52" alt="@fp.ProductName" />
                                    <span class="yq-checkout-summary__item-qty bg-success">@fp.FreeQuantity</span>
                                </div>
                                <span class="yq-checkout-summary__item-name">@fp.ProductName - <strong class="text-success">هدية (@fp.PromotionTitle)</strong></span>
                                <span class="yq-checkout-summary__item-price text-success fw-bold">مجاناً</span>
                            </div>
                        }
                    }
                </div>

                <div class="yq-checkout-summary__divider"></div>

                <div class="yq-checkout-summary__row">
                    <span>قيمة المنتجات</span>
                    <span>@((promoResult?.OriginalTotal ?? subtotal).ToYaqutPrice(promoResult?.CurrencyCode))</span>
                </div>
                @if (promoResult != null && promoResult.DiscountTotal > 0)
                {
                    <div class="yq-checkout-summary__row text-success">
                        <span>خصم العروض</span>
                        <span>- @(promoResult.DiscountTotal.ToYaqutPrice(promoResult.CurrencyCode))</span>
                    </div>
                    @if (promoResult.AppliedPromotions.Any())
                    {
                        <div class="mb-2 pe-1 border-end border-2 border-success">
                            @foreach (var ap in promoResult.AppliedPromotions)
                            {
                                <div class="small text-muted d-flex justify-content-between">
                                    <span><i class="bi bi-tag-fill text-success me-1"></i> @ap.Title</span>
                                    <span>- @(ap.DiscountAmount.ToYaqutPrice(promoResult.CurrencyCode))</span>
                                </div>
                            }
                        </div>
                    }
                }
                <div class="yq-checkout-summary__row">
                    <span>الشحن</span>
                    @await Html.PartialAsync("_FreeShipping")
                </div>

                <div class="yq-checkout-summary__divider"></div>

                <div class="yq-checkout-summary__row yq-checkout-summary__row--total">
                    <span>الإجمالي</span>
                    <span>@(expectedTotal.ToYaqutPrice(promoResult?.CurrencyCode))</span>
                </div>
            </div>

            <div class="yq-checkout-summary__actions">
                @if (orderCreateEnabled)
                {
                <button type="submit" form="yqCheckoutForm" class="btn-yaqut-gold yq-checkout-place-btn" id="yqPlaceOrderBtn">
                    <i class="bi bi-shield-check" aria-hidden="true"></i> تأكيد الطلب
                </button>
                }

                <p class="yq-checkout-summary__secure">
                    <i class="bi bi-lock" aria-hidden="true"></i> معاملتك محمية وآمنة بالكامل
                </p>
            </div>
        </aside>
        </div>
    </form>
</div>

@if (ViewData["CheckoutDraftJson"] != null)
{
    <script id="yq-server-checkout-draft" type="application/json">
        @Html.Raw(ViewData["CheckoutDraftJson"])
    </script>
}

@await Html.PartialAsync("_YaqutOperationDialog")

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script nonce="@Context.Items["csp-nonce"]">
        const yemenData = {
            "حضرموت": ["الشحر", "المكلا", "سيئون", "تريم", "غيل باوزير", "الديس الشرقية", "القطن", "دوعن", "الشعب", "حريضة"],
            "عدن": ["كريتر", "المعلا", "التواهي", "الشيخ عثمان", "المنصورة", "خور مكسر", "دار سعد", "البريقة"],
            "صنعاء": ["صنعاء القديمة", "السبعين", "الوحدة", "الصافية", "شعوب", "التحرير", "الثورة", "معين", "بني الحارث"],
            "تعز": ["المظفر", "القاهرة", "صالة", "الشمايتين", "المخا", "التربة"],
            "الحديدة": ["الميناء", "الحوك", "الحالي", "باجل", "بيت الفقيه", "الخوخة", "الدريهمي"],
            "شبوة": ["عتق", "بيحان", "عسيلان", "رضوم", "ميفعة", "حبان"],
            "المهرة": ["الغيضة", "حوف", "سيحوت", "قشن", "شحن"],
            "أبين": ["زنجبار", "جعار", "لودر", "مودية", "أحور", "المحفد"],
            "لحج": ["الحوطة", "تبن", "يافع", "المقاطرة", "الوهط", "طور الباحة"],
            "مأرب": ["مأرب", "حريب", "الجوبة", "العبدية"],
            "إب": ["إب", "يريم", "جبلة", "القاعدة", "العدين"],
            "الضالع": ["الضالع", "قعطبة", "دمت", "الحصين", "الشعيب"],
            "البيضاء": ["البيضاء", "رداع", "مكيراس", "الزاهر"],
            "حجة": ["حجة", "عبس", "حرض", "ميدي"],
            "عمران": ["عمران", "خمر", "حوث", "ريدة"],
            "صعدة": ["صعدة", "رازح", "كتاف", "سحار"],
            "المحويت": ["المحويت", "الرجم", "شبام كوكبان"],
            "ذمار": ["ذمار", "معبر", "مدينة الشرق"],
            "ريمة": ["الجبين", "الجعفرية", "كسمة"],
            "الجوف": ["الحزم", "الغيل", "خب والشعف"],
            "سقطرى": ["حديبو", "قلنسية"]
        };

        function updateCities() {
            const govInput = document.getElementById("govInput")?.value;
            const cityList = document.getElementById("yemen-cities");
            if(!cityList) return;
            cityList.innerHTML = "";
            if (yemenData[govInput]) {
                yemenData[govInput].forEach(city => {
                    const option = document.createElement("option");
                    option.value = city;
                    cityList.appendChild(option);
                });
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            updateCities();
        });
    </script>
    <script src="~/js/orders/checkout.js" asp-append-version="true"></script>
}
