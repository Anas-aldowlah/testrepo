@model YAGOT_2._0.Models.Cart
@using YAGOT_2._0.Services
@using System.Security.Claims
@inject DealingAPI DealingApiService
@{
    ViewData["Title"] = "إتمام الطلب";
    var items = Model?.Cartitems?.ToList() ?? new List<YAGOT_2._0.Models.Cartitem>();
    decimal subtotal = items.Sum(i => i.Quantity * (i.Product?.Price ?? 0));
    var qualifiesForFreeShipping = ShippingPolicy.QualifiesForFreeShipping(subtotal);
    var remainingForFreeShipping = ShippingPolicy.RemainingForFreeShipping(subtotal);
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var checkoutFormValues = ViewData["CheckoutFormValues"] as Microsoft.AspNetCore.Http.IFormCollection;
    var showAuthModal = (ViewData["ShowAuthModal"] as bool?) == true;
    var customerName = User.Identity?.Name;
    var encryptedPhone = User.FindFirst(ClaimTypes.MobilePhone)?.Value;
    string customerPhone = DealingApiService.DecryptPhone(encryptedPhone);
    string CheckoutValue(string name, string? fallback = null)
    {
        if (checkoutFormValues != null && checkoutFormValues.TryGetValue(name, out var value))
        {
            return value.ToString();
        }

        return fallback ?? string.Empty;
    }
    var selectedPaymentMethod = CheckoutValue("paymentMethod", "al-amqi");
}

@section Styles {
    <link rel="stylesheet" href="~/css/orders/checkout.css" asp-append-version="true" />
}

<div class="yq-checkout">

    <!-- PROGRESS STEPS -->
    <nav class="yq-checkout-steps yq-reveal" aria-label="مراحل إتمام الطلب">
        <div class="yq-checkout-step is-done">
            <span class="yq-checkout-step__icon"><i class="bi bi-check-lg"></i></span>
            <span class="yq-checkout-step__label">السلة</span>
        </div>
        <div class="yq-checkout-step__connector is-done"></div>
        <div class="yq-checkout-step is-active">
            <span class="yq-checkout-step__icon">2</span>
            <span class="yq-checkout-step__label">الدفع</span>
        </div>
        <div class="yq-checkout-step__connector"></div>
        <div class="yq-checkout-step">
            <span class="yq-checkout-step__icon">3</span>
            <span class="yq-checkout-step__label">التأكيد</span>
        </div>
    </nav>

    <header class="yq-checkout-header yq-reveal">
        <div>
            <span class="yq-checkout-kicker"><i class="bi bi-gem"></i> خطوة أخيرة قبل تجهيز الطلب</span>
            <h1><i class="bi bi-credit-card"></i> إتمام الطلب</h1>
            <p>راجع بياناتك واختر طريقة الدفع المناسبة، وسيتم التواصل معك لتأكيد التفاصيل قبل التجهيز.</p>
        </div>
        <a asp-controller="Cart" asp-action="Index" class="yq-checkout-back-link">
            <i class="bi bi-arrow-right"></i> العودة للسلة
        </a>
    </header>

    @if (TempData["Error"] != null)
    {
        <div class="yaqut-alert yaqut-alert--danger yq-reveal">
            <i class="bi bi-exclamation-circle"></i> @TempData["Error"]
        </div>
    }

    <div class="yq-checkout-layout">

        <!-- LEFT: DETAILS -->
        <div class="yq-checkout-details yq-reveal">

            <!-- CUSTOMER INFO -->
            <section class="yq-checkout-card yq-glass">
                <div class="yq-checkout-card__head">
                    <span class="yq-checkout-card__step">01</span>
                    <div>
                        <h2 class="yq-checkout-card__title"><i class="bi bi-person"></i> معلومات العميل</h2>
                        <p class="yq-checkout-card__desc">بيانات التواصل الأساسية لمتابعة الطلب.</p>
                    </div>
                </div>
                <div class="yq-checkout-field-grid">
                    <label class="yq-checkout-field">
                        <span>الاسم الكامل</span>
                        <input form="yqCheckoutForm" type="text" name="customerName" value="@CheckoutValue("customerName", customerName)" autocomplete="name" />
                    </label>
                    <label class="yq-checkout-field">
                        <span>رقم الجوال</span>
                        <input form="yqCheckoutForm" type="tel" name="customerPhone" value="@CheckoutValue("customerPhone", customerPhone)" autocomplete="tel" inputmode="tel" />
                    </label>
                    <label class="yq-checkout-field yq-checkout-field--wide">
                        <span>البريد الإلكتروني <small>اختياري</small></span>
                        <input form="yqCheckoutForm" type="email" name="customerEmail" value="@CheckoutValue("customerEmail")" autocomplete="email" />
                    </label>
                </div>
            </section>

            <!-- DELIVERY INFO -->
            <section class="yq-checkout-card yq-glass">
                <div class="yq-checkout-card__head">
                    <span class="yq-checkout-card__step">02</span>
                    <div>
                        <h2 class="yq-checkout-card__title"><i class="bi bi-truck"></i> معلومات التوصيل</h2>
                        <p class="yq-checkout-card__desc">العنوان الذي سيتم اعتماده عند تأكيد الطلب.</p>
                    </div>
                </div>
                <div class="yq-checkout-field-grid">
                    <label class="yq-checkout-field">
                        <span>المحافظة</span>
                        <input form="yqCheckoutForm" type="text" name="governorate" value="@CheckoutValue("governorate")" autocomplete="address-level1" />
                    </label>
                    <label class="yq-checkout-field">
                        <span>المدينة</span>
                        <input form="yqCheckoutForm" type="text" name="city" value="@CheckoutValue("city")" autocomplete="address-level2" />
                    </label>
                    <label class="yq-checkout-field">
                        <span>الحي</span>
                        <input form="yqCheckoutForm" type="text" name="district" value="@CheckoutValue("district")" autocomplete="address-level3" />
                    </label>
                    <label class="yq-checkout-field">
                        <span>الشارع</span>
                        <input form="yqCheckoutForm" type="text" name="street" value="@CheckoutValue("street")" autocomplete="street-address" />
                    </label>
                    <label class="yq-checkout-field yq-checkout-field--wide">
                        <span>ملاحظات إضافية</span>
                        <textarea form="yqCheckoutForm" name="deliveryNotes" rows="3">@CheckoutValue("deliveryNotes")</textarea>
                    </label>
                </div>
                <div class="yq-checkout-delivery-note">
                    <i class="bi bi-clock-history"></i>
                    <span>مدة التوصيل المتوقعة 2-3 أيام عمل، وسيتم التواصل معك لتأكيد التفاصيل قبل التسليم.</span>
                </div>
            </section>

            <!-- PAYMENT METHOD -->
            <section class="yq-checkout-card yq-glass">
                <div class="yq-checkout-card__head">
                    <span class="yq-checkout-card__step">03</span>
                    <div>
                        <h2 class="yq-checkout-card__title"><i class="bi bi-wallet2"></i> طريقة الدفع</h2>
                        <p class="yq-checkout-card__desc">اختر البطاقة المناسبة؛ الخيار المحدد سيظهر بإطار ذهبي واضح.</p>
                    </div>
                </div>
                <div class="yq-checkout-payment">
                    <label class="yq-checkout-payment__option @(selectedPaymentMethod == "al-amqi" ? "is-selected" : "")">
                        <input form="yqCheckoutForm" type="radio" name="paymentMethod" value="al-amqi" checked="@(selectedPaymentMethod == "al-amqi")" />
                        <span class="yq-checkout-payment__icon"><i class="bi bi-cash-coin"></i></span>
                        <span class="yq-checkout-payment__text">
                            <strong>العمقي</strong>
                            <small>خيار دفع محلي جاهز للتأكيد عند التواصل</small>
                        </span>
                        <i class="bi bi-check-circle-fill yq-checkout-payment__check"></i>
                    </label>

                    <label class="yq-checkout-payment__option @(selectedPaymentMethod == "bin-dawl" ? "is-selected" : "")">
                        <input form="yqCheckoutForm" type="radio" name="paymentMethod" value="bin-dawl" checked="@(selectedPaymentMethod == "bin-dawl")" />
                        <span class="yq-checkout-payment__icon"><i class="bi bi-bank"></i></span>
                        <span class="yq-checkout-payment__text">
                            <strong>بن دول</strong>
                            <small>اختره وسيتم تأكيد آلية الدفع مع الطلب</small>
                        </span>
                        <i class="bi bi-check-circle-fill yq-checkout-payment__check"></i>
                    </label>

                    <label class="yq-checkout-payment__option @(selectedPaymentMethod == "al-basiri" ? "is-selected" : "")">
                        <input form="yqCheckoutForm" type="radio" name="paymentMethod" value="al-basiri" checked="@(selectedPaymentMethod == "al-basiri")" />
                        <span class="yq-checkout-payment__icon"><i class="bi bi-wallet2"></i></span>
                        <span class="yq-checkout-payment__text">
                            <strong>البسيري</strong>
                            <small>طريقة دفع سهلة لمتابعة الطلب بعد التأكيد</small>
                        </span>
                        <i class="bi bi-check-circle-fill yq-checkout-payment__check"></i>
                    </label>

                    <label class="yq-checkout-payment__option @(selectedPaymentMethod == "other" ? "is-selected" : "")">
                        <input form="yqCheckoutForm" type="radio" name="paymentMethod" value="other" checked="@(selectedPaymentMethod == "other")" />
                        <span class="yq-checkout-payment__icon"><i class="bi bi-three-dots"></i></span>
                        <span class="yq-checkout-payment__text">
                            <strong>أخرى</strong>
                            <small>سيتم الاتفاق على الطريقة المناسبة قبل التجهيز</small>
                        </span>
                        <i class="bi bi-check-circle-fill yq-checkout-payment__check"></i>
                    </label>
                </div>
            </section>
        </div>

        <!-- RIGHT: ORDER SUMMARY -->
        <aside class="yq-checkout-summary yq-glass yq-reveal">
            <div class="yq-checkout-summary__head">
                <span><i class="bi bi-bag-check"></i></span>
                <div>
                    <h2 class="yq-checkout-summary__title">ملخص الطلب</h2>
                    <p>تأكد من المنتجات قبل إرسال الطلب</p>
                </div>
            </div>

            <div class="yq-checkout-summary__items">
                @foreach (var item in items)
                {
                    var lineTotal = item.Quantity * (item.Product?.Price ?? 0);
                    <div class="yq-checkout-summary__item">
                        <div class="yq-checkout-summary__item-media">
                            <img src="@(item.Product?.Imageurl ?? "/images/placeholder-product.svg")"
                                 alt="@item.Product?.Name"
                                 data-yaqut-fallback="/images/placeholder-product.svg" />
                            <span class="yq-checkout-summary__item-qty">@item.Quantity</span>
                        </div>
                        <span class="yq-checkout-summary__item-name">@item.Product?.Name</span>
                        <span class="yq-checkout-summary__item-price">@lineTotal.ToString("N0") ر.س</span>
                    </div>
                }
            </div>

            <div class="yq-checkout-summary__divider"></div>

            <div class="yq-checkout-summary__row">
                <span>المجموع الفرعي</span>
                <span>@subtotal.ToString("N0") ر.س</span>
            </div>
            <div class="yq-checkout-summary__row">
                <span>الشحن</span>
                @if (qualifiesForFreeShipping)
                {
                    <span class="yq-checkout-summary__free">مجاني</span>
                }
                else
                {
                    <span class="yq-checkout-summary__tbd">يُحدد عند الدفع</span>
                }
            </div>

            @if (!qualifiesForFreeShipping)
            {
                <p class="yq-checkout-summary__hint">
                    <i class="bi bi-truck"></i>
                    أضف <strong>@remainingForFreeShipping.ToString("N0") ر.س</strong> للحصول على شحن مجاني
                </p>
            }

            <div class="yq-checkout-summary__divider"></div>

            <div class="yq-checkout-summary__row yq-checkout-summary__row--total">
                <span>الإجمالي</span>
                <span>@subtotal.ToString("N0") <small>ر.س</small></span>
            </div>

            <form asp-controller="Orders" asp-action="Checkout" method="post" id="yqCheckoutForm"
                  data-yq-auth-required="@((!isAuthenticated).ToString().ToLowerInvariant())"
                  data-yq-auth-modal="yqCheckoutAuthModal">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-yaqut-gold yq-checkout-place-btn" id="yqPlaceOrderBtn">
                    <i class="bi bi-shield-check"></i> تأكيد الطلب والدفع
                </button>
            </form>

            <p class="yq-checkout-summary__secure">
                <i class="bi bi-lock"></i> معاملتك محمية وآمنة بالكامل
            </p>
        </aside>
    </div>
</div>

@if (!isAuthenticated)
{
    await Html.RenderPartialAsync("_CheckoutAuthModal", showAuthModal);
}

@section Scripts {
    <script src="~/js/orders/checkout.js" asp-append-version="true"></script>
}
