@model YAGOT_2._0.Models.Order
@using System.Security.Claims
@using YAGOT_2._0.Services
@inject DealingAPI DealingApiService
@{
    ViewData["Title"] = $"تأكيد الطلب #{Model.Id}";
    var items = Model.Orderitems?.ToList() ?? new List<YAGOT_2._0.Models.Orderitem>();

    var delivery = Model.Deliveryorder;
    var customerName = Model.User?.Name ?? User.Identity?.Name ?? "العميل";
    var recipientName = delivery?.Fullname ?? customerName;
    var rawPhone = delivery?.Phonenumber ?? Model.User?.Phone ?? User.FindFirst(ClaimTypes.MobilePhone)?.Value;
    var customerPhone = DealingApiService.DecryptPhone(rawPhone) ?? rawPhone ?? "-";
    var orderDate = Model.Orderdate.HasValue ? Model.Orderdate.Value.ToString("dd/MM/yyyy HH:mm") : "-";
    var destinationParts = delivery != null
        ? new[] { delivery.Governorate, delivery.City, delivery.District, delivery.Secondphonenumber }
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Select(s => s!)
            .ToList()
        : new List<string>();
    var destinationText = destinationParts.Count > 0 ? string.Join("، ", destinationParts) : null;

    var checkoutDraftIdToClear = ViewData["CheckoutDraftIdToClear"] as string ?? string.Empty;
    var customerOrderWhatsAppUrl = ViewData["CustomerOrderWhatsAppUrl"] as string;

    var paymentPresentations = ViewData["PaymentMethodPresentations"] as IReadOnlyDictionary<string, PaymentMethodPresentation>;
    var paymentPresentation = !string.IsNullOrWhiteSpace(Model.Paymentmethod) &&
        paymentPresentations?.TryGetValue(Model.Paymentmethod, out var configuredPayment) == true
            ? configuredPayment
            : new PaymentMethodPresentation(
                Model.Paymentmethod ?? string.Empty,
                string.IsNullOrWhiteSpace(Model.Paymentmethod) ? "طريقة دفع غير محددة" : "طريقة دفع مسجلة سابقاً",
                string.Empty,
                string.Empty,
                null,
                false);

    var isPaid = Model.Paymentstatus == "Paid" || Model.Status is "Paid" or "Processed" or "Shipped" or "Delivered";
    var isConflictAwaitingDecision = Model.Workflowstate == OrderWorkflowStates.ConflictAwaitingDecision;
    var hasReceipt = !string.IsNullOrWhiteSpace(Model.Receipturl);

    string paymentStateDescription;
    string paymentStateKind;

    if (isPaid)
    {
        paymentStateDescription = "تم التحقق من الدفع وتأكيد الحساب بنجاح.";
        paymentStateKind = "verified";
    }
    else if (isConflictAwaitingDecision)
    {
        paymentStateDescription = "مراجعة الدفع معلّقة بانتظار تأكيد قرارك بشأن الكميات المتاحة في تفاصيل الطلب.";
        paymentStateKind = "review";
    }
    else if (hasReceipt)
    {
        paymentStateDescription = "تم استلام إشعار التحويل. بانتظار مراجعة الدفع والمخزون من قبل المتجر. لا يلزمك إجراء الآن.";
        paymentStateKind = "pending";
    }
    else
    {
        paymentStateDescription = "لم يتم إرفاق إشعار دفع أثناء إنشاء الطلب. يرجى استكمال الدفع وفق بيانات طريقة الدفع الموضحة أدناه ليتمكن المتجر من مراجعة الطلب وتأكيده. إذا كنت قد أتممت الدفع، يمكنك التواصل معنا عبر واتساب للمتابعة.";
        paymentStateKind = "unpaid";
    }

    var currentStatus = Model.Status ?? "Pending";
    var isCancelled = currentStatus is "Cancelled" or "Refunded";

    string statusBadgeLabel;
    string statusBadgeClass;
    string statusExplanation;

    switch (currentStatus)
    {
        case "Paid":
            statusBadgeLabel = "تم الدفع";
            statusBadgeClass = "yaqut-badge--processed";
            statusExplanation = "تم التحقق من الدفع واعتماد الطلب بنجاح، وسيبدأ التجهيز قريباً.";
            break;
        case "Processed":
            statusBadgeLabel = "قيد التحضير";
            statusBadgeClass = "yaqut-badge--processed";
            statusExplanation = "يجري تجهيز وتغليف طلبك حالياً تمهيداً لتسليمه لمندوب التوصيل.";
            break;
        case "Shipped":
            statusBadgeLabel = "تم الشحن";
            statusBadgeClass = "yaqut-badge--shipped";
            statusExplanation = "طلبك في طريقه إليك الآن مع مندوب التوصيل.";
            break;
        case "Delivered":
            statusBadgeLabel = "تم التوصيل";
            statusBadgeClass = "yaqut-badge--delivered";
            statusExplanation = "تم تسليم الطلب بنجاح. نشكرك لاختيارك ياقوت للعطور الفاخرة.";
            break;
        case "Cancelled":
        case "Refunded":
            statusBadgeLabel = currentStatus == "Refunded" ? "مرتجع" : "تم الإلغاء";
            statusBadgeClass = "yaqut-badge--cancelled";
            statusExplanation = "تم إلغاء هذا الطلب. إذا كان لديك أي استفسار، يرجى التواصل مع خدمة العملاء.";
            break;
        default:
            if (isConflictAwaitingDecision)
            {
                statusBadgeLabel = "مراجعة مطلوبة";
                statusBadgeClass = "yaqut-badge--pending";
                statusExplanation = "مراجعة الطلب معلّقة بانتظار قرارك بشأن الكميات المتاحة. راجع تفاصيل الطلب لاختيار الإجراء المناسب.";
            }
            else
            {
                statusBadgeLabel = "قيد الانتظار";
                statusBadgeClass = "yaqut-badge--pending";
                statusExplanation = "تم تسجيل طلبك بنجاح. سنقوم بمراجعة الدفع والمخزون قبل البدء في التجهيز.";
            }
            break;
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/orders/confirmation.css" asp-append-version="true" />
}

<div class="yq-confirm-page"
     data-yq-confirmation-page
     data-yq-clear-checkout-draft-id="@checkoutDraftIdToClear">

    <!-- TWO-COLUMN RESPONSIVE LAYOUT -->
    <div class="yq-confirm-layout">

        <!-- MAIN COLUMN (NATURAL MOBILE FLOW: 1.HERO -> 2.STATUS -> 3.PRODUCTS -> 4.DELIVERY -> 5.PAYMENT) -->
        <div class="yq-confirm-main">

            <!-- 1. COMPACT SUCCESS HERO -->
            <section class="yq-confirm-hero yq-confirm-card yq-glass" aria-labelledby="yqConfirmHeroTitle">
                <div class="yq-confirm-hero__head">
                    <span class="yq-confirm-hero__icon" aria-hidden="true">
                        <i class="bi bi-check-circle-fill"></i>
                    </span>
                    <div class="yq-confirm-hero__intro">
                        <h1 id="yqConfirmHeroTitle" class="yq-confirm-hero__title">تم استلام طلبك بنجاح</h1>
                        <p class="yq-confirm-hero__sub">شكراً لطلبك من ياقوت. تم تسجيل طلبك وإصدار بيانات المتابعة.</p>
                    </div>
                </div>

                <div class="yq-confirm-refs">
                    <div class="yq-confirm-ref-item">
                        <span class="yq-confirm-ref-label">رقم الطلب</span>
                        <strong class="yq-confirm-ref-value yq-confirm-order-id">
                            <bdi dir="ltr">#@Model.Id</bdi>
                        </strong>
                    </div>

                    <div class="yq-confirm-ref-item yq-confirm-ref-item--tracking">
                        <span class="yq-confirm-ref-label">رقم التتبع</span>
                        <div class="yq-confirm-tracking-wrap">
                            <strong class="yq-confirm-ref-value yq-confirm-tracking-code" id="yqTrackingNumber">
                                <bdi dir="ltr">@Model.Trackingnumber</bdi>
                            </strong>
                            <button type="button"
                                    class="yq-confirm-copy-btn"
                                    id="yqCopyTrackingBtn"
                                    aria-label="نسخ رقم التتبع"
                                    title="نسخ رقم التتبع">
                                <i class="bi bi-clipboard" aria-hidden="true"></i>
                                <span>نسخ</span>
                            </button>
                            <span class="visually-hidden"
                                  id="yqTrackingCopyStatus"
                                  role="status"
                                  aria-live="polite"></span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 2. TRUTHFUL STATUS & WHAT'S NEXT CARD -->
            @if (isCancelled)
            {
                <section class="yq-confirm-card yq-confirm-card--danger yq-glass" aria-label="حالة الطلب">
                    <div class="yq-confirm-status-head">
                        <div class="yq-confirm-status-title-wrap">
                            <i class="bi bi-exclamation-triangle-fill yq-confirm-danger-icon" aria-hidden="true"></i>
                            <h2 class="yq-confirm-card__title">حالة الطلب</h2>
                        </div>
                        <span class="yaqut-badge @statusBadgeClass">@statusBadgeLabel</span>
                    </div>
                    <p class="yq-confirm-status-desc">@statusExplanation</p>
                </section>
            }
            else
            {
                <section class="yq-confirm-card yq-glass" aria-label="حالة الطلب ومسار التنفيذ">
                    <div class="yq-confirm-status-head">
                        <div class="yq-confirm-status-title-wrap">
                            <i class="bi bi-info-circle yq-confirm-status-icon" aria-hidden="true"></i>
                            <h2 class="yq-confirm-card__title">حالة الطلب ومسار التنفيذ</h2>
                        </div>
                        <span class="yaqut-badge @statusBadgeClass">@statusBadgeLabel</span>
                    </div>
                    <p class="yq-confirm-status-desc">@statusExplanation</p>

                    <!-- COMPACT 3-STAGE NEXT-STEP PROGRESSION (NO HORIZONTAL OVERFLOW / NO WRAPPING CONNECTORS) -->
                    <div class="yq-confirm-next-steps" role="list">
                        <div class="yq-confirm-step is-complete" role="listitem">
                            <span class="yq-confirm-step__dot" aria-hidden="true">
                                <i class="bi bi-check-lg"></i>
                            </span>
                            <div class="yq-confirm-step__content">
                                <strong class="yq-confirm-step__name">استلام الطلب</strong>
                                <span class="yq-confirm-step__hint">تم تسجيل الطلب في النظام</span>
                            </div>
                        </div>

                        <div class="yq-confirm-step @(currentStatus == "Pending" ? "is-active" : isPaid ? "is-complete" : "")" role="listitem">
                            <span class="yq-confirm-step__dot" aria-hidden="true">
                                @if (currentStatus == "Pending")
                                {
                                    <i class="bi bi-hourglass-split"></i>
                                }
                                else if (isPaid)
                                {
                                    <i class="bi bi-check-lg"></i>
                                }
                                else
                                {
                                    <span>2</span>
                                }
                            </span>
                            <div class="yq-confirm-step__content">
                                <strong class="yq-confirm-step__name">مراجعة الدفع والمخزون</strong>
                                <span class="yq-confirm-step__hint">
                                    @(isConflictAwaitingDecision
                                        ? "بانتظار قرارك في تفاصيل الطلب"
                                        : isPaid
                                            ? "تم التحقق واعتماد الطلب"
                                            : "يجري التحقق من قِبل المتجر حالياً")
                                </span>
                            </div>
                        </div>

                        <div class="yq-confirm-step @(currentStatus is "Processed" or "Shipped" or "Delivered" ? "is-active" : "")" role="listitem">
                            <span class="yq-confirm-step__dot" aria-hidden="true">
                                @if (currentStatus == "Delivered")
                                {
                                    <i class="bi bi-check-lg"></i>
                                }
                                else if (currentStatus is "Processed" or "Shipped")
                                {
                                    <i class="bi bi-truck"></i>
                                }
                                else
                                {
                                    <span>3</span>
                                }
                            </span>
                            <div class="yq-confirm-step__content">
                                <strong class="yq-confirm-step__name">التجهيز والتوصيل</strong>
                                <span class="yq-confirm-step__hint">
                                    @(currentStatus is "Shipped" ? "الطلب في الطريق إليك" : currentStatus is "Processed" ? "قيد التجهيز والتغليف" : "يبدأ مباشرة بعد اعتماد الدفع")
                                </span>
                            </div>
                        </div>
                    </div>
                </section>
            }

            <!-- 3. PURCHASED PRODUCTS (PRESERVING SIZE / VARIANTS) -->
            <section class="yq-confirm-card yq-glass" aria-labelledby="yqConfirmProductsTitle">
                <div class="yq-confirm-card__header">
                    <h2 id="yqConfirmProductsTitle" class="yq-confirm-card__title">
                        <i class="bi bi-bag-check" aria-hidden="true"></i>
                        <span>المنتجات المطلوبة</span>
                    </h2>
                    <span class="yq-confirm-count-pill">@items.Sum(i => i.Quantity) قطع</span>
                </div>

                <div class="yq-confirm-products">
                    @foreach (var item in items)
                    {
                        var lineTotal = item.Quantity * item.Unitprice;
                        var sizeMl = item.RetailSizeMl ?? item.RetailPrice?.SizeMl;
                        var sizeText = sizeMl.HasValue && sizeMl.Value > 0 ? $"{sizeMl.Value} مل" : null;

                        <div class="yq-confirm-product">
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Productid" class="yq-confirm-product__media">
                                <img src="@(item.Product?.Imageurl ?? "/images/placeholder-product.svg")"
                                     alt="@(item.Product?.Name ?? "صورة المنتج")"
                                     data-yaqut-fallback="/images/placeholder-product.svg" />
                            </a>
                            <div class="yq-confirm-product__info">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Productid" class="yq-confirm-product__name">
                                    @item.Product?.Name
                                </a>
                                <div class="yq-confirm-product__meta-line">
                                    @if (!string.IsNullOrWhiteSpace(sizeText))
                                    {
                                        <span class="yq-confirm-variant-badge">@sizeText</span>
                                    }
                                    <span class="yq-confirm-product__qty">الكمية: @item.Quantity × <bdi>@(item.Unitprice.ToYaqutPrice())</bdi></span>
                                </div>
                            </div>
                            <span class="yq-confirm-product__total">
                                <bdi>@(lineTotal.ToYaqutPrice())</bdi>
                            </span>
                        </div>
                    }
                </div>
            </section>

            <!-- 4. DELIVERY INFORMATION -->
            <section class="yq-confirm-card yq-glass" aria-labelledby="yqConfirmDeliveryTitle">
                <h2 id="yqConfirmDeliveryTitle" class="yq-confirm-card__title">
                    <i class="bi bi-geo-alt" aria-hidden="true"></i>
                    <span>بيانات المستلم والتوصيل</span>
                </h2>
                <div class="yq-confirm-info-grid">
                    <div class="yq-confirm-info-item">
                        <span class="yq-confirm-info-label">اسم المستلم</span>
                        <span class="yq-confirm-info-value">@recipientName</span>
                    </div>
                    <div class="yq-confirm-info-item">
                        <span class="yq-confirm-info-label">رقم الجوال</span>
                        <span class="yq-confirm-info-value"><bdi dir="ltr">@customerPhone</bdi></span>
                    </div>
                    <div class="yq-confirm-info-item">
                        <span class="yq-confirm-info-label">تاريخ إنشاء الطلب</span>
                        <span class="yq-confirm-info-value"><bdi dir="ltr">@orderDate</bdi></span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(destinationText))
                    {
                        <div class="yq-confirm-info-item yq-confirm-info-item--full">
                            <span class="yq-confirm-info-label">عنوان التوصيل المسجل</span>
                            <span class="yq-confirm-info-value">@destinationText</span>
                        </div>
                    }
                </div>
            </section>

            <!-- 5. PAYMENT METHOD & VERIFICATION STATUS -->
            @await Html.PartialAsync("_PaymentMethodCard", new PaymentMethodCardViewModel(
                paymentPresentation,
                paymentStateDescription,
                paymentStateKind))

        </div>

        <!-- SIDEBAR (STICKY ON DESKTOP, FLOWS AFTER MAIN ON MOBILE) -->
        <aside class="yq-confirm-sidebar">

            <!-- 6. ORDER SUMMARY CARD -->
            <div class="yq-confirm-card yq-confirm-summary yq-glass" aria-labelledby="yqConfirmSummaryTitle">
                <h2 id="yqConfirmSummaryTitle" class="yq-confirm-summary__title">ملخص الطلب</h2>

                <div class="yq-confirm-summary__row">
                    <span class="yq-confirm-summary__label">عدد المنتجات</span>
                    <span class="yq-confirm-summary__value">@items.Sum(i => i.Quantity)</span>
                </div>
                <div class="yq-confirm-summary__row">
                    <span class="yq-confirm-summary__label">الشحن</span>
                    <span class="yq-confirm-summary__value">
                        @await Html.PartialAsync("_FreeShipping")
                    </span>
                </div>

                <div class="yq-confirm-summary__divider"></div>

                <div class="yq-confirm-summary__row yq-confirm-summary__row--total">
                    <span class="yq-confirm-summary__total-label">الإجمالي النهائي</span>
                    <span class="yq-confirm-summary__total-value">
                        <bdi>@(Model.Totalamount.ToYaqutPrice())</bdi>
                    </span>
                </div>

                <p class="yq-confirm-summary__note">
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                    <span>معاملتك مسجلة بأمان وسيتم تأكيد الشحن والتوصيل عبر رقم الجوال.</span>
                </p>
            </div>

            <!-- 7. PRIMARY, SECONDARY & TERTIARY ACTIONS -->
            <div class="yq-confirm-actions" role="group" aria-label="خيارات المتابعة والتنقل">
                <!-- PRIMARY: VIEW ORDER DETAILS (PERMANENT TRACKING DESTINATION) -->
                <a asp-controller="Orders"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="yq-confirm-btn yq-confirm-btn--primary">
                    <i class="bi bi-receipt" aria-hidden="true"></i>
                    <span>عرض تفاصيل الطلب</span>
                </a>

                <!-- SECONDARY: CONTINUE SHOPPING -->
                <a asp-controller="Products"
                   asp-action="Index"
                   class="yq-confirm-btn yq-confirm-btn--secondary">
                    <i class="bi bi-bag-plus" aria-hidden="true"></i>
                    <span>متابعة التسوق</span>
                </a>

                <!-- TERTIARY: ORDERS LIST -->
                <a asp-controller="Orders"
                   asp-action="Index"
                   class="yq-confirm-btn yq-confirm-btn--ghost">
                    <i class="bi bi-clock-history" aria-hidden="true"></i>
                    <span>عرض جميع طلباتي</span>
                </a>
            </div>

            <!-- 8. OPTIONAL WHATSAPP SUPPORT BOX -->
            @await Html.PartialAsync("_PostOrderWhatsApp", customerOrderWhatsAppUrl)

        </aside>

    </div>
</div>

@section Scripts {
    <script src="~/js/orders/confirmation.js" asp-append-version="true"></script>
}
