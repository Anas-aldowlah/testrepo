@model YAGOT_2._0.Models.Order
@using System.Security.Claims
@using YAGOT_2._0.Services
@inject DealingAPI DealingApiService
@{
    ViewData["Title"] = "تأكيد الطلب";
    var items = Model.Orderitems?.ToList() ?? new List<YAGOT_2._0.Models.Orderitem>();
    const decimal freeShippingThreshold = 500;
    var qualifiesForFreeShipping = Model.Totalamount >= freeShippingThreshold;

    var customerName = Model.User?.Name ?? User.Identity?.Name;
    var customerPhone = Model.User?.Phone ?? User.FindFirst(ClaimTypes.MobilePhone)?.Value;
    var checkoutDraftIdToClear = ViewData["CheckoutDraftIdToClear"] as string ?? string.Empty;

    var statusSteps = new[] { "Pending", "Processed", "Shipped", "Delivered" };
    var currentStepIndex = Array.IndexOf(statusSteps, Model.Status);
    if (currentStepIndex < 0) currentStepIndex = 0;

    var stepLabels = new Dictionary<string, string>
    {
        ["Pending"] = "تم استلام الطلب",
        ["Processed"] = "قيد التحضير",
        ["Shipped"] = "تم الشحن",
        ["Delivered"] = "تم التوصيل"

    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/orders/confirmation.css" asp-append-version="true" />
}

<div class="yq-confirm-page"
     data-yq-confirmation-page
     data-yq-clear-checkout-draft-id="@checkoutDraftIdToClear">

    <!-- SUCCESS HERO -->
    <section class="yq-confirm-hero yq-reveal">
        <div class="yq-confirm-hero__icon">
            <i class="bi bi-check-lg"></i>
        </div>
        <h1 class="yq-confirm-hero__title">تم تأكيد طلبك بنجاح!</h1>
        <p class="yq-confirm-hero__sub">شكراً لثقتك في ياقوت. تم استلام طلبك وسيتم التواصل معك قريباً.</p>

        <div class="yq-confirm-tracking">
            <span class="yq-confirm-tracking__label">رقم التتبع</span>
            <div class="yq-confirm-tracking__value">
                <span id="yqTrackingNumber">@Model.Trackingnumber</span>
                <button type="button" class="yq-confirm-tracking__copy" id="yqCopyTrackingBtn" aria-label="نسخ رقم التتبع">
                    <i class="bi bi-clipboard"></i>
                </button>
            </div>
        </div>
    </section>

    <!-- STATUS TIMELINE -->
    <section class="yq-confirm-timeline yq-glass yq-reveal">
        @for (var i = 0; i < statusSteps.Length; i++)
        {
            var isDone = i < currentStepIndex;
            var isActive = i == currentStepIndex;
            var isCancelled = Model.Status is "Cancelled" or "Refunded";
            <div class="yq-timeline-step @(isDone ? "is-done" : "") @(isActive && !isCancelled ? "is-active" : "")">
                <span class="yq-timeline-step__dot">
                    @if (isDone)
                    {
                        <i class="bi bi-check-lg"></i>
                    }
                    else
                    {
                        @(i + 1)
                    }
                </span>
                <span class="yq-timeline-step__label">@stepLabels[statusSteps[i]]</span>
            </div>
            @if (i < statusSteps.Length - 1)
            {
                <div class="yq-timeline-connector @(isDone ? "is-done" : "")"></div>
            }
        }
    </section>

    @if (Model.Status == "Cancelled")
    {
        <div class="yaqut-alert yaqut-alert--danger yq-reveal">
            <i class="bi bi-exclamation-circle"></i> تم إلغاء هذا الطلب.
        </div>
    }

    <div class="yq-confirm-layout">

        <!-- LEFT: DETAILS -->
        <div class="yq-confirm-details yq-reveal">

            <!-- CUSTOMER + DELIVERY -->
            <section class="yq-confirm-card yq-glass">
                <h2 class="yq-confirm-card__title"><i class="bi bi-person"></i> معلومات العميل والتوصيل</h2>
                <div class="yq-confirm-info-grid">
                    <div>
                        <span class="yq-confirm-info-label">الاسم</span>
                        <span class="yq-confirm-info-value">@customerName</span>
                    </div>
                    <div>
                        <span class="yq-confirm-info-label">رقم الجوال</span>
                        <span class="yq-confirm-info-value">@(DealingApiService.DecryptPhone(customerPhone) ?? "-")</span>
                    </div>
                    <div>
                        <span class="yq-confirm-info-label">تاريخ الطلب</span>
                        <span class="yq-confirm-info-value">@(Model.Orderdate.HasValue? Model.Orderdate.Value.ToString("dd/MM/yyyy HH:mm") : "-")</span>
                    </div>
                    <div>
                        <span class="yq-confirm-info-label">مدة التوصيل المتوقعة</span>
                        <span class="yq-confirm-info-value">2-3 أيام عمل</span>
                    </div>
                </div>
            </section>

            <!-- PAYMENT -->
            <section class="yq-confirm-card yq-glass">
                <h2 class="yq-confirm-card__title"><i class="bi bi-wallet2"></i> طريقة الدفع</h2>
                <div class="yq-confirm-payment">
                    <span class="yq-confirm-payment__icon"><i class="bi bi-cash-coin"></i></span>
                    <div>
                        <strong>الدفع عند الاستلام</strong>
                        <p>سيتم تحصيل المبلغ نقداً عند استلام طلبك</p>
                    </div>
                </div>
            </section>

            <!-- PURCHASED PRODUCTS -->
            <section class="yq-confirm-card yq-glass">
                <h2 class="yq-confirm-card__title"><i class="bi bi-bag-check"></i> المنتجات المطلوبة</h2>
                <div class="yq-confirm-products">
                    @foreach (var item in items)
                    {
                        var lineTotal = item.Quantity * item.Unitprice;
                        <div class="yq-confirm-product">
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Productid" class="yq-confirm-product__media">
                                <img src="@(item.Product?.Imageurl ?? "/images/placeholder-product.svg")"
                                     alt="@item.Product?.Name"
                                     data-yaqut-fallback="/images/placeholder-product.svg" />
                            </a>
                            <div class="yq-confirm-product__info">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Productid" class="yq-confirm-product__name">
                                    @item.Product?.Name
                                </a>
                                <span class="yq-confirm-product__meta">الكمية: @item.Quantity × @item.Unitprice.ToString("N0") ر.س</span>
                            </div>
                            <span class="yq-confirm-product__total">@lineTotal.ToString("N0") ر.س</span>
                        </div>
                    }
                </div>
            </section>
        </div>

        <!-- RIGHT: ORDER SUMMARY -->
        <aside class="yq-confirm-summary yq-glass yq-reveal">
            <h2 class="yq-confirm-summary__title">ملخص الطلب</h2>

            <div class="yq-confirm-summary__row">
                <span>عدد المنتجات</span>
                <span>@items.Sum(i => i.Quantity)</span>
            </div>
            <div class="yq-confirm-summary__row">
                <span>الشحن</span>
                @if (qualifiesForFreeShipping)
                {
                    <span class="yq-confirm-summary__free">مجاني</span>
                }
                else
                {
                    <span class="yq-confirm-summary__tbd">يُحدد عند التوصيل</span>
                }
            </div>

            <div class="yq-confirm-summary__divider"></div>

            <div class="yq-confirm-summary__row yq-confirm-summary__row--total">
                <span>الإجمالي</span>
                <span>@Model.Totalamount.ToString("N0") <small>ر.س</small></span>
            </div>

                @if (TempData["WhatsAppUrl"] != null)
                {
                    <button type="button" id="yqOpenWaModalBtn" class="btn-yaqut-gold yq-confirm-summary__btn" style="background: #25D366; border-color: #25D366; color: white;">
                        <i class="bi bi-whatsapp"></i> إرسال الطلب عبر الواتساب
                    </button>
                }
                <a asp-controller="Orders" asp-action="Index" class="btn-yaqut-gold yq-confirm-summary__btn">
                    <i class="bi bi-receipt"></i> عرض طلباتي
                </a>
                <a asp-controller="Products" asp-action="Index" class="btn-yaqut-outline yq-confirm-summary__btn">
                    <i class="bi bi-bag-plus"></i> متابعة التسوق
                </a>
            </div>

            <p class="yq-confirm-summary__note">
                <i class="bi bi-envelope-check"></i>
                سيتم التواصل معك عبر رقم الجوال المسجل لتأكيد التوصيل
            </p>
        </aside>
    </div>
</div>

@if (TempData["WhatsAppUrl"] != null)
{
    var waUrl = TempData["WhatsAppUrl"]?.ToString();
    <!-- WHATSAPP OPTIONAL MODAL -->
    <div class="yaqut-modal yq-wa-modal" id="waOptionalModal" style="display:flex; position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:9999; align-items:center; justify-content:center; backdrop-filter:blur(4px); opacity:0; pointer-events:none; transition:opacity 0.3s ease;">
        <div class="yaqut-modal-content" style="background:var(--yq-bg, #111); border:1px solid rgba(201,162,75,0.3); border-radius:24px; padding:2rem; width:90%; max-width:400px; text-align:center; transform:translateY(20px); transition:transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);">
            <div style="width:70px; height:70px; background:rgba(37,211,102,0.15); border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 1.2rem; color:#25D366; font-size:2rem;">
                <i class="bi bi-whatsapp"></i>
            </div>
            <h3 style="font-family:var(--yq-font-display); font-size:1.4rem; font-weight:700; margin-bottom:0.75rem; color:var(--yq-gold);">تأكيد سريع للطلب!</h3>
            <p style="font-size:0.9rem; color:var(--yq-text-muted, #aaa); line-height:1.6; margin-bottom:1.5rem;">
                تم تسجيل طلبك بنجاح في النظام.<br />
                لتسريع عملية التجهيز والتوصيل، نوصي بإرسال نسخة من الطلب لإدارة المتجر عبر الواتساب.
            </p>
            <div style="display:flex; flex-direction:column; gap:0.75rem;">
                <a href="@waUrl" onclick="closeWaModal()" style="display:flex; align-items:center; justify-content:center; gap:0.5rem; background:#25D366; color:#fff; text-decoration:none; padding:0.85rem; border-radius:12px; font-weight:700; font-size:0.95rem;">
                    <i class="bi bi-send-fill"></i> إرسال عبر الواتساب الآن
                </a>
                <button type="button" onclick="closeWaModal()" style="background:transparent; border:1px solid rgba(255,255,255,0.1); color:var(--yq-text, #fff); padding:0.85rem; border-radius:12px; font-weight:600; font-size:0.9rem; cursor:pointer;">
                    تخطي والاكتفاء بالطلب
                </button>
            </div>
        </div>
    </div>

    <script>
        function openWaModal() {
            const modal = document.getElementById('waOptionalModal');
            if(modal) {
                modal.style.opacity = '1';
                modal.style.pointerEvents = 'auto';
                modal.querySelector('.yaqut-modal-content').style.transform = 'translateY(0)';
            }
        }
        function closeWaModal() {
            const modal = document.getElementById('waOptionalModal');
            if(modal) {
                modal.style.opacity = '0';
                modal.style.pointerEvents = 'none';
                modal.querySelector('.yaqut-modal-content').style.transform = 'translateY(20px)';
            }
        }
        // Show automatically after 1 second
        setTimeout(openWaModal, 1000);

        // Bind the manual button
        document.getElementById('yqOpenWaModalBtn').addEventListener('click', openWaModal);
    </script>
}

@section Scripts {
    <script src="~/js/orders/confirmation.js" asp-append-version="true"></script>
}
