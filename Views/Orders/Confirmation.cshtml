@model YAGOT_2._0.Models.Order
@using System.Security.Claims
@using YAGOT_2._0.Services
@inject DealingAPI DealingApiService
@{
    ViewData["Title"] = "تأكيد الطلب";
    var items = Model.Orderitems?.ToList() ?? new List<YAGOT_2._0.Models.Orderitem>();

    var customerName = Model.User?.Name ?? User.Identity?.Name;
    var customerPhone = Model.User?.Phone ?? User.FindFirst(ClaimTypes.MobilePhone)?.Value;
    var checkoutDraftIdToClear = ViewData["CheckoutDraftIdToClear"] as string ?? string.Empty;
    var customerOrderWhatsAppUrl = ViewData["CustomerOrderWhatsAppUrl"] as string;
    var paymentPresentations = ViewData["PaymentMethodPresentations"] as IReadOnlyDictionary<string, PaymentMethodPresentation>;
    var paymentPresentation = !string.IsNullOrWhiteSpace(Model.Paymentmethod) &&
        paymentPresentations?.TryGetValue(Model.Paymentmethod, out var configuredPayment) == true
            ? configuredPayment
            : new PaymentMethodPresentation(
                Model.Paymentmethod ?? string.Empty,
                string.IsNullOrWhiteSpace(Model.Paymentmethod) ? "طريقة دفع غير محددة" : "طريقة دفع مسجلة سابقاً",
                string.Empty,
                string.Empty,
                null,
                false);
    var isConflictAwaitingDecision = Model.Workflowstate == OrderWorkflowStates.ConflictAwaitingDecision;
    var conflictHasPaymentReview = Model.Paymentreviewedat.HasValue && Model.Paymentreviewedbyuserid.HasValue;
    var paymentStateDescription = isConflictAwaitingDecision
        ? conflictHasPaymentReview
            ? "مراجعة الدفع معلّقة بانتظار قرارك بشأن الكميات."
            : "المتجر يراجع الدفع الآن."
        : Model.Paymentstatus == "Paid"
            ? "تم التحقق من الدفع."
            : "الدفع بانتظار مراجعة المتجر.";

    var statusSteps = new[] { "Pending", "Paid", "Processed", "Shipped", "Delivered" };
    var currentStepIndex = Array.IndexOf(statusSteps, Model.Status);
    if (currentStepIndex < 0) currentStepIndex = 0;

    var stepLabels = new Dictionary<string, string>
    {
        ["Pending"] = "تم استلام الطلب",
        ["Paid"] = "تم الدفع",
        ["Processed"] = "قيد التحضير",
        ["Shipped"] = "تم الشحن",
        ["Delivered"] = "تم التوصيل"

    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/orders/confirmation.css" asp-append-version="true" />
}

<div class="yq-confirm-page"
     data-yq-confirmation-page
     data-yq-clear-checkout-draft-id="@checkoutDraftIdToClear">

    <!-- SUCCESS HERO -->
    <section class="yq-confirm-hero yq-reveal">
        @await Html.PartialAsync("_PostOrderWhatsApp", customerOrderWhatsAppUrl)

        <div class="yq-confirm-tracking">
            <span class="yq-confirm-tracking__label">رقم التتبع</span>
            <div class="yq-confirm-tracking__value">
                <span id="yqTrackingNumber">@Model.Trackingnumber</span>
                <button type="button" class="yq-confirm-tracking__copy" id="yqCopyTrackingBtn" aria-label="نسخ رقم التتبع">
                    <i class="bi bi-clipboard"></i>
                </button>
            </div>
        </div>
    </section>

    <!-- STATUS TIMELINE -->
    <section class="yq-confirm-timeline yq-glass yq-reveal">
        @for (var i = 0; i < statusSteps.Length; i++)
        {
            var isDone = i < currentStepIndex;
            var isActive = i == currentStepIndex;
            var isCancelled = Model.Status is "Cancelled" or "Refunded";
            <div class="yq-timeline-step @(isDone ? "is-done" : "") @(isActive && !isCancelled ? "is-active" : "")">
                <span class="yq-timeline-step__dot">
                    @if (isDone)
                    {
                        <i class="bi bi-check-lg"></i>
                    }
                    else
                    {
                        @(i + 1)
                    }
                </span>
                <span class="yq-timeline-step__label">@stepLabels[statusSteps[i]]</span>
            </div>
            @if (i < statusSteps.Length - 1)
            {
                <div class="yq-timeline-connector @(isDone ? "is-done" : "")"></div>
            }
        }
    </section>

    @if (Model.Status == "Cancelled")
    {
        <div class="yaqut-alert yaqut-alert--danger yq-reveal">
            <i class="bi bi-exclamation-circle"></i> تم إلغاء هذا الطلب.
        </div>
    }

    <div class="yq-confirm-layout">

        <!-- LEFT: DETAILS -->
        <div class="yq-confirm-details yq-reveal">

            <!-- CUSTOMER + DELIVERY -->
            <section class="yq-confirm-card yq-glass">
                <h2 class="yq-confirm-card__title"><i class="bi bi-person"></i> معلومات العميل والتوصيل</h2>
                <div class="yq-confirm-info-grid">
                    <div>
                        <span class="yq-confirm-info-label">الاسم</span>
                        <span class="yq-confirm-info-value">@customerName</span>
                    </div>
                    <div>
                        <span class="yq-confirm-info-label">رقم الجوال</span>
                        <span class="yq-confirm-info-value">@(DealingApiService.DecryptPhone(customerPhone) ?? "-")</span>
                    </div>
                    <div>
                        <span class="yq-confirm-info-label">تاريخ الطلب</span>
                        <span class="yq-confirm-info-value">@(Model.Orderdate.HasValue? Model.Orderdate.Value.ToString("dd/MM/yyyy HH:mm") : "-")</span>
                    </div>
                    <div>
                        <span class="yq-confirm-info-label">مدة التوصيل المتوقعة</span>
                        <span class="yq-confirm-info-value">2-3 أيام عمل</span>
                    </div>
                </div>
            </section>

            <!-- PAYMENT -->
            @await Html.PartialAsync("_PaymentMethodCard", new PaymentMethodCardViewModel(
                paymentPresentation,
                paymentStateDescription,
                Model.Paymentstatus == "Paid" ? "verified" : isConflictAwaitingDecision ? "review" : "pending"))

            <!-- PURCHASED PRODUCTS -->
            <section class="yq-confirm-card yq-glass">
                <h2 class="yq-confirm-card__title"><i class="bi bi-bag-check"></i> المنتجات المطلوبة</h2>
                <div class="yq-confirm-products">
                    @foreach (var item in items)
                    {
                        var lineTotal = item.Quantity * item.Unitprice;
                        <div class="yq-confirm-product">
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Productid" class="yq-confirm-product__media">
                                <img src="@(item.Product?.Imageurl ?? "/images/placeholder-product.svg")"
                                     alt="@item.Product?.Name"
                                     data-yaqut-fallback="/images/placeholder-product.svg" />
                            </a>
                            <div class="yq-confirm-product__info">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Productid" class="yq-confirm-product__name">
                                    @item.Product?.Name
                                </a>
                                <span class="yq-confirm-product__meta">الكمية: @item.Quantity × @item.Unitprice.ToString("N0") ر.س</span>
                            </div>
                            <span class="yq-confirm-product__total">@lineTotal.ToString("N0") ر.س</span>
                        </div>
                    }
                </div>
            </section>
        </div>

        <!-- RIGHT: ORDER SUMMARY -->
        <aside class="yq-confirm-summary yq-glass yq-reveal">
            <h2 class="yq-confirm-summary__title">ملخص الطلب</h2>

            <div class="yq-confirm-summary__row">
                <span>عدد المنتجات</span>
                <span>@items.Sum(i => i.Quantity)</span>
            </div>
            <div class="yq-confirm-summary__row">
                <span>الشحن</span>
                @await Html.PartialAsync("_FreeShipping")
            </div>

            <div class="yq-confirm-summary__divider"></div>

            <div class="yq-confirm-summary__row yq-confirm-summary__row--total">
                <span>الإجمالي</span>
                <span>@Model.Totalamount.ToString("N0") <small>ر.س</small></span>
            </div>

            <p class="yq-confirm-summary__note">
                <i class="bi bi-envelope-check"></i>
                سيتم التواصل معك عبر رقم الجوال المسجل لتأكيد التوصيل
            </p>
        </aside>
    </div>
</div>

@section Scripts {
    <script src="~/js/orders/confirmation.js" asp-append-version="true"></script>
}
