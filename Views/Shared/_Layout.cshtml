<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="ياقوت للعطور الفاخرة - اكتشف منتجاتنا من أرقى العطور الشرقية والغربية في المملكة." />
    <title>@ViewData["Title"] - ياقوت</title>
    <link rel="icon" type="image/svg+xml" href="~/images/شعار ياقوت.svg" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/images/yaqut-logo.png" asp-append-version="true" />
    <link rel="manifest" href="~/site.webmanifest" asp-append-version="true" />
    <meta name="theme-color" content="#d4af37" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/yaqut-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <script src="~/js/yaqut-main.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a href="#yaqutMain" class="yq-skip-link">تجاوز إلى المحتوى</a>

    <partial name="_StorefrontHeader" />

    @{
        var isHomePage = ViewData["IsHomePage"] as bool? == true;
        var mainClass = isHomePage ? "yaqut-main-full" : "yaqut-container";
    }
    <main class="@mainClass" id="yaqutMain" role="main">
        @RenderBody()
    </main>

    <partial name="_StorefrontFooter" />
    <partial name="_CartDrawer" />

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/layout.js" asp-append-version="true"></script>
    <script src="~/js/cart-drawer.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
