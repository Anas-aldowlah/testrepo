<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="ياقوت للعطور الفاخرة - اكتشف مجموعة من أرقى العطور الشرقية والغربية في المملكة." />
    <title>@ViewData["Title"] - ياقوت</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/yaqut-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <script src="~/js/yaqut-main.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a href="#yaqutMain" class="yq-skip-link">تجاوز إلى المحتوى</a>

    <!-- Announcement Bar -->
    <div class="yaqut-announce">
        <i class="bi bi-gem"></i>
        شحن مجاني للطلبات فوق 500 ر.س — ياقوت للعطور الفاخرة
    </div>

    <!-- Header -->
    <header class="yaqut-header" id="yaqutHeader">
        <div class="yaqut-header__inner">
            <button type="button" class="yaqut-menu-toggle" aria-label="القائمة" aria-controls="yaqutNav" aria-expanded="false" onclick="toggleNav()">
                <i class="bi bi-list"></i>
            </button>

            <a class="yaqut-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="ياقوت - الصفحة الرئيسية">
                <span class="yaqut-logo-wrap yaqut-logo-wrap--header">
                    <img src="~/images/yaqut-logo.png" alt="ياقوت YAQUT" class="yaqut-logo" />
                </span>
            </a>

            <nav class="yaqut-nav" id="yaqutNav" aria-label="التنقل الرئيسي">
                <ul>
                    <li><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i><span>الرئيسية</span></a></li>
                    <li><a asp-controller="Products" asp-action="Index"><i class="bi bi-collection"></i><span>المجموعة</span></a></li>
                    <li><a asp-controller="Orders" asp-action="Index"><i class="bi bi-receipt"></i><span>طلباتي</span></a></li>
                </ul>
            </nav>

            <form asp-controller="Products" asp-action="Index" method="get" class="yaqut-search" role="search">
                <i class="bi bi-search yaqut-search__icon" aria-hidden="true"></i>
                <input type="search" name="search" id="yaqutSearchInput" class="yaqut-search__input"
                       placeholder="ابحث عن عطرك المفضل..." value="@Context.Request.Query["search"]"
                       autocomplete="off" aria-label="بحث عن منتج" />
                <button type="submit" class="yaqut-search__btn" aria-label="بحث">
                    <i class="bi bi-arrow-left"></i>
                </button>
            </form>

            <div class="yaqut-header__actions">
                <div class="yaqut-theme-pill" role="group" aria-label="تبديل وضع الألوان">
                    <button type="button" class="yaqut-theme-pill__btn" data-theme-opt="light" aria-label="الوضع الصباحي" title="وضع النهار">
                        <i class="bi bi-sun"></i>
                    </button>
                    <button type="button" class="yaqut-theme-pill__btn" data-theme-opt="dark" aria-label="الوضع المسائي" title="وضع الليل">
                        <i class="bi bi-moon-stars"></i>
                    </button>
                </div>

                <a asp-controller="Cart" asp-action="Index" class="yaqut-icon-btn" aria-label="سلة المشتريات" title="السلة">
                    <i class="bi bi-bag"></i>
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-yaqut-gold btn-sm d-none d-lg-inline-flex">الإدارة</a>
                    }
                    <span class="yaqut-user-chip d-none d-md-inline-flex">
                        <i class="bi bi-person-circle"></i> @User.Identity.Name
                    </span>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-yaqut-outline btn-sm yaqut-logout-btn">
                        <i class="bi bi-box-arrow-right"></i>
                        <span class="d-none d-md-inline">خروج</span>
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Auth" class="btn-yaqut-outline btn-sm yaqut-login-btn">
                        <i class="bi bi-person"></i><span class="d-none d-md-inline">دخول</span>
                    </a>
                }
            </div>
        </div>
    </header>

    <div class="yaqut-container" id="yaqutMain">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="yaqut-footer">
        <div class="yaqut-footer__inner">
            <div class="yaqut-footer__grid">
                <div class="yaqut-footer__col yaqut-footer__col--brand">
                    <span class="yaqut-logo-wrap yaqut-logo-wrap--header">
                        <img src="~/images/yaqut-logo.png" alt="ياقوت YAQUT" class="yaqut-logo" />
                    </span>
                    <p class="yaqut-footer__tagline">حيث تولد الروائح كقطع فنية خالدة</p>
                    <div class="yaqut-footer__social" aria-label="تابعنا على وسائل التواصل الاجتماعي">
                        <a href="#" aria-label="إنستغرام"><i class="bi bi-instagram"></i></a>
                        <a href="#" aria-label="تويتر"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" aria-label="تيك توك"><i class="bi bi-tiktok"></i></a>
                        <a href="#" aria-label="سناب شات"><i class="bi bi-snapchat"></i></a>
                    </div>
                </div>

                <nav class="yaqut-footer__col" aria-label="روابط سريعة">
                    <h3 class="yaqut-footer__col-title">روابط سريعة</h3>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                        <li><a asp-controller="Products" asp-action="Index">المجموعة الكاملة</a></li>
                        <li><a asp-controller="Cart" asp-action="Index">سلة المشتريات</a></li>
                        <li><a asp-controller="Orders" asp-action="Index">طلباتي</a></li>
                    </ul>
                </nav>

                <nav class="yaqut-footer__col" aria-label="الدعم والحساب">
                    <h3 class="yaqut-footer__col-title">الدعم</h3>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Privacy">سياسة الخصوصية</a></li>
                        <li><a asp-controller="Account" asp-action="Auth">تسجيل الدخول / حساب جديد</a></li>
                    </ul>
                </nav>
            </div>

            <div class="yaqut-footer__bottom">
                <p class="yaqut-footer__copy">&copy; @DateTime.Now.Year ياقوت للعطور الفاخرة. جميع الحقوق محفوظة.</p>
                <div class="yaqut-footer__badges">
                    <span><i class="bi bi-shield-lock"></i> تسوق آمن</span>
                    <span><i class="bi bi-truck"></i> شحن سريع</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/layout.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>