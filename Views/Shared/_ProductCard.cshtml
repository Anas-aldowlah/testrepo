@model YAGOT_2._0.Models.Product
@using YAGOT_2._0.Services
@using YAGOT_2._0.Services.Promotions
@using YAGOT_2._0.Extensions
@inject YAGOT_2._0.Core.Capabilities.ICapabilityEvaluator CapabilityEvaluator
@{
    var showQuickAdd = (ViewData["ShowQuickAdd"] as bool? ?? true) &&
        CapabilityEvaluator.IsFeatureEnabled(YAGOT_2._0.Core.Capabilities.CapabilityFeatureCodes.CartProductManagement);
    var isEager = ViewData["IsEager"] as bool? ?? false;
    var categoryName = Model.Category?.Name ?? string.Empty;
    var isAvailable = ProductRetailAvailability.IsSellable(Model);
    var isBaseOptionAvailable = ProductRetailAvailability.IsBaseOptionSellable(Model);
    var isRetailAvailable = ProductRetailAvailability.IsAvailable(Model);
    var isNew = Model.Createdat.HasValue && Model.Createdat.Value >= DateTime.UtcNow.AddDays(-30);
    var statusId = $"yq-ps-{Model.Id}-{Guid.NewGuid():N}";
    var utcNow = DateTimeOffset.UtcNow;
    var isPromoActive = Model.HasPromotion &&
                        (!Model.PromotionStartDate.HasValue || Model.PromotionStartDate.Value <= utcNow) &&
                        (!Model.PromotionEndDate.HasValue || Model.PromotionEndDate.Value > utcNow);

    var rawImage = (isPromoActive && !string.IsNullOrWhiteSpace(Model.PromotionBannerImage))
        ? Model.PromotionBannerImage
        : Model.Imageurl;

    var imageUrl = string.IsNullOrWhiteSpace(rawImage)
        ? Url.Content("~/images/placeholder-product.svg")
        : (rawImage.StartsWith("http", StringComparison.OrdinalIgnoreCase) || rawImage.StartsWith("/")
            ? rawImage
            : Url.Content("~/" + rawImage.TrimStart('/')));
}

<article class="yq-pcard @(isPromoActive ? "yq-pcard--promo" : string.Empty) @(isAvailable ? string.Empty : "yq-pcard--out")"
         dir="rtl"
         data-yaqut-product
         data-yq-product-card
         data-yq-availability="@(isAvailable ? "in-stock" : "out-of-stock")"
         data-retail="@isRetailAvailable.ToString().ToLowerInvariant()"
         data-product-id="@Model.Id"
         data-product-name="@Model.Name"
         data-name="@Model.Name.ToLowerInvariant()"
         data-family="@categoryName"
         data-price="@Model.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
         data-concentration="@(Model.Name.Contains("EDP", StringComparison.OrdinalIgnoreCase) || (Model.Description?.Contains("EDP", StringComparison.OrdinalIgnoreCase) ?? false) ? "edp" : Model.Name.Contains("EDT", StringComparison.OrdinalIgnoreCase) || (Model.Description?.Contains("EDT", StringComparison.OrdinalIgnoreCase) ?? false) ? "edt" : Model.Name.Contains("Parfum", StringComparison.OrdinalIgnoreCase) ? "parfum" : "all")">

    <div class="yq-pcard__media">
        <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id"
           class="yq-pcard__img-wrap" aria-label="عرض @Model.Name">
            <img src="@imageUrl" alt="@Model.Name" class="yq-pcard__img" loading="@(isEager ? "eager" : "lazy")" decoding="async"
                 data-yaqut-fallback="/images/placeholder-product.svg" />
        </a>

        @if (isPromoActive)
        {
            <div class="yq-pcard__promo-badges">
                <span class="yq-promo-badge yq-promo-badge--flame">
                    @if (Model.PromotionType == "Percentage" || Model.PromotionType == "PercentageDiscount")
                    {
                        var pct = Model.DiscountPercentage ?? (Model.OriginalPrice > 0 ? Math.Round((Model.DiscountAmount / Model.OriginalPrice) * 100m, 0) : (Model.PromoDiscountValue ?? 0m));
                        <i class="bi bi-lightning-charge-fill"></i>
                        <span>خصم @pct.ToString("0.##")%</span>
                    }
                    else if (Model.PromotionType == "FixedAmount" || Model.PromotionType == "FixedDiscount")
                    {
                        <i class="bi bi-tag-fill"></i>
                        <span>وفر @(Model.DiscountAmount.ToYaqutPrice())</span>
                    }
                    else if (Model.PromotionType == "BuyXGetY")
                    {
                        var bQty = Model.BuyQuantity.HasValue && Model.BuyQuantity.Value > 0 ? Model.BuyQuantity.Value : 2;
                        var fQty = Model.FreeQuantity.HasValue && Model.FreeQuantity.Value > 0 ? Model.FreeQuantity.Value : 1;
                        <i class="bi bi-gift-fill"></i>
                        <span>اشتر @bQty احصل @fQty مجاناً</span>
                    }
                    else if (Model.PromotionType == "QuantityPrice")
                    {
                        <i class="bi bi-box-seam"></i>
                        <span>عرض كمية خاص</span>
                    }
                    else
                    {
                        <i class="bi bi-stars"></i>
                        <span>عرض حصري</span>
                    }
                </span>

                @if (!string.IsNullOrEmpty(Model.PromotionTitle))
                {
                    <span class="yq-promo-badge yq-promo-badge--gold" title="@Model.PromotionTitle">
                        <i class="bi bi-star-fill"></i> @Model.PromotionTitle
                    </span>
                }
            </div>
        }
        else if (!isAvailable)
        {
            <span class="yq-pcard__badge yq-pcard__badge--off">
                <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" class="bi bi-bag-x" viewBox="0 0 16 16" aria-hidden="true">
                    <path fill-rule="evenodd" d="M6.146 8.146a.5.5 0 0 1 .708 0L8 9.293l1.146-1.147a.5.5 0 1 1 .708.708L8.707 10l1.147 1.146a.5.5 0 0 1-.708.708L8 10.707l-1.146 1.147a.5.5 0 0 1-.708-.708L7.293 10 6.146 8.854a.5.5 0 0 1 0-.708"/>
                    <path d="M8 1a2.5 2.5 0 0 0-2.5 2.5V4h5v-.5A2.5 2.5 0 0 0 8 1m3.5 3v-.5a3.5 3.5 0 1 0-7 0V4H1v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4zM2 5h12v9a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1z"/>
                </svg>
                غير متوفر
            </span>
        }
        else
        {
            <span class="yq-pcard__badge yq-pcard__badge--on">
                <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" class="bi bi-bag-check" viewBox="0 0 16 16" aria-hidden="true">
                    <path fill-rule="evenodd" d="M10.854 8.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 0 1 .708-.708L7.5 10.793l2.646-2.647a.5.5 0 0 1 .708 0"/>
                    <path d="M8 1a2.5 2.5 0 0 0-2.5 2.5V4h5v-.5A2.5 2.5 0 0 0 8 1m3.5 3v-.5a3.5 3.5 0 1 0-7 0V4H1v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4zM2 5h12v9a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1z"/>
                </svg>
                متوفر
            </span>
        }
    </div>

    <div class="yq-pcard__body">
        <h3 class="yq-pcard__name">
            <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id" class="yq-pcard__name-link">@Model.Name</a>
        </h3>

        @if (isPromoActive && Model.PromotionEndDate.HasValue)
        {
            <div class="yq-promo-timer yq-promo-timer--tiles mb-2" data-yq-timer-tiles="true" data-yq-countdown="@PromotionTime.ToUtcIso8601(Model.PromotionEndDate.Value)" data-yq-startdate="@(Model.PromotionStartDate.HasValue ? PromotionTime.ToUtcIso8601(Model.PromotionStartDate.Value) : "")" data-yq-autohide="true">
                <div class="yq-timer-header">
                    <i class="bi bi-stopwatch-fill yq-timer-pulse"></i>
                    <span>ينتهي العرض خلال:</span>
                </div>
                <div data-yq-timer-display class="yq-timer-tiles-wrap">
                    <div class="yq-timer-tiles">
                        <div class="yq-timer-tile"><span class="yq-timer-num">--</span><span class="yq-timer-unit">يوم</span></div>
                        <span class="yq-timer-sep">:</span>
                        <div class="yq-timer-tile"><span class="yq-timer-num">--</span><span class="yq-timer-unit">ساعة</span></div>
                        <span class="yq-timer-sep">:</span>
                        <div class="yq-timer-tile"><span class="yq-timer-num">--</span><span class="yq-timer-unit">دقيقة</span></div>
                        <span class="yq-timer-sep">:</span>
                        <div class="yq-timer-tile"><span class="yq-timer-num">--</span><span class="yq-timer-unit">ثانية</span></div>
                    </div>
                </div>
            </div>
        }

        <div class="yq-pcard__footer">
            @if (isPromoActive && Model.DiscountAmount > 0)
            {
                <div class="yq-pcard__price-box">
                    <div class="yq-pcard__price-row">
                        <span class="yq-pcard__price yq-pcard__price--deal">
                            <span class="yq-pcard__price-number">@(Model.FinalPrice.ToYaqutAmount())</span>
                            <small class="yq-pcard__price-currency">@(CurrencyHelper.GetSymbol())</small>
                        </span>
                        <del class="yq-pcard__price-original">@(Model.OriginalPrice.ToYaqutPrice())</del>
                    </div>
                    <span class="yq-savings-tag">
                        <i class="bi bi-lightning-charge-fill"></i>
                        <span>وفر @(Model.DiscountAmount.ToYaqutPrice())</span>
                    </span>
                </div>
            }
            else
            {
                <span class="yq-pcard__price">
                    <span class="yq-pcard__price-number">@(Model.Price.ToYaqutAmount())</span>
                    <small class="yq-pcard__price-currency">@(CurrencyHelper.GetSymbol())</small>
                </span>
            }
        </div>
        <p id="@statusId" class="yq-pcard__status yq-hidden" data-yq-add-status aria-live="polite"></p>
    </div>

    @if (showQuickAdd)
    {
        <div class="yq-pcard__actions" aria-label="إجراءات @Model.Name">
            @if (!isAvailable)
            {
                <button type="button" class="yq-pcard__action-add" disabled aria-disabled="true">
                    <i class="bi bi-bag-x" aria-hidden="true"></i><span>غير متوفر</span>
                </button>
            }
            else if (isRetailAvailable)
            {
                <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id"
                   class="yq-pcard__action-add" aria-label="اختر حجم @Model.Name">
                    <i class="bi bi-sliders" aria-hidden="true"></i><span>اختر الحجم</span>
                </a>
            }
            else if (isBaseOptionAvailable)
            {
                <form asp-controller="Cart" asp-action="Add" method="post"
                      class="yaqut-quick-add-form yq-pcard__add-form"
                      data-yq-add-to-cart-form data-product-id="@Model.Id" data-product-name="@Model.Name">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <input type="hidden" name="quantity" value="1" />
                    <button type="submit" class="yq-pcard__action-add" data-yq-add-button aria-describedby="@statusId">
                        <i class="bi bi-bag-plus" aria-hidden="true"></i>
                        <span data-yq-add-label>أضف للسلة</span>
                    </button>
                </form>
            }
            else
            {
                <button type="button" class="yq-pcard__action-add" disabled aria-disabled="true">
                    <i class="bi bi-bag-x" aria-hidden="true"></i><span>غير متوفر</span>
                </button>
            }

            <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id"
               class="yq-pcard__action-view" aria-label="معاينة @Model.Name" title="معاينة سريعة">
                <i class="bi bi-eye" aria-hidden="true"></i><span class="visually-hidden">معاينة</span>
            </a>
        </div>
    }
</article>
