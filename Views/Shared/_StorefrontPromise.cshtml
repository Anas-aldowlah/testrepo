@inject YAGOT_2._0.Core.Capabilities.ICapabilityEvaluator CapabilityEvaluator
@{
    var productViewEnabled = CapabilityEvaluator.IsFeatureEnabled(YAGOT_2._0.Core.Capabilities.CapabilityFeatureCodes.ProductView);
}
<section class="yq-storefront-promise" aria-labelledby="storefrontPromiseTitle">
    <div class="yq-storefront-promise__panel">
        <div>
            <span class="yq-storefront-promise__kicker">تجربة تليق بك</span>
            <h2 id="storefrontPromiseTitle" class="yq-storefront-promise__title">ابدأ رحلتك العطرية اليوم</h2>
            <p class="yq-storefront-promise__desc">عطور أصيلة، اختيار راقٍ، ودعم يساعدك في الوصول إلى عطرك المناسب.</p>
        </div>
        @if (productViewEnabled)
        {
            <a asp-controller="Products" asp-action="Index" class="yq-storefront-promise__btn">
                تصفّح العطور <i class="bi bi-bag-heart" aria-hidden="true"></i>
            </a>
        }
    </div>
</section>
