<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="تسجيل الدخول أو إنشاء حساب جديد - ياقوت للعطور الفاخرة." />
    <title>@ViewData["Title"] - ياقوت</title>
    <link rel="icon" type="image/svg+xml" href="~/images/favicon.svg" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/images/yaqut-logo.png" asp-append-version="true" />
    <link rel="manifest" href="~/site.webmanifest" asp-append-version="true" />
    <meta name="theme-color" content="#d4af37" />
    <script>
        (function () {
            var theme;
            try { theme = window.localStorage.getItem('yaqut-theme'); } catch (error) { }
            if (theme !== 'dark' && theme !== 'light') {
                theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            var root = document.documentElement;
            var isDark = theme === 'dark';
            root.setAttribute('data-theme', theme);
            root.classList.toggle('dark-mode', isDark);
            root.classList.toggle('theme-dark', isDark);
            root.classList.toggle('theme-light', !isDark);
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Tajawal:wght@400;500;700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/yaqut-theme.css" asp-append-version="true" />
    <script src="~/js/yaqut-main.js" asp-append-version="true" defer></script>
</head>
<body class="yaqut-auth-shell">
    <div class="yaqut-auth-shell__glow" aria-hidden="true"></div>

    <header class="yaqut-auth-topbar">
        <!-- Logo points to Home -->
        <a class="yaqut-brand" asp-area="" asp-controller="Home" asp-action="Index">
            <span class="yaqut-logo-wrap yaqut-logo-wrap--header">
                <img src="~/images/yaqut-logo.png" alt="ياقوت" class="yaqut-logo" />
            </span>
        </a>

        <!-- Theme Toggle Pill -->
        <div class="yaqut-theme-pill" role="group" aria-label="تبديل وضع الألوان">
            <button type="button" class="yaqut-theme-pill__btn" data-theme-opt="light" aria-label="الوضع الصباحي" title="وضع النهار">
                <i class="bi bi-sun"></i>
            </button>
            <button type="button" class="yaqut-theme-pill__btn" data-theme-opt="dark" aria-label="الوضع المسائي" title="وضع الليل">
                <i class="bi bi-moon-stars"></i>
            </button>
        </div>
    </header>

    <main class="yaqut-auth-shell__main">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
