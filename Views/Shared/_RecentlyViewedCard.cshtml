@model IEnumerable<YAGOT_2._0.Models.Product>
@using YAGOT_2._0.Services

@foreach (var product in Model)
{
    var isAvailable = ProductRetailAvailability.IsSellable(product);
    var isBaseOptionAvailable = ProductRetailAvailability.IsBaseOptionSellable(product);
    var isRetailAvailable = ProductRetailAvailability.IsAvailable(product);
    var isNew = product.Createdat.HasValue && product.Createdat.Value >= DateTime.UtcNow.AddDays(-30);
    var imageUrl = string.IsNullOrWhiteSpace(product.Imageurl)
        ? Url.Content("~/images/placeholder-product.svg")
        : (product.Imageurl.StartsWith("http", StringComparison.OrdinalIgnoreCase) || product.Imageurl.StartsWith("/")
            ? product.Imageurl
            : Url.Content("~/" + product.Imageurl.TrimStart('/')));

    <article class="yq-pdp-recent__card" data-yq-product-card>
        <div class="yq-pdp-recent__media">
            <a href="@Url.Action("Details", "Products", new { id = product.Id })" class="yq-pdp-recent__img-link" aria-label="عرض @product.Name">
                <img src="@imageUrl" alt="@product.Name" loading="lazy" decoding="async" data-yaqut-fallback="/images/placeholder-product.svg" />
            </a>
            
            @if (!isAvailable)
            {
                <span class="yq-pcard__badge yq-pcard__badge--off">
                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" class="bi bi-bag-x" viewBox="0 0 16 16" aria-hidden="true">
                        <path fill-rule="evenodd" d="M6.146 8.146a.5.5 0 0 1 .708 0L8 9.293l1.146-1.147a.5.5 0 1 1 .708.708L8.707 10l1.147 1.146a.5.5 0 0 1-.708.708L8 10.707l-1.146 1.147a.5.5 0 0 1-.708-.708L7.293 10 6.146 8.854a.5.5 0 0 1 0-.708"/>
                        <path d="M8 1a2.5 2.5 0 0 0-2.5 2.5V4h5v-.5A2.5 2.5 0 0 0 8 1m3.5 3v-.5a3.5 3.5 0 1 0-7 0V4H1v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4zM2 5h12v9a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1z"/>
                    </svg>
                    غير متوفر
                </span>
            }
            else
            {
                <span class="yq-pcard__badge yq-pcard__badge--on">
                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" class="bi bi-bag-check" viewBox="0 0 16 16" aria-hidden="true">
                        <path fill-rule="evenodd" d="M10.854 8.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 0 1 .708-.708L7.5 10.793l2.646-2.647a.5.5 0 0 1 .708 0"/>
                        <path d="M8 1a2.5 2.5 0 0 0-2.5 2.5V4h5v-.5A2.5 2.5 0 0 0 8 1m3.5 3v-.5a3.5 3.5 0 1 0-7 0V4H1v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4zM2 5h12v9a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1z"/>
                    </svg>
                    متوفر
                </span>
            }

            <div class="yq-pcard__overlay">
                @if (!isAvailable)
                {
                    <button type="button" class="yq-pcard__ov-btn yq-pcard__ov-btn--ghost" disabled aria-disabled="true" aria-label="غير متوفر">
                        <i class="bi bi-bag-x" aria-hidden="true"></i>
                        <span>غير متوفر</span>
                    </button>
                }
                else if (isRetailAvailable)
                {
                    <a href="@Url.Action("Details", "Products", new { id = product.Id })"
                       class="yq-pcard__ov-btn yq-pcard__ov-btn--gold" aria-label="اختر الحجم">
                        <i class="bi bi-sliders" aria-hidden="true"></i>
                        <span>اختر الحجم</span>
                    </a>
                }
                else if (isBaseOptionAvailable)
                {
                    <form asp-controller="Cart" asp-action="Add" method="post"
                          class="yaqut-quick-add-form"
                          data-yq-add-to-cart-form data-product-id="@product.Id" data-product-name="@product.Name">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@product.Id" />
                        <input type="hidden" name="quantity" value="1" />
                        <button type="submit" class="yq-pcard__ov-btn yq-pcard__ov-btn--gold" aria-label="أضف للسلة">
                            <i class="bi bi-bag-plus" aria-hidden="true"></i>
                            <span>أضف للسلة</span>
                        </button>
                    </form>
                }
            </div>
        </div>
        
        <a href="@Url.Action("Details", "Products", new { id = product.Id })" class="yq-pdp-recent__name-link yq-pcard__name-link">
            <span class="yq-pdp-recent__name">@product.Name</span>
        </a>
        <div class="yq-pdp-recent__price">
            <span class="yq-pcard__price">
                <span class="yq-pcard__price-number">@(product.Price.ToYaqutAmount())</span>
                <small class="yq-pcard__price-currency">ر.س</small>
            </span>
        </div>
    </article>
}
