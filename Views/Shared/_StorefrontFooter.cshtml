    @inject YAGOT_2._0.Services.StoreSettingsService StoreSettingsService
    @inject YAGOT_2._0.Core.Capabilities.ICapabilityEvaluator CapabilityEvaluator
    @{
        var routeController = ViewContext.RouteData.Values["controller"] as string ?? string.Empty;
        var routeAction = ViewContext.RouteData.Values["action"] as string ?? "Index";
        var isAuthenticated = User.Identity?.IsAuthenticated == true;
        var storeSettings = await StoreSettingsService.GetFooterSettingsAsync();
        var whatsappNumber = string.Concat((storeSettings.WhatsAppNumber ?? string.Empty).Where(char.IsDigit));
        var instagramLink = storeSettings.InstagramLink;
        var twitterLink = storeSettings.TwitterLink;
        var tikTokLink = storeSettings.TikTokLink;
        var hasSocialLinks = !string.IsNullOrWhiteSpace(instagramLink)
            || !string.IsNullOrWhiteSpace(twitterLink)
            || !string.IsNullOrWhiteSpace(tikTokLink);

        bool IsActive(string controller, string action = "Index")
            => string.Equals(routeController, controller, StringComparison.OrdinalIgnoreCase)
               && string.Equals(routeAction, action, StringComparison.OrdinalIgnoreCase);

        var homeActive = IsActive("Home");
        var productsActive = IsActive("Products");
        var categoriesActive = IsActive("Categories");
        var cartActive = IsActive("Cart");
        var ordersActive = IsActive("Orders");
        var categoryViewEnabled = CapabilityEvaluator.IsFeatureEnabled(YAGOT_2._0.Core.Capabilities.CapabilityFeatureCodes.CategoryView);
        var productViewEnabled = CapabilityEvaluator.IsFeatureEnabled(YAGOT_2._0.Core.Capabilities.CapabilityFeatureCodes.ProductView);
        var cartViewEnabled = CapabilityEvaluator.IsFeatureEnabled(YAGOT_2._0.Core.Capabilities.CapabilityFeatureCodes.CartView);
        var orderManagementEnabled = CapabilityEvaluator.IsFeatureEnabled(YAGOT_2._0.Core.Capabilities.CapabilityFeatureCodes.OrderManagement);
    }

    <footer class="yaqut-footer">
        <div class="yaqut-footer__inner">
            <partial name="_StorefrontPromise" />

            <div class="yaqut-footer__grid">
                <div class="yaqut-footer__col yaqut-footer__col--brand">
                    <span class="yaqut-logo-wrap yaqut-logo-wrap--header">
                        <img src="~/images/yaqut-logo.png" alt="ياقوت YAQUT" class="yaqut-logo" />
                    </span>
                    <p class="yaqut-footer__tagline">وجهة عربية فاخرة لاختيار العطور الشرقية والغربية، بتجربة شراء هادئة وواضحة من أول تصفح حتى وصول الطلب.</p>
                    @if (hasSocialLinks)
                    {
                        <div class="yaqut-footer__social" aria-label="تابعنا على وسائل التواصل الاجتماعي">
                            @if (!string.IsNullOrWhiteSpace(instagramLink))
                            {
                                <a href="@instagramLink" target="_blank" rel="noopener noreferrer" aria-label="إنستغرام"><i class="bi bi-instagram" aria-hidden="true"></i></a>
                            }
                            @if (!string.IsNullOrWhiteSpace(twitterLink))
                            {
                                <a href="@twitterLink" target="_blank" rel="noopener noreferrer" aria-label="X"><i class="bi bi-twitter-x" aria-hidden="true"></i></a>
                            }
                            @if (!string.IsNullOrWhiteSpace(tikTokLink))
                            {
                                <a href="@tikTokLink" target="_blank" rel="noopener noreferrer" aria-label="تيك توك"><i class="bi bi-tiktok" aria-hidden="true"></i></a>
                            }
                        </div>
                    }
                </div>

                <nav class="yaqut-footer__col" aria-label="روابط سريعة">
                    <h3 class="visually-hidden">روابط سريعة</h3>
                    <ul class="yaqut-footer-links">
                        <li>
                            <a asp-controller="Home" asp-action="Index" class="@(homeActive ? "is-active" : null)" aria-current="@(homeActive ? "page" : null)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                    <path d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4.5a.5.5 0 0 0 .5-.5v-4h2v4a.5.5 0 0 0 .5.5H14a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293zM2.5 14V7.707l5.5-5.5 5.5 5.5V14H10v-4a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 0-.5.5v4z"/>
                                </svg>
                                <span>الرئيسية</span>
                            </a>
                        </li>
                        @if (productViewEnabled)
                        {
                        <li>
                            <a asp-controller="Products" asp-action="Index" class="@(productsActive ? "is-active" : null)" aria-current="@(productsActive ? "page" : null)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                    <path d="M7.657 6.247c.11-.33.576-.33.686 0l.645 1.937a2.89 2.89 0 0 0 1.829 1.828l1.936.645c.33.11.33.576 0 .686l-1.937.645a2.89 2.89 0 0 0-1.828 1.829l-.645 1.936a.361.361 0 0 1-.686 0l-.645-1.937a2.89 2.89 0 0 0-1.828-1.828l-1.937-.645a.361.361 0 0 1 0-.686l1.937-.645a2.89 2.89 0 0 0 1.828-1.828zM3.794 1.148a.217.217 0 0 1 .412 0l.387 1.162c.173.518.579.924 1.097 1.097l1.162.387a.217.217 0 0 1 0 .412l-1.162.387A1.73 1.73 0 0 0 4.593 5.69l-.387 1.162a.217.217 0 0 1-.412 0L3.407 5.69A1.73 1.73 0 0 0 2.31 4.593l-1.162-.387a.217.217 0 0 1 0-.412l1.162-.387A1.73 1.73 0 0 0 3.407 2.31zm6.914 1.706a.217.217 0 0 1 .412 0l.387 1.162c.173.518.579.924 1.097 1.097l1.162.387a.217.217 0 0 1 0 .412l-1.162.387a1.73 1.73 0 0 0-1.097 1.097l-.387 1.162a.217.217 0 0 1-.412 0l-.387-1.162A1.73 1.73 0 0 0 9.61 4.593l-1.162-.387a.217.217 0 0 1 0-.412l1.162-.387a1.73 1.73 0 0 0 1.097-1.097z"/>
                                </svg>
                                <span>جميع المنتجات</span>
                            </a>
                        </li>
                        }
                        @if (categoryViewEnabled)
                        {
                            <li>
                                <a asp-controller="Categories" asp-action="Index" class="@(categoriesActive ? "is-active" : null)" aria-current="@(categoriesActive ? "page" : null)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                    <path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5zM2.5 2a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5zm6.5.5A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5zM1 10.5A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5zm6.5.5A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5z"/>
                                </svg>
                                <span>التصنيفات</span>
                                </a>
                            </li>
                        }
                        @if (cartViewEnabled)
                        {
                        <li>
                            <a asp-controller="Cart" asp-action="Index" class="@(cartActive ? "is-active" : null)" aria-current="@(cartActive ? "page" : null)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                    <path d="M8 1a2.5 2.5 0 0 1 2.5 2.5V4h-5v-.5A2.5 2.5 0 0 1 8 1m3.5 3v-.5a3.5 3.5 0 1 0-7 0V4H1v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4zM2 5h12v9a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1z"/>
                                </svg>
                                <span>سلة المشتريات</span>
                            </a>
                        </li>
                        }
                        @if (isAuthenticated && orderManagementEnabled)
                        {
                            <li>
                                <a asp-controller="Orders" asp-action="Index" class="@(ordersActive ? "is-active" : null)" aria-current="@(ordersActive ? "page" : null)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                        <path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5l2.404.961L10.404 2zm3.564 1.426L5.596 5 8 5.961 14.154 3.5zm3.25 1.7-6.5 2.6v7.922l6.5-2.6V4.24zM7.5 14.762V6.838L1 4.239v7.923zM7.443.184a1.5 1.5 0 0 1 1.114 0l7.129 2.852A.5.5 0 0 1 16 3.5v8.662a1 1 0 0 1-.629.928l-7.185 2.874a.5.5 0 0 1-.372 0L.63 13.09a1 1 0 0 1-.63-.928V3.5a.5.5 0 0 1 .314-.464z"/>
                                    </svg>
                                    <span>طلباتي</span>
                                </a>
                            </li>
                        }
                        else if (!isAuthenticated)
                        {
                            <li>
                                <a asp-controller="Account" asp-action="Auth">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                        <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/>
                                    </svg>
                                    <span>تسجيل الدخول</span>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>

            <div class="yaqut-footer__bottom">
                <p class="yaqut-footer__copy">&copy; @DateTime.Now.Year ياقوت للعطور الفاخرة. جميع الحقوق محفوظة.</p>
            <a href="https://wa.me/967775458250?text=السَّلَامُ%20عَلَيْكُمْ%20وَرَحْمَةُ%20اللَّهِ%20وَبَرَكَاتُهُ"
               target="_blank"
               rel="noopener noreferrer"
               class="yaqut-footer__dev-link">
                <i class="bi bi-whatsapp" aria-hidden="true"></i>
                <span>التواصل مع المطورين</span>
            </a>
                <div class="yaqut-footer__badges">
                    <span><i class="bi bi-shield-lock" aria-hidden="true"></i> تسوق آمن</span>
                    <span><i class="bi bi-truck" aria-hidden="true"></i> شحن سريع</span>
                </div>
            </div>
        </div>
    </footer>

    @if (!string.IsNullOrWhiteSpace(whatsappNumber))
    {
        <div class="yq-contact-float"
             data-yq-contact-widget
             data-yq-contact-number="@whatsappNumber"
             data-yq-contact-store-name="ياقوت"
             aria-label="تواصل سريع">
            <button type="button"
                    class="yq-contact-float__toggle"
                    data-yq-contact-toggle
                    aria-expanded="false"
                    aria-controls="yqContactPanel">
                <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"/>
                </svg>
                <span>تواصل سريع</span>
            </button>

            <section class="yq-contact-float__panel" id="yqContactPanel" data-yq-contact-panel hidden aria-label="إرسال ملاحظة عبر واتساب">
                <header class="yq-contact-float__header">
                    <div>
                        <strong>أرسل ملاحظتك</strong>
                        <p>سيفتح واتساب برسالتك جاهزة للإرسال.</p>
                    </div>
                    <button type="button" class="yq-contact-float__close" data-yq-contact-close aria-label="إغلاق">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </header>

                <form class="yq-contact-float__form" data-yq-contact-form target="_blank">
                    <label for="yqQuickContactMessage" class="visually-hidden">ملاحظتك</label>
                    <textarea id="yqQuickContactMessage"
                              class="yq-contact-float__message"
                              data-yq-contact-message
                              rows="4"
                              placeholder="اكتب ملاحظتك هنا"
                              required></textarea>

                    <div class="yq-contact-float__actions">
                        <button type="submit" class="btn-yaqut-gold yq-contact-float__send">
                            <i class="bi bi-send" aria-hidden="true"></i>
                            <span>إرسال إلى واتساب</span>
                        </button>
                    </div>

                    <p class="yq-contact-float__hint">سنفتح محادثة واتساب جاهزة بالنص الذي كتبته.</p>
                    <div class="yq-contact-float__feedback visually-hidden" data-yq-contact-feedback aria-live="polite"></div>
                </form>
            </section>
        </div>
    }
